@{
    var language = UiText.GetLanguage(Context);
    string T(string key) => UiText.T(language, key);
    ViewData["Title"] = T("Auth.AccessDeniedTitle");
}

<section class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <div class="text-uppercase text-danger small fw-semibold mb-2">@T("Auth.AccessDeniedTitle")</div>
                <h1 class="h3 mb-2">@T("Auth.AccessDeniedHeading")</h1>
                <p class="text-muted mb-4">
                    @T("Auth.AccessDeniedCopy")
                </p>
                <a class="btn btn-outline-secondary" asp-controller="UpcomingMatches" asp-action="Index">
                    @T("Auth.BackToApp")
                </a>
            </div>
        </div>
    </div>
</section>
