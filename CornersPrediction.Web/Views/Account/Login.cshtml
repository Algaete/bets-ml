@{
    var language = UiText.GetLanguage(Context);
    string T(string key) => UiText.T(language, key);
    ViewData["Title"] = T("Auth.LoginTitle");
    var returnUrl = ViewData["ReturnUrl"]?.ToString();
    var hasSsoError = ViewData["SsoError"] as bool? == true;
}

<section class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <div class="mb-4">
                    <div class="text-uppercase text-secondary small fw-semibold mb-2">Corners Prediction</div>
                    <h1 class="h3 mb-2">@T("Auth.LoginTitle")</h1>
                    <p class="text-muted mb-0">
                        @T("Auth.LoginCopy")
                    </p>
                </div>

                @if (hasSsoError)
                {
                    <div class="alert alert-warning">
                        @T("Auth.SsoError")
                    </div>
                }

                <form asp-controller="Account" asp-action="SignInWithMicrosoft" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                        @T("Auth.ContinueMicrosoft")
                    </button>
                </form>

                <div class="alert alert-light border mt-4 mb-0 small text-muted">
                    @T("Auth.RolesHint")
                </div>
            </div>
        </div>
    </div>
</section>
