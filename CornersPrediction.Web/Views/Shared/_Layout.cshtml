<!DOCTYPE html>
@{
    var language = UiText.GetLanguage(Context);
}
<html lang="@language">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <title>@ViewData["Title"] - @UiText.T(language, "App.Name")</title>
    <script>
        (() => {
            const theme = localStorage.getItem('app-theme') || 'dark';
            document.documentElement.setAttribute('data-theme', theme === 'light' ? 'light' : 'dark');
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CornersPrediction.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app-theme.css" asp-append-version="true" />
</head>
<body>
    @{
        var activeController = ViewContext.RouteData.Values["controller"]?.ToString();
        var returnUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
        var userEmail = User.FindFirst("preferred_username")?.Value
            ?? User.FindFirst("email")?.Value
            ?? User.Identity?.Name;
        var isAuthenticated = User.Identity?.IsAuthenticated == true;
        var canUsePredictions = User.IsInRole("Admin") || User.IsInRole("Analyst") || User.IsInRole("User");
        var canAdminUsers = User.IsInRole("Admin");
    }
    <div class="app-shell" id="AppShell">
        <aside class="app-sidebar" id="AppSidebar" aria-label="Main menu">
            <div class="sidebar-brand">
                <a asp-area="" asp-controller="UpcomingMatches" asp-action="Index">
                    <span class="brand-mark">CP</span>
                    <span>
                        <span class="brand-title">@UiText.T(language, "App.Name")</span>
                        <span class="brand-subtitle">@UiText.T(language, "App.Subtitle")</span>
                    </span>
                </a>
            </div>
            <nav class="sidebar-nav">
                @if (isAuthenticated)
                {
                    <a class="sidebar-link @(activeController == "UpcomingMatches" ? "active" : "")" asp-area="" asp-controller="UpcomingMatches" asp-action="Index">
                        <span class="sidebar-icon">UP</span>
                        <span>@UiText.T(language, "Nav.UpcomingMatches")</span>
                    </a>
                }
                @if (canUsePredictions)
                {
                    <a class="sidebar-link @(activeController == "Predictions" ? "active" : "")" asp-area="" asp-controller="Predictions" asp-action="Index">
                        <span class="sidebar-icon">PR</span>
                        <span>@UiText.T(language, "Nav.Predictions")</span>
                    </a>
                }
                @if (isAuthenticated)
                {
                    <a class="sidebar-link @(activeController == "Betting" ? "active" : "")" asp-area="" asp-controller="Betting" asp-action="Index">
                        <span class="sidebar-icon">BT</span>
                        <span>@UiText.T(language, "Nav.Betting")</span>
                    </a>
                }
                @if (canAdminUsers)
                {
                    <a class="sidebar-link @(activeController == "UserAdmin" ? "active" : "")" asp-area="" asp-controller="UserAdmin" asp-action="Index">
                        <span class="sidebar-icon">UA</span>
                        <span>@UiText.T(language, "Nav.Users")</span>
                    </a>
                }
            </nav>
            <div class="sidebar-footer">
                <span class="small text-white-50">@UiText.T(language, "App.LocalWorkspace")</span>
                <span class="small fw-semibold">2026</span>
            </div>
        </aside>

        <div class="sidebar-backdrop" id="SidebarBackdrop"></div>

        <div class="app-main">
            <header class="app-topbar">
                <button class="sidebar-toggle" type="button" id="SidebarToggle" aria-controls="AppSidebar" aria-expanded="true" aria-label="Toggle menu">
                    <span aria-hidden="true">&#9776;</span>
                </button>
                <div>
                    <div class="topbar-title">@ViewData["Title"]</div>
                    <div class="topbar-subtitle">@UiText.T(language, "App.Name")</div>
                </div>
                <div class="ms-auto d-flex align-items-center gap-2 flex-wrap justify-content-end">
                    <button id="ThemeToggle" class="btn btn-sm btn-outline-theme theme-toggle d-inline-flex align-items-center" type="button" data-theme-toggle aria-pressed="false">
                        <span class="theme-toggle-icon" data-theme-toggle-icon aria-hidden="true">L</span>
                        <span data-theme-toggle-label>Modo claro</span>
                    </button>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="small fw-semibold text-secondary">@userEmail</span>
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-secondary">@UiText.T(language, "Auth.SignOut")</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-primary" asp-area="" asp-controller="Account" asp-action="Login">
                            @UiText.T(language, "Auth.SignIn")
                        </a>
                    }
                </div>
                <form class="language-switcher" method="post" asp-controller="Language" asp-action="Set">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <label class="visually-hidden" for="LanguageSelect">@UiText.T(language, "Language.Label")</label>
                    <select id="LanguageSelect" name="language" class="form-select form-select-sm" onchange="this.form.submit()">
                        @if (language == UiText.English)
                        {
                            <option value="en" selected>EN</option>
                            <option value="es">ES</option>
                        }
                        else
                        {
                            <option value="en">EN</option>
                            <option value="es" selected>ES</option>
                        }
                    </select>
                </form>
            </header>

            <main role="main" class="app-content">
                @RenderBody()
            </main>

            <footer class="app-footer text-muted">
                &copy; 2026 - Corners Prediction
            </footer>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/theme-toggle.js" asp-append-version="true"></script>
    <script>
        (() => {
            const shell = document.getElementById('AppShell');
            const toggle = document.getElementById('SidebarToggle');
            const backdrop = document.getElementById('SidebarBackdrop');
            const storageKey = 'corners-sidebar-collapsed';

            const isMobile = () => window.matchMedia('(max-width: 991.98px)').matches;

            const setExpandedState = () => {
                const expanded = isMobile()
                    ? shell.classList.contains('sidebar-open')
                    : !shell.classList.contains('sidebar-collapsed');
                toggle.setAttribute('aria-expanded', expanded.toString());
            };

            const closeMobileSidebar = () => {
                shell.classList.remove('sidebar-open');
                setExpandedState();
            };

            if (localStorage.getItem(storageKey) === 'true') {
                shell.classList.add('sidebar-collapsed');
            }

            toggle.addEventListener('click', () => {
                if (isMobile()) {
                    shell.classList.toggle('sidebar-open');
                } else {
                    shell.classList.toggle('sidebar-collapsed');
                    localStorage.setItem(storageKey, shell.classList.contains('sidebar-collapsed').toString());
                }

                setExpandedState();
            });

            backdrop.addEventListener('click', closeMobileSidebar);
            window.addEventListener('resize', setExpandedState);
            setExpandedState();
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
