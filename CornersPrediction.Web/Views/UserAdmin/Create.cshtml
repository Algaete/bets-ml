@model CornersPrediction.Web.Models.Admin.PlatformUserFormViewModel

@{
    var language = UiText.GetLanguage(Context);
    string T(string key) => UiText.T(language, key);
    ViewData["Title"] = T("UserAdmin.Create");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="text-muted small text-uppercase fw-semibold">@T("UserAdmin.Eyebrow")</div>
        <h1 class="h3 mb-1">@T("UserAdmin.Create")</h1>
        <p class="text-muted mb-0">@T("UserAdmin.CreateDescription")</p>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="UserAdmin" asp-action="Index">@T("Common.Back")</a>
</div>

<form method="post" class="surface-panel">
    <partial name="_Form" model="Model" />
    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-secondary" asp-controller="UserAdmin" asp-action="Index">@T("Common.Cancel")</a>
        <button class="btn btn-primary" type="submit">@T("Common.SaveUser")</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
