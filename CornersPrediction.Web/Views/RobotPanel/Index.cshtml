@using System.Text.Json
@model CornersPrediction.Web.Models.RobotPanel.RobotPanelIndexViewModel

@{
    var language = UiText.GetLanguage(Context);
    ViewData["Title"] = UiText.T(language, "RobotPanel.Title");
    var dayOptionsJson = JsonSerializer.Serialize(Model.DayOptions);
    var labelsJson = JsonSerializer.Serialize(new
    {
        ready = language == UiText.Spanish ? "Listo para ejecutar." : "Ready to run.",
        running = language == UiText.Spanish ? "Ejecutando" : "Running",
        success = language == UiText.Spanish ? "Exitoso" : "Successful",
        partial = language == UiText.Spanish ? "Parcial" : "Partial",
        failed = language == UiText.Spanish ? "Error" : "Failed",
        skipped = language == UiText.Spanish ? "Omitido" : "Skipped",
        summaryWaiting = language == UiText.Spanish ? "Aun no hay ejecuciones. Usa cualquier boton para iniciar el robot." : "No executions yet. Use any button to start the robot.",
        jsonWaiting = language == UiText.Spanish ? "Esperando ejecucion..." : "Waiting for execution...",
        actionMatchHistory = "MatchHistory",
        actionUpcoming = language == UiText.Spanish ? "Proximos partidos" : "Upcoming matches",
        actionPinnacle = "Pinnacle",
        actionBetano = "Betano",
        actionBots = language == UiText.Spanish ? "Todos los bots activos" : "All active bots",
        actionFull = language == UiText.Spanish ? "Flujo completo" : "Full pipeline"
    });
}

<div class="betting-hero mb-4">
    <div>
        <div class="text-muted small text-uppercase fw-semibold">@UiText.T(language, "RobotPanel.Eyebrow")</div>
        <h1 class="h3 mb-1">@UiText.T(language, "RobotPanel.Title")</h1>
        <p class="text-muted mb-0">@UiText.T(language, "RobotPanel.Description")</p>
    </div>
    <div class="robot-panel-badge">
        <span>API</span>
        <span>UNIFICADA</span>
    </div>
</div>

<section class="surface-panel mb-4">
    <div class="robot-preflight-grid mb-3" aria-label="Alcance del flujo">
        <div><span>Próximos partidos</span><strong>API-Football</strong><small>Fuente oficial del pipeline</small></div>
        <div><span>Persistencia</span><strong>Azure SQL</strong><small>Cuotas, historial y picks</small></div>
        <div><span>Ejecución</span><strong>Todos los bots activos</strong><small>La selección viene del mantenedor</small></div>
        <div><span>Mercados</span><strong>4 familias</strong><small>Córners, goles, tiros y tiros al arco</small></div>
    </div>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <div>
            <h2 class="h6 mb-1">Parametros</h2>
            <div class="text-muted small">El flujo completo usa el rango elegido para MatchHistory y 7 días para próximos partidos.</div>
        </div>
        <div class="robot-panel-controls">
            <label class="robot-panel-select">
                <span>@UiText.T(language, "RobotPanel.DaysLabel")</span>
                <select id="RobotPanelDays" class="form-select form-select-sm">
                    @foreach (var dayOption in Model.DayOptions)
                    {
                        if (dayOption == Model.SelectedDays)
                        {
                            <option value="@dayOption" selected>@dayOption</option>
                        }
                        else
                        {
                            <option value="@dayOption">@dayOption</option>
                        }
                    }
                </select>
            </label>
            <label class="robot-panel-select">
                <span>Próximos</span>
                <select id="RobotPanelUpcomingDays" class="form-select form-select-sm">
                    <option value="7" selected>7</option>
                </select>
            </label>
            <span class="badge rounded-pill text-bg-primary">Todos los bots habilitados</span>
        </div>
    </div>

    <div class="robot-batch-console mb-3">
        <div class="robot-batch-metric">
            <span>Cuotas disponibles</span>
            <strong id="RobotPanelAvailableOdds">...</strong>
        </div>
        <div class="robot-batch-metric">
            <span>Partidos/mercado</span>
            <strong id="RobotPanelAvailableMatches">...</strong>
        </div>
        <div class="robot-batch-metric">
            <span>Lotes de 10 partidos/mercado</span>
            <strong id="RobotPanelTotalBatches">...</strong>
        </div>
        <div class="robot-batch-range">
            <span>Se procesará todo el rango</span>
            <strong id="RobotPanelBatchRange">Consultando cuotas...</strong>
        </div>
        <button id="RobotPanelRefreshAvailability" type="button" class="btn btn-sm btn-outline-secondary">
            Actualizar contador
        </button>
    </div>

    <div class="robot-panel-actions">
        <button type="button" class="btn btn-outline-primary" data-action="match-history">1. MatchHistory</button>
        <button type="button" class="btn btn-outline-primary" data-action="upcoming-matches">2. Próximos partidos</button>
        <button type="button" class="btn btn-outline-primary" data-action="pinnacle-odds">3. Cuotas Pinnacle</button>
        <button type="button" class="btn btn-outline-primary" data-action="betano-odds">4. Cuotas Betano</button>
        <button type="button" class="btn btn-outline-secondary" data-action="run-bots">5. Ejecutar todos los bots habilitados</button>
        <button type="button" class="btn btn-primary" data-action="full-run">Ejecutar flujo completo</button>
    </div>
    <div class="text-muted small mt-2">
        La lista se obtiene en cada ejecución desde el mantenedor. Si habilitas, deshabilitas o creas un bot, el panel respetará ese cambio automáticamente.
        Se procesarán todos los partidos/mercados del rango en segundo plano, en lotes de 10. Puedes cerrar esta página mientras trabaja.
    </div>
</section>

<section id="RobotPanelJob" class="surface-panel mb-4 d-none" aria-live="polite">
    <div class="d-flex justify-content-between align-items-center gap-3 mb-2">
        <strong>Ejecución de bots en segundo plano</strong>
        <a href="@Url.Action("Index", "BotAutomation")" class="btn btn-sm btn-outline-primary">Ver en Bots y procesos</a>
    </div>
    <div id="RobotPanelJobStage"></div>
    <div class="progress my-2" role="progressbar" aria-label="Avance de los bots" id="RobotPanelJobProgress">
        <div id="RobotPanelJobBar" class="progress-bar"></div>
    </div>
    <div id="RobotPanelJobDetail" class="small text-muted"></div>
</section>

<section class="surface-panel api-football-history-panel mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
        <div>
            <div class="text-muted small text-uppercase fw-semibold">Carga historica persistente</div>
            <h2 class="h5 mb-1">Tandas API-Football</h2>
            <div class="text-muted small">
                Continúa automáticamente desde el mes y offset guardados. Puedes cerrar esta página mientras trabaja.
            </div>
        </div>
        <div class="d-flex gap-2">
            <button id="ApiFootballHistoryRefresh" type="button" class="btn btn-sm btn-outline-secondary">Actualizar</button>
            <button id="ApiFootballHistoryStart" type="button" class="btn btn-sm btn-primary">Ejecutar siguiente tanda</button>
        </div>
    </div>
    <div class="api-football-history-grid">
        <div class="api-football-history-metric">
            <span>Estado</span>
            <strong id="ApiFootballHistoryStatus">Consultando...</strong>
        </div>
        <div class="api-football-history-metric">
            <span>Próxima tanda</span>
            <strong id="ApiFootballHistoryCheckpoint">-</strong>
        </div>
        <div class="api-football-history-metric">
            <span>Cuota diaria</span>
            <strong id="ApiFootballHistoryQuota">-</strong>
        </div>
        <div class="api-football-history-metric">
            <span>Competiciones</span>
            <strong id="ApiFootballHistoryCompetitions">-</strong>
        </div>
        <div class="api-football-history-metric">
            <span>Partidos procesados</span>
            <strong id="ApiFootballHistoryProcessed">-</strong>
        </div>
        <div class="api-football-history-metric">
            <span>Insertados / actualizados</span>
            <strong id="ApiFootballHistoryWrites">-</strong>
        </div>
    </div>
    <div id="ApiFootballHistoryMessage" class="api-football-history-message mt-3">
        Cargando checkpoint histórico...
    </div>
</section>

<div id="RobotPanelStatus" class="alert alert-light border mb-4" role="status">
    @UiText.T(language, "RobotPanel.ReadyStatus")
</div>

<section class="robot-panel-step-grid mb-4" id="RobotPanelStepGrid" aria-label="Robot execution states"></section>

<section class="surface-panel mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="h6 mb-1">@UiText.T(language, "RobotPanel.ResultsTitle")</h2>
            <div class="text-muted small">Insertados, actualizados, omitidos, errores y recomendaciones generadas.</div>
        </div>
        <span id="RobotPanelSummaryBadge" class="badge text-bg-light">Sin ejecucion</span>
    </div>

    <div id="RobotPanelEmpty" class="alert alert-light border mb-0">
        @UiText.T(language, "RobotPanel.EmptyState")
    </div>

    <div id="RobotPanelSummaryWrap" class="table-responsive d-none">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>Paso</th>
                    <th>Estado</th>
                    <th class="text-end">Procesados</th>
                    <th class="text-end">Insertados</th>
                    <th class="text-end">Actualizados</th>
                    <th class="text-end">Upserted</th>
                    <th class="text-end">Omitidos</th>
                    <th class="text-end">Errores</th>
                    <th class="text-end">Recomendaciones</th>
                    <th class="text-end">Resultados por bot</th>
                    <th class="text-end">Duración</th>
                </tr>
            </thead>
            <tbody id="RobotPanelSummaryBody"></tbody>
        </table>
    </div>
</section>

<section id="RobotPanelMissingHistory" class="surface-panel mb-4 d-none">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="h6 mb-1">Partidos sin historial suficiente</h2>
            <div class="text-muted small">Usa este JSON para identificar los equipos cuyos partidos historicos necesitas cargar.</div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span id="RobotPanelMissingHistoryCount" class="badge text-bg-warning">0 partidos</span>
            <button id="RobotPanelDownloadMissingHistory" type="button" class="btn btn-sm btn-outline-primary">Descargar JSON</button>
        </div>
    </div>
    <pre id="RobotPanelMissingHistoryJson" class="robot-panel-json"></pre>
</section>

<details class="surface-panel robot-technical-details">
    <summary>
        <span>
            <strong>@UiText.T(language, "RobotPanel.JsonTitle")</strong>
            <small>Payload técnico normalizado para depuración.</small>
        </span>
        <span class="badge text-bg-light">Avanzado</span>
    </summary>
    <pre id="RobotPanelJson" class="robot-panel-json mt-3">@UiText.T(language, "RobotPanel.JsonWaiting")</pre>
</details>

@section Scripts {
    <script src="~/js/robot-panel-job.js" asp-append-version="true"></script>
    <script>
        (() => {
            const urls = {
                matchHistory: '@Url.Action("RunMatchHistory", "RobotPanel")',
                upcomingMatches: '@Url.Action("RunUpcomingMatches", "RobotPanel")',
                pinnacleOdds: '@Url.Action("RunPinnacleOdds", "RobotPanel")',
                betanoOdds: '@Url.Action("RunBetanoOdds", "RobotPanel")',
                botAvailability: '@Url.Action("BotAvailability", "RobotPanel")',
                apiFootballHistoricalStatus: '@Url.Action("ApiFootballHistoricalStatus", "RobotPanel")',
                startApiFootballHistorical: '@Url.Action("StartApiFootballHistorical", "RobotPanel")',
                runBots: '@Url.Action("RunBots", "RobotPanel")',
                botJobStatus: '@Url.Action("BotJobStatus", "RobotPanel")',
                fullRun: '@Url.Action("RunFullPipeline", "RobotPanel")'
            };

            const dayOptions = @Html.Raw(dayOptionsJson);
            const labels = @Html.Raw(labelsJson);
            const stepDefinitions = [
                { key: 'match-history', title: 'MatchHistory', subtitle: 'Rango de fechas reciente' },
                { key: 'upcoming-matches', title: 'Próximos partidos', subtitle: 'Sincroniza los próximos 7 días' },
                { key: 'pinnacle-odds', title: 'Pinnacle', subtitle: 'Busqueda de cuotas con persistencia' },
                { key: 'betano-odds', title: 'Betano', subtitle: 'Busqueda de cuotas con timeout extendido' },
                { key: 'run-bots', title: labels.actionBots, subtitle: 'Todo el rango · en segundo plano · lotes de 10' }
            ];

            const state = {
                activeAction: null,
                latestPayload: null,
                latestSteps: [],
                availability: null,
                jobId: null,
                jobPending: false
            };
            const botBatchSize = 10;
            const jobStorageKey = 'robot-panel-recommendation-job-v1';
            let jobPollTimer = null;

            const statusElement = document.getElementById('RobotPanelStatus');
            const stepGrid = document.getElementById('RobotPanelStepGrid');
            const summaryWrap = document.getElementById('RobotPanelSummaryWrap');
            const summaryBody = document.getElementById('RobotPanelSummaryBody');
            const emptyState = document.getElementById('RobotPanelEmpty');
            const summaryBadge = document.getElementById('RobotPanelSummaryBadge');
            const jsonElement = document.getElementById('RobotPanelJson');
            const missingHistorySection = document.getElementById('RobotPanelMissingHistory');
            const missingHistoryCount = document.getElementById('RobotPanelMissingHistoryCount');
            const missingHistoryJson = document.getElementById('RobotPanelMissingHistoryJson');
            const downloadMissingHistoryButton = document.getElementById('RobotPanelDownloadMissingHistory');
            const daysSelect = document.getElementById('RobotPanelDays');
            const upcomingDaysSelect = document.getElementById('RobotPanelUpcomingDays');
            const availableOddsElement = document.getElementById('RobotPanelAvailableOdds');
            const availableMatchesElement = document.getElementById('RobotPanelAvailableMatches');
            const totalBatchesElement = document.getElementById('RobotPanelTotalBatches');
            const batchRangeElement = document.getElementById('RobotPanelBatchRange');
            const refreshAvailabilityButton = document.getElementById('RobotPanelRefreshAvailability');
            const historicalStatusElement = document.getElementById('ApiFootballHistoryStatus');
            const historicalCheckpointElement = document.getElementById('ApiFootballHistoryCheckpoint');
            const historicalQuotaElement = document.getElementById('ApiFootballHistoryQuota');
            const historicalCompetitionsElement = document.getElementById('ApiFootballHistoryCompetitions');
            const historicalProcessedElement = document.getElementById('ApiFootballHistoryProcessed');
            const historicalWritesElement = document.getElementById('ApiFootballHistoryWrites');
            const historicalMessageElement = document.getElementById('ApiFootballHistoryMessage');
            const historicalRefreshButton = document.getElementById('ApiFootballHistoryRefresh');
            const historicalStartButton = document.getElementById('ApiFootballHistoryStart');
            const buttons = Array.from(document.querySelectorAll('[data-action]'));
            let historicalPollTimer = null;

            const getValue = (item, name) => item?.[name.charAt(0).toLowerCase() + name.slice(1)] ?? item?.[name];
            const numberOrDash = value => Number.isFinite(Number(value)) ? Number(value).toLocaleString() : '-';
            const escapeHtml = value => String(value ?? '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');

            const getMissingHistoryMatches = steps => steps
                .flatMap(step => getValue(step, 'MissingHistoryMatches') || []);

            const buildMissingHistoryReport = matches => ({
                generatedAtUtc: new Date().toISOString(),
                totalMatches: matches.length,
                matches: matches.map(match => ({
                    league: getValue(match, 'League'),
                    homeTeam: getValue(match, 'HomeTeam'),
                    awayTeam: getValue(match, 'AwayTeam'),
                    matchDate: getValue(match, 'MatchDate'),
                    reason: getValue(match, 'Reason')
                }))
            });

            const renderMissingHistory = steps => {
                const matches = getMissingHistoryMatches(steps);
                const report = buildMissingHistoryReport(matches);
                missingHistorySection.classList.toggle('d-none', matches.length === 0);
                missingHistoryCount.textContent = `${matches.length} ${matches.length === 1 ? 'partido' : 'partidos'}`;
                missingHistoryJson.textContent = JSON.stringify(report, null, 2);
                downloadMissingHistoryButton.disabled = matches.length === 0;
            };

            const stepsByKey = () => {
                const map = new Map();
                for (const item of state.latestSteps) {
                    map.set(getValue(item, 'StepKey'), item);
                }
                return map;
            };

            const statusClass = status => {
                switch (status) {
                    case 'Queued': return 'text-bg-primary';
                    case 'Success': return 'text-bg-success';
                    case 'PartialSuccess': return 'text-bg-warning';
                    case 'Skipped': return 'text-bg-secondary';
                    case 'Failed': return 'text-bg-danger';
                    default: return 'text-bg-light';
                }
            };

            const statusText = status => {
                switch (status) {
                    case 'Queued': return 'En segundo plano';
                    case 'Success': return labels.success;
                    case 'PartialSuccess': return labels.partial;
                    case 'Skipped': return labels.skipped;
                    case 'Failed': return labels.failed;
                    default: return labels.ready;
                }
            };

            const botCountEntries = result => Object.entries(getValue(result, 'BotCounts') || {})
                .sort(([left], [right]) => left.localeCompare(right, 'es', { sensitivity: 'base' }));

            const botCountsHtml = result => botCountEntries(result)
                .map(([bot, count]) => `<span>${escapeHtml(bot)}: ${numberOrDash(count)}</span>`)
                .join('');

            const botCountsText = result => {
                const entries = botCountEntries(result);
                return entries.length
                    ? entries.map(([bot, count]) => `${bot}: ${numberOrDash(count)}`).join(' · ')
                    : '-';
            };

            const setBusyState = actionKey => {
                state.activeAction = actionKey;
                buttons.forEach(button => {
                    button.disabled = Boolean(actionKey) || (state.jobPending && ['run-bots', 'full-run'].includes(button.dataset.action));
                });
                if (actionKey) {
                    statusElement.className = 'alert alert-info mb-4';
                    statusElement.textContent = `${labels.running} ${actionKey}...`;
                }
                renderCards();
            };

            const renderCards = () => {
                const map = stepsByKey();
                stepGrid.innerHTML = stepDefinitions.map(step => {
                    const result = map.get(step.key);
                    const isRunning = state.activeAction === step.key || (state.activeAction === 'full-run' && step.key !== 'run-bots' && !result);
                    const status = isRunning ? labels.running : statusText(getValue(result, 'Status'));
                    const badgeClass = isRunning ? 'text-bg-primary' : statusClass(getValue(result, 'Status'));
                    const message = getValue(result, 'ErrorMessage') || getValue(result, 'Message') || (isRunning ? 'Proceso en curso...' : 'Sin ejecutar todavia.');
                    const botCounts = step.key === 'run-bots' && result
                        ? botCountsHtml(result)
                        : '';

                    return `
                        <article class="robot-step-card">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <div class="robot-step-title">${escapeHtml(step.title)}</div>
                                    <div class="robot-step-subtitle">${escapeHtml(step.subtitle)}</div>
                                </div>
                                <span class="badge ${badgeClass}">${escapeHtml(status)}</span>
                            </div>
                            <div class="robot-step-metrics">
                                <span>Proc: ${numberOrDash(getValue(result, 'Processed'))}</span>
                                <span>Ins: ${numberOrDash(getValue(result, 'Inserted'))}</span>
                                <span>Upd: ${numberOrDash(getValue(result, 'Updated'))}</span>
                                <span>Err: ${numberOrDash(getValue(result, 'Errors'))}</span>
                                ${botCounts}
                                <span>Tiempo: ${getValue(result, 'DurationMs') == null ? '-' : `${(Number(getValue(result, 'DurationMs')) / 1000).toFixed(1)}s`}</span>
                            </div>
                            <div class="robot-step-message">${escapeHtml(message)}</div>
                        </article>
                    `;
                }).join('');
            };

            const renderSummary = payload => {
                const steps = Array.isArray(getValue(payload, 'Steps'))
                    ? getValue(payload, 'Steps')
                    : [payload];

                state.latestSteps = steps;
                state.latestPayload = payload;

                if (!steps.length) {
                    emptyState.classList.remove('d-none');
                    summaryWrap.classList.add('d-none');
                    summaryBadge.textContent = 'Sin ejecucion';
                    jsonElement.textContent = labels.jsonWaiting;
                    renderCards();
                    return;
                }

                emptyState.classList.add('d-none');
                summaryWrap.classList.remove('d-none');
                summaryBadge.textContent = getValue(payload, 'Status') || getValue(steps[0], 'Status') || 'Ready';

                summaryBody.innerHTML = steps.map(step => `
                    <tr>
                        <td>
                            <div class="fw-semibold">${escapeHtml(getValue(step, 'StepName') || getValue(step, 'StepKey'))}</div>
                            <div class="text-muted small">${escapeHtml(getValue(step, 'Message') || getValue(step, 'ErrorMessage') || '')}</div>
                        </td>
                        <td><span class="badge ${statusClass(getValue(step, 'Status'))}">${escapeHtml(statusText(getValue(step, 'Status')))}</span></td>
                        <td class="text-end">${numberOrDash(getValue(step, 'Processed'))}</td>
                        <td class="text-end">${numberOrDash(getValue(step, 'Inserted'))}</td>
                        <td class="text-end">${numberOrDash(getValue(step, 'Updated'))}</td>
                        <td class="text-end">${numberOrDash(getValue(step, 'Upserted'))}</td>
                        <td class="text-end">${numberOrDash(getValue(step, 'Skipped'))}</td>
                        <td class="text-end">${numberOrDash(getValue(step, 'Errors'))}</td>
                        <td class="text-end">${numberOrDash(getValue(step, 'RecommendationsGenerated'))}</td>
                        <td class="text-end">${getValue(step, 'StepKey') === 'run-bots'
                            ? escapeHtml(botCountsText(step))
                            : '-'}</td>
                        <td class="text-end">${getValue(step, 'DurationMs') == null ? '-' : `${(Number(getValue(step, 'DurationMs')) / 1000).toFixed(1)}s`}</td>
                    </tr>
                `).join('');

                jsonElement.textContent = JSON.stringify(payload, null, 2);
                renderMissingHistory(steps);
                renderCards();
            };

            const showError = message => {
                statusElement.className = 'alert alert-danger mb-4';
                statusElement.textContent = message;
            };

            const formatMonth = value => {
                const text = String(value || '');
                return text.length >= 7 ? text.slice(0, 7) : '-';
            };

            const renderHistoricalBatch = payload => {
                const isRunning = Boolean(getValue(payload, 'IsRunning'));
                const status = getValue(payload, 'Status') || 'Ready';
                const nextMonth = getValue(payload, 'NextMonth') || getValue(payload, 'Month');
                const nextOffset = getValue(payload, 'NextCompetitionOffset') ?? getValue(payload, 'CompetitionOffset') ?? 0;
                const dailyRemaining = getValue(payload, 'DailyRemaining');
                const minuteRemaining = getValue(payload, 'MinuteRemaining');
                const processedCompetitions = getValue(payload, 'ProcessedCompetitions');
                const eligibleCompetitions = getValue(payload, 'EligibleCompetitions');
                const inserted = getValue(payload, 'Inserted');
                const updated = getValue(payload, 'Updated');

                historicalStatusElement.textContent = isRunning ? 'Ejecutando' : status;
                historicalCheckpointElement.textContent = `${formatMonth(nextMonth)} · offset ${numberOrDash(nextOffset)}`;
                historicalQuotaElement.textContent = dailyRemaining == null
                    ? '-'
                    : `${dailyRemaining} diaria · ${minuteRemaining ?? '-'} minuto`;
                historicalCompetitionsElement.textContent = processedCompetitions == null
                    ? '-'
                    : `${numberOrDash(processedCompetitions)} / ${numberOrDash(eligibleCompetitions)}`;
                historicalProcessedElement.textContent = numberOrDash(getValue(payload, 'ProcessedFixtures'));
                historicalWritesElement.textContent = inserted == null
                    ? '-'
                    : `${numberOrDash(inserted)} / ${numberOrDash(updated)}`;
                historicalMessageElement.textContent = getValue(payload, 'Message') || 'Lista para ejecutar.';
                historicalStartButton.disabled = isRunning;
                historicalStartButton.textContent = isRunning ? 'Tanda en ejecución' : 'Ejecutar siguiente tanda';

                if (historicalPollTimer) {
                    clearTimeout(historicalPollTimer);
                    historicalPollTimer = null;
                }
                if (isRunning) {
                    historicalPollTimer = setTimeout(loadHistoricalBatch, 5000);
                }
            };

            const loadHistoricalBatch = async () => {
                historicalRefreshButton.disabled = true;
                try {
                    const response = await fetch(urls.apiFootballHistoricalStatus);
                    const json = await response.json();
                    if (!response.ok) {
                        throw new Error(getValue(json, 'error') || 'No se pudo consultar la tanda histórica.');
                    }
                    renderHistoricalBatch(json);
                } catch (error) {
                    historicalMessageElement.textContent = error instanceof Error
                        ? error.message
                        : 'No se pudo consultar la tanda histórica.';
                } finally {
                    historicalRefreshButton.disabled = false;
                }
            };

            const startHistoricalBatch = async () => {
                historicalStartButton.disabled = true;
                historicalMessageElement.textContent = 'Iniciando tanda histórica...';
                try {
                    const response = await fetch(urls.startApiFootballHistorical, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: '{}'
                    });
                    const json = await response.json();
                    if (!response.ok) {
                        throw new Error(getValue(json, 'error') || 'No se pudo iniciar la tanda histórica.');
                    }
                    renderHistoricalBatch(json);
                } catch (error) {
                    historicalStartButton.disabled = false;
                    historicalMessageElement.textContent = error instanceof Error
                        ? error.message
                        : 'No se pudo iniciar la tanda histórica.';
                }
            };

            const showSuccess = payload => {
                const status = getValue(payload, 'Status') || (getValue(payload, 'IsSuccess') ? 'Success' : 'Failed');
                const headline = getValue(payload, 'PipelineName')
                    ? `${getValue(payload, 'PipelineName')}: ${status}`
                    : `${getValue(payload, 'StepName') || 'Step'}: ${status}`;
                const detail = getValue(payload, 'ErrorMessage') || getValue(payload, 'Message');
                const message = detail ? `${headline} — ${detail}` : headline;

                statusElement.className = status === 'Failed'
                    ? 'alert alert-danger mb-4'
                    : status === 'PartialSuccess'
                        ? 'alert alert-warning mb-4'
                        : status === 'Queued' ? 'alert alert-info mb-4'
                        : 'alert alert-success mb-4';
                statusElement.textContent = message;
            };

            const renderBatchAvailability = () => {
                const availability = state.availability;
                if (!availability) {
                    availableOddsElement.textContent = '...';
                    availableMatchesElement.textContent = '...';
                    totalBatchesElement.textContent = '...';
                    batchRangeElement.textContent = 'Consultando cuotas...';
                    return;
                }

                const totalOdds = Number(getValue(availability, 'TotalOddsRows') || 0);
                const totalMatches = Number(getValue(availability, 'TotalMatches') || 0);
                const totalBatches = Number(getValue(availability, 'TotalBatches') || 0);
                availableOddsElement.textContent = totalOdds.toLocaleString();
                availableMatchesElement.textContent = totalMatches.toLocaleString();
                totalBatchesElement.textContent = totalBatches.toLocaleString();
                batchRangeElement.textContent = totalMatches === 0
                    ? 'No hay partidos/mercados con cuotas'
                    : `Todos los ${totalMatches} partidos/mercados · lotes automáticos de 10`;
            };

            const loadBotAvailability = async () => {
                refreshAvailabilityButton.disabled = true;
                try {
                    const response = await fetch(urls.botAvailability);
                    const json = await response.json();
                    if (!response.ok) {
                        throw new Error(getValue(json, 'error') || 'No se pudo consultar el contador de cuotas.');
                    }

                    state.availability = json;
                    renderBatchAvailability();
                } catch (error) {
                    state.availability = null;
                    renderBatchAvailability();
                    showError(error instanceof Error ? error.message : 'No se pudo consultar el contador de cuotas.');
                } finally {
                    refreshAvailabilityButton.disabled = false;
                }
            };

            const renderBotJob = job => {
                const model = window.robotPanelJobState(job);
                state.jobId = model.id;
                state.jobPending = !model.terminal;
                document.getElementById('RobotPanelJob').classList.remove('d-none');
                document.getElementById('RobotPanelJobStage').textContent = model.message;
                document.getElementById('RobotPanelJobDetail').textContent = `${model.percent == null ? 'Preparando' : `${model.percent}%`} · ${model.progress}`;
                const bar = document.getElementById('RobotPanelJobBar');
                bar.style.width = `${model.percent ?? 100}%`;
                bar.className = model.percent == null
                    ? 'progress-bar progress-bar-striped progress-bar-animated' : 'progress-bar';
                const progress = document.getElementById('RobotPanelJobProgress');
                if (model.percent == null) progress.removeAttribute('aria-valuenow');
                else progress.setAttribute('aria-valuenow', String(model.percent));
                const steps = state.latestSteps.filter(step => getValue(step, 'StepKey') !== 'run-bots');
                steps.push(model.result);
                renderSummary({ Steps: steps, Status: model.result.Status });
                if (!state.activeAction) showSuccess(model.result);
                buttons.forEach(button => {
                    button.disabled = Boolean(state.activeAction) || (state.jobPending && ['run-bots', 'full-run'].includes(button.dataset.action));
                });
                if (model.terminal) localStorage.removeItem(jobStorageKey);
                else localStorage.setItem(jobStorageKey, model.id);
                return model;
            };

            const pollBotJob = async () => {
                const jobId = state.jobId;
                if (!jobId) return;
                let retry = true;
                try {
                    const response = await fetch(`${urls.botJobStatus}?jobId=${encodeURIComponent(jobId)}`);
                    const job = await response.json();
                    if (state.jobId !== jobId) return;
                    if (!response.ok) {
                        if (response.status === 404 || response.status === 400) {
                            localStorage.removeItem(jobStorageKey);
                            state.jobPending = false;
                            retry = false;
                            setBusyState(state.activeAction);
                        }
                        throw new Error(getValue(job, 'error') || 'No se pudo actualizar el avance. La ejecución continúa en segundo plano.');
                    }
                    retry = !renderBotJob(job).terminal;
                } catch (error) {
                    document.getElementById('RobotPanelJob').classList.remove('d-none');
                    document.getElementById('RobotPanelJobStage').textContent = error instanceof Error
                        ? error.message : 'Reintentando la consulta de avance…';
                } finally {
                    if (retry && state.jobId === jobId) jobPollTimer = setTimeout(pollBotJob, 5000);
                }
            };

            const followBotJob = job => {
                if (jobPollTimer) clearTimeout(jobPollTimer);
                const model = renderBotJob(job);
                if (!model.terminal) jobPollTimer = setTimeout(pollBotJob, 2000);
            };

            const requestPayload = actionKey => {
                const days = Number(daysSelect.value || 7);
                const upcomingDays = Number(upcomingDaysSelect.value || 7);

                switch (actionKey) {
                    case 'match-history':
                    case 'upcoming-matches':
                        return { days };
                    case 'run-bots':
                        return {
                            excludeExistingSelections: false,
                            upcomingDays,
                            batchSize: botBatchSize,
                            runAllEnabledBots: true
                        };
                    case 'full-run':
                        return {
                            matchHistoryDays: days,
                            upcomingDays,
                            excludeExistingSelections: false,
                            botBatchSize,
                            runAllEnabledBots: true
                        };
                    default:
                        return null;
                }
            };

            const endpointFor = actionKey => {
                switch (actionKey) {
                    case 'match-history': return urls.matchHistory;
                    case 'upcoming-matches': return urls.upcomingMatches;
                    case 'pinnacle-odds': return urls.pinnacleOdds;
                    case 'betano-odds': return urls.betanoOdds;
                    case 'run-bots': return urls.runBots;
                    case 'full-run': return urls.fullRun;
                    default: return null;
                }
            };

            const invokeAction = async actionKey => {
                const endpoint = endpointFor(actionKey);
                if (!endpoint) {
                    return;
                }

                setBusyState(actionKey);

                try {
                    const payload = requestPayload(actionKey);
                    const response = await fetch(endpoint, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: payload ? JSON.stringify(payload) : null
                    });

                    const json = await response.json();
                    if (!response.ok) {
                        throw new Error(getValue(json, 'error') || 'No se pudo ejecutar la accion.');
                    }

                    showSuccess(json);
                    renderSummary(json);
                    const botStep = actionKey === 'full-run'
                        ? (getValue(json, 'Steps') || []).find(step => getValue(step, 'StepKey') === 'run-bots')
                        : actionKey === 'run-bots' ? json : null;
                    const job = getValue(botStep, 'RecommendationJob');
                    if (job) {
                        followBotJob(job);
                    }

                    if (['upcoming-matches', 'pinnacle-odds', 'betano-odds', 'full-run'].includes(actionKey)) {
                        await loadBotAvailability();
                    }
                } catch (error) {
                    showError(error instanceof Error ? error.message : 'Ocurrio un error inesperado.');
                } finally {
                    setBusyState(null);
                }
            };

            buttons.forEach(button => {
                button.addEventListener('click', () => {
                    invokeAction(button.dataset.action);
                });
            });

            refreshAvailabilityButton.addEventListener('click', loadBotAvailability);
            historicalRefreshButton.addEventListener('click', loadHistoricalBatch);
            historicalStartButton.addEventListener('click', startHistoricalBatch);

            downloadMissingHistoryButton.addEventListener('click', () => {
                const report = buildMissingHistoryReport(getMissingHistoryMatches(state.latestSteps));
                const blob = new Blob([JSON.stringify(report, null, 2)], { type: 'application/json' });
                const url = URL.createObjectURL(blob);
                const link = document.createElement('a');
                link.href = url;
                link.download = `partidos-sin-historial-${new Date().toISOString().slice(0, 10)}.json`;
                document.body.appendChild(link);
                link.click();
                link.remove();
                URL.revokeObjectURL(url);
            });

            renderCards();
            jsonElement.textContent = labels.jsonWaiting;
            loadBotAvailability();
            loadHistoricalBatch();
            const savedJobId = localStorage.getItem(jobStorageKey);
            if (savedJobId) {
                state.jobId = savedJobId;
                state.jobPending = true;
                setBusyState(null);
                pollBotJob();
            }
        })();
    </script>
}
