@model CornersPrediction.Web.Models.BotPicks.BotI2026IndexViewModel
@{
    string Pct(decimal? value) => value.HasValue ? value.Value.ToString("P2") : "—";
    string Units(decimal? value) => value.HasValue ? $"{value.Value:+0.00;-0.00;0.00}u" : "—";
    string Sort(decimal? value) => value?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
}
<section class="i-card">
    <div class="i-card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div><h2 class="h5 mb-1">Auditoría de señales</h2><p class="small text-secondary mb-0">Paginación desde SQL; los encabezados ordenan sólo la página visible.</p></div>
        <span class="i-decision i-decision-approved">Approved · SHADOW</span>
    </div>
    <div class="i-card-body">
        @if (!Model.EvaluationsAvailable)
        {
            <div class="alert alert-warning mb-3" role="alert">@Model.EvaluationsErrorMessage <button type="button" class="btn btn-sm btn-outline-warning ms-2 js-i-retry">Reintentar</button></div>
        }
        <form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
            <div class="col-6 col-lg-2"><label class="form-label small" for="IPredictionFromUtc">Desde UTC</label><input name="PredictionFromUtc" id="IPredictionFromUtc" type="date" class="form-control form-control-sm" value="@Model.Filters.PredictionFromUtc?.ToString("yyyy-MM-dd")" /></div>
            <div class="col-6 col-lg-2"><label class="form-label small" for="IPredictionToUtc">Hasta UTC</label><input name="PredictionToUtc" id="IPredictionToUtc" type="date" class="form-control form-control-sm" value="@Model.Filters.PredictionToUtc?.ToString("yyyy-MM-dd")" /></div>
            <div class="col-6 col-lg-2"><label class="form-label small" for="IDecision">Decisión shadow</label><select id="IDecision" name="Decision" class="form-select form-select-sm"><option value="">Todas</option><option value="Approved" selected="@(Model.Filters.Decision == "Approved")">Approved · SHADOW (No apostar)</option><option value="Rejected" selected="@(Model.Filters.Decision == "Rejected")">Rejected · SHADOW</option><option value="Abstain" selected="@(Model.Filters.Decision == "Abstain")">Abstain · SHADOW</option></select></div>
            <div class="col-6 col-lg-2"><label class="form-label small" for="IMarketType">Mercado</label><select id="IMarketType" name="MarketType" class="form-select form-select-sm"><option value="">Todos</option><option value="TotalGoals" selected="@(Model.Filters.MarketType == "TotalGoals")">TotalGoals</option><option value="TotalCorners" selected="@(Model.Filters.MarketType == "TotalCorners")">TotalCorners</option></select></div>
            <div class="col-6 col-lg-2"><label class="form-label small" for="ISelection">Selección</label><select id="ISelection" name="Selection" class="form-select form-select-sm"><option value="">Todas</option><option value="Over" selected="@(Model.Filters.Selection == "Over")">Over</option><option value="Under" selected="@(Model.Filters.Selection == "Under")">Under</option></select></div>
            <div class="col-6 col-lg-2"><label class="form-label small" for="ISource">Bookmaker</label><select id="ISource" name="Source" class="form-select form-select-sm"><option value="">Todos</option><option value="Pinnacle" selected="@(Model.Filters.Source == "Pinnacle")">Pinnacle</option><option value="Betano" selected="@(Model.Filters.Source == "Betano")">Betano</option></select></div>
            <div class="col-6 col-lg-2"><label class="form-label small" for="IPageSize">Filas</label><select id="IPageSize" name="PageSize" class="form-select form-select-sm"><option value="25" selected="@(Model.Filters.PageSize == 25)">25</option><option value="50" selected="@(Model.Filters.PageSize == 50)">50</option><option value="100" selected="@(Model.Filters.PageSize == 100)">100</option><option value="250" selected="@(Model.Filters.PageSize == 250)">250</option></select></div>
            <div class="col-12 col-lg-5"><label class="form-label small" for="IConfigurationVersion">Configuración exacta</label><input id="IConfigurationVersion" name="ConfigurationVersion" value="@Model.Filters.ConfigurationVersion" class="form-control form-control-sm" placeholder="todas las versiones" /></div>
            <div class="col-auto"><button type="submit" class="btn btn-sm btn-primary">Aplicar filtros</button></div>
            <div class="col-auto"><a asp-action="Index" class="btn btn-sm btn-outline-secondary">Limpiar</a></div>
        </form>

        <div class="i-shadow-help small mb-3" role="note">
            <strong>No apostar.</strong>
            Approved sólo significa que la señal pasó las reglas del laboratorio; no autoriza una apuesta real. No tiene stake, no aparece en Bot Picks y su publicación productiva continúa bloqueada.
        </div>

        @if (Model.EvaluationsAvailable)
        {
            <div class="d-flex flex-wrap justify-content-between gap-2 small text-secondary mb-2">
                <span>@Model.Evaluations.TotalRows.ToString("N0") evaluaciones · página @Model.Evaluations.Page de @Math.Max(1, Model.Evaluations.TotalPages)</span>
                <span>Corte: @(Model.Evaluations.AsOfUtc == default ? "—" : Model.Evaluations.AsOfUtc.ToString("yyyy-MM-dd HH:mm 'UTC'"))</span>
            </div>
            @if (Model.Evaluations.Items.Count == 0)
            {
                <div class="i-guard small">No hay evaluaciones I2026 para estos filtros. Puedes recolectar evidencia shadow arriba.</div>
            }
            else
            {
                <div class="i-table-scroll" tabindex="0" aria-label="Tabla desplazable de evaluaciones I2026">
                    <table class="table table-sm table-hover align-middle i-table" data-sortable-table>
                        <thead><tr>
                            <th><button type="button" class="i-sort js-i-sort" data-column="0">Predicción</button></th>
                            <th><button type="button" class="i-sort js-i-sort" data-column="1">Partido</button></th>
                            <th><button type="button" class="i-sort js-i-sort" data-column="2">Mercado</button></th>
                            <th><button type="button" class="i-sort js-i-sort" data-column="3">Pick / cuota</button></th>
                            <th><button type="button" class="i-sort js-i-sort" data-column="4">Movimiento</button></th>
                            <th><button type="button" class="i-sort js-i-sort" data-column="5">Cruce books</button></th>
                            <th><button type="button" class="i-sort js-i-sort" data-column="6">Señal</button></th>
                            <th><button type="button" class="i-sort js-i-sort" data-column="7">Resultado</button></th>
                            <th>Auditoría</th>
                        </tr></thead>
                        <tbody>
                        @foreach (var item in Model.Evaluations.Items)
                        {
                            var decisionBadge = item.Decision switch
                            {
                                "Approved" => "i-decision-approved",
                                "Rejected" => "i-decision-rejected",
                                _ => "i-decision-abstain"
                            };
                            var decisionLabel = item.Decision switch
                            {
                                "Approved" => "Approved · SHADOW",
                                "Rejected" => "Rejected · SHADOW",
                                _ => "Abstain · SHADOW"
                            };
                            <tr>
                                <td data-sort-value="@item.PredictionTimestampUtc.Ticks">@item.PredictionTimestampUtc.ToString("yyyy-MM-dd HH:mm")<div class="small text-secondary">#@item.ShadowEvaluationId</div></td>
                                <td class="i-match" data-sort-value="@item.HomeTeam"><strong>@item.HomeTeam – @item.AwayTeam</strong><div class="small text-secondary">@item.League · @item.FixtureDateUtc.ToString("MM-dd HH:mm") UTC</div></td>
                                <td data-sort-value="@item.MarketType"><strong>@item.MarketType</strong><div class="small text-secondary">@item.Source · @item.SnapshotCount snapshots</div></td>
                                <td data-sort-value="@Sort(item.SelectedOdds)"><strong>@item.Selection</strong> @@ @item.SelectedOdds.ToString("0.00")<div class="small text-secondary">línea @item.CurrentLine.ToString("0.00")</div></td>
                                <td data-sort-value="@Sort(item.SelectedProbabilityMovement)"><strong>@Pct(item.SelectedProbabilityMovement)</strong><div class="small text-secondary">línea @item.SelectedLineMovement.ToString("+0.00;-0.00;0.00") · @item.ObservationHours.ToString("0.0") h</div></td>
                                <td data-sort-value="@Sort(item.CrossBookProbabilityDispersion)">@(item.PeerSource ?? "sin peer")<div class="small text-secondary">prob. @Pct(item.CrossBookProbabilityDispersion) · línea @(item.CrossBookLineDispersion?.ToString("+0.00;-0.00;0.00") ?? "—")</div></td>
                                <td data-sort-value="@Sort(item.SignalScore)"><span class="i-decision @decisionBadge">@decisionLabel</span>@if (item.Decision == "Approved") {<div class="small i-no-bet">No apostar</div>}<div class="small text-secondary">score @Pct(item.SignalScore)</div></td>
                                <td data-sort-value="@item.SettlementState">@item.SettlementState<div class="small text-secondary">@(item.Result ?? "—") · P/L @Units(item.ProfitLoss)</div></td>
                                <td class="i-explanation"><strong>@(item.PublicationBlocked ? "Publicación bloqueada" : "REVISAR BARRERA")</strong><div class="small text-secondary">@item.Explanation</div><details class="small mt-1"><summary>Linaje</summary><div>Open #@item.OpeningSnapshotId → current #@item.CurrentSnapshotId</div><div>Peer #@(item.PeerSnapshotId?.ToString() ?? "—") · fixture @item.FixtureIdentity</div></details></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }

            @if (Model.Evaluations.TotalPages > 1)
            {
                <nav class="d-flex align-items-center justify-content-between gap-2 mt-3" aria-label="Paginación I2026">
                    <a class="btn btn-sm btn-outline-secondary @(Model.Evaluations.Page <= 1 ? "disabled" : "")" asp-action="Index" asp-route-PredictionFromUtc="@Model.Filters.PredictionFromUtc?.ToString("O")" asp-route-PredictionToUtc="@Model.Filters.PredictionToUtc?.ToString("O")" asp-route-AsOfUtc="@Model.Filters.AsOfUtc?.ToString("O")" asp-route-Decision="@Model.Filters.Decision" asp-route-MarketType="@Model.Filters.MarketType" asp-route-Selection="@Model.Filters.Selection" asp-route-Source="@Model.Filters.Source" asp-route-ConfigurationVersion="@Model.Filters.ConfigurationVersion" asp-route-Page="@(Model.Evaluations.Page - 1)" asp-route-PageSize="@Model.Filters.PageSize">Anterior</a>
                    <span class="small text-secondary">Página @Model.Evaluations.Page / @Model.Evaluations.TotalPages</span>
                    <a class="btn btn-sm btn-outline-secondary @(Model.Evaluations.Page >= Model.Evaluations.TotalPages ? "disabled" : "")" asp-action="Index" asp-route-PredictionFromUtc="@Model.Filters.PredictionFromUtc?.ToString("O")" asp-route-PredictionToUtc="@Model.Filters.PredictionToUtc?.ToString("O")" asp-route-AsOfUtc="@Model.Filters.AsOfUtc?.ToString("O")" asp-route-Decision="@Model.Filters.Decision" asp-route-MarketType="@Model.Filters.MarketType" asp-route-Selection="@Model.Filters.Selection" asp-route-Source="@Model.Filters.Source" asp-route-ConfigurationVersion="@Model.Filters.ConfigurationVersion" asp-route-Page="@(Model.Evaluations.Page + 1)" asp-route-PageSize="@Model.Filters.PageSize">Siguiente</a>
                </nav>
            }
        }
    </div>
</section>
