@model CornersPrediction.Web.Models.BotPicks.BotH2026IndexViewModel
@{
    string Pct(double? value) => value.HasValue ? value.Value.ToString("P2") : "—";
    string Units(decimal? value) => value.HasValue ? $"{value.Value:+0.00;-0.00;0.00}u" : "—";
}
<section class="h-card">
    <div class="h-card-header"><h2 class="h5 mb-1">Evaluaciones capturadas</h2><p class="small text-secondary mb-0">Cada fila enlaza la decisión, la cuota exacta anterior al partido y el resultado oficial disponible.</p></div>
    <div class="h-card-body">
        @if (!Model.EvaluationsAvailable)
        {
            <div class="alert alert-warning mb-3" role="alert">@Model.EvaluationsErrorMessage <button type="button" class="btn btn-sm btn-outline-warning ms-2 js-retry-evaluations">Reintentar</button></div>
        }
        <form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
            <div class="col-6 col-lg-2"><label class="form-label small" for="PredictionFromUtc">Desde (UTC)</label><input name="PredictionFromUtc" id="PredictionFromUtc" type="date" class="form-control form-control-sm" value="@Model.Filters.PredictionFromUtc?.ToString("yyyy-MM-dd")" /></div>
            <div class="col-6 col-lg-2"><label class="form-label small" for="PredictionToUtc">Hasta (UTC)</label><input name="PredictionToUtc" id="PredictionToUtc" type="date" class="form-control form-control-sm" value="@Model.Filters.PredictionToUtc?.ToString("yyyy-MM-dd")" /></div>
            <div class="col-6 col-lg-2"><label class="form-label small" for="Decision">Decisión</label><select id="Decision" name="Decision" class="form-select form-select-sm"><option value="">Todas</option><option value="Approved" selected="@(Model.Filters.Decision == "Approved")">Approved</option><option value="Rejected" selected="@(Model.Filters.Decision == "Rejected")">Rejected</option></select></div>
            <div class="col-6 col-lg-2"><label class="form-label small" for="Selection">Selección</label><select id="Selection" name="Selection" class="form-select form-select-sm"><option value="">Todas</option><option value="Over" selected="@(Model.Filters.Selection == "Over")">Over</option><option value="Under" selected="@(Model.Filters.Selection == "Under")">Under</option></select></div>
            <div class="col-6 col-lg-2"><label class="form-label small" for="SettlementState">Liquidación</label><select id="SettlementState" name="SettlementState" class="form-select form-select-sm"><option value="">Todas</option><option value="Settled" selected="@(Model.Filters.SettlementState == "Settled")">Settled</option><option value="Pending" selected="@(Model.Filters.SettlementState == "Pending")">Pending</option></select></div>
            <div class="col-6 col-lg-2"><label class="form-label small" for="PageSize">Filas</label><select id="PageSize" name="PageSize" class="form-select form-select-sm"><option value="50" selected="@(Model.Filters.PageSize == 50)">50</option><option value="100" selected="@(Model.Filters.PageSize == 100)">100</option><option value="250" selected="@(Model.Filters.PageSize == 250)">250</option></select></div>
            <div class="col-12 col-lg-3"><label class="form-label small" for="MarketType">Mercado</label><input id="MarketType" name="MarketType" value="@Model.Filters.MarketType" class="form-control form-control-sm" placeholder="ej. TotalCorners" /></div>
            <div class="col-12 col-lg-3"><label class="form-label small" for="ConfigurationVersion">Configuración</label><input id="ConfigurationVersion" name="ConfigurationVersion" value="@Model.Filters.ConfigurationVersion" class="form-control form-control-sm" placeholder="versión exacta" /></div>
            <div class="col-auto"><button type="submit" class="btn btn-sm btn-primary">Aplicar filtros</button></div><div class="col-auto"><a asp-action="Index" class="btn btn-sm btn-outline-secondary">Limpiar</a></div>
        </form>
        @if (Model.EvaluationsAvailable)
        {
            <div class="d-flex flex-wrap justify-content-between gap-2 small text-secondary mb-2"><span>@Model.Evaluations.TotalRows.ToString("N0") evaluaciones · página @Model.Evaluations.Page de @Math.Max(1, Model.Evaluations.TotalPages)</span><span>Corte: @(Model.Evaluations.AsOfUtc == default ? "—" : Model.Evaluations.AsOfUtc.ToString("yyyy-MM-dd HH:mm 'UTC'"))</span></div>
            @if (Model.Evaluations.Items.Count == 0)
            {
                <div class="h-shadow-note small">No hay evaluaciones para estos filtros.</div>
            }
            else
            {
                <div class="h-table-scroll" tabindex="0" aria-label="Tabla desplazable de evaluaciones H2026">
                    <table class="table table-sm table-hover align-middle h-table"><thead><tr><th>Predicción</th><th>Partido</th><th>Mercado</th><th>Pick / cuota</th><th>Modelo</th><th>Decisión</th><th>Snapshot</th><th>Liquidación</th><th>Resultado</th><th>P/L</th></tr></thead><tbody>
                    @foreach (var item in Model.Evaluations.Items)
                    {
                        <tr><td>@item.PredictionTimestampUtc.ToString("yyyy-MM-dd HH:mm")</td><td class="h-match"><strong>@item.HomeTeam – @item.AwayTeam</strong><div class="small text-secondary">@item.League · @item.FixtureDateUtc.ToString("MM-dd HH:mm") UTC</div></td><td>@item.MarketType @item.LineValue.ToString("0.00")</td><td><strong>@item.Selection</strong> @@ @item.SelectedOdds.ToString("0.00")</td><td>@Pct(item.FinalProbability)<div class="small text-secondary">edge @Pct(item.FinalEdge) · EV @Pct(item.FinalExpectedValue)</div></td><td><span class="badge @(item.Decision == "Approved" ? "text-bg-success" : "text-bg-secondary")">@item.Decision</span><div class="small text-secondary text-truncate" style="max-width:220px" title="@item.Explanation">@item.Explanation</div></td><td class="h-lineage"><strong>#@item.OddsSnapshotId</strong> · @item.Source<div class="small text-secondary">@item.OddsCapturedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC · @item.SnapshotLineageState</div></td><td>@item.SettlementState<div class="small text-secondary">@(item.OutcomeAvailableUtc?.ToString("yyyy-MM-dd HH:mm 'UTC'") ?? "sin resultado seguro")</div></td><td>@(item.Result ?? "—")<div class="small text-secondary">actual @(item.ActualValue?.ToString() ?? "—")</div></td><td>@Units(item.ProfitLoss)</td></tr>
                    }
                    </tbody></table>
                </div>
            }
            @if (Model.Evaluations.TotalPages > 1)
            {
                <nav class="d-flex align-items-center justify-content-between gap-2 mt-3" aria-label="Paginación H2026"><a class="btn btn-sm btn-outline-secondary @(Model.Evaluations.Page <= 1 ? "disabled" : "")" asp-action="Index" asp-route-PredictionFromUtc="@Model.Filters.PredictionFromUtc?.ToString("O")" asp-route-PredictionToUtc="@Model.Filters.PredictionToUtc?.ToString("O")" asp-route-Decision="@Model.Filters.Decision" asp-route-MarketType="@Model.Filters.MarketType" asp-route-Selection="@Model.Filters.Selection" asp-route-ConfigurationVersion="@Model.Filters.ConfigurationVersion" asp-route-SettlementState="@Model.Filters.SettlementState" asp-route-Page="@(Model.Evaluations.Page - 1)" asp-route-PageSize="@Model.Filters.PageSize">Anterior</a><span class="small text-secondary">Página @Model.Evaluations.Page / @Model.Evaluations.TotalPages</span><a class="btn btn-sm btn-outline-secondary @(Model.Evaluations.Page >= Model.Evaluations.TotalPages ? "disabled" : "")" asp-action="Index" asp-route-PredictionFromUtc="@Model.Filters.PredictionFromUtc?.ToString("O")" asp-route-PredictionToUtc="@Model.Filters.PredictionToUtc?.ToString("O")" asp-route-Decision="@Model.Filters.Decision" asp-route-MarketType="@Model.Filters.MarketType" asp-route-Selection="@Model.Filters.Selection" asp-route-ConfigurationVersion="@Model.Filters.ConfigurationVersion" asp-route-SettlementState="@Model.Filters.SettlementState" asp-route-Page="@(Model.Evaluations.Page + 1)" asp-route-PageSize="@Model.Filters.PageSize">Siguiente</a></nav>
            }
        }
    </div>
</section>
