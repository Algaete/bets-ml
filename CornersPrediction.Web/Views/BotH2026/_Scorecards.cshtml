@model CornersPrediction.Web.Models.BotPicks.BotH2026IndexViewModel
@{
    var overallRows = Model.Scorecards.Where(row => row.Dimension == "Overall").OrderBy(row => row.WindowDays).ToList();
    string Pct(double? value) => value.HasValue ? value.Value.ToString("P2") : "—";
    string Num(double? value, string format = "N3") => value.HasValue ? value.Value.ToString(format) : "—";
    string Units(double? value) => value.HasValue ? $"{value.Value:+0.00;-0.00;0.00}u" : "—";
    var summary = CornersPrediction.Web.Models.BotPicks.BotH2026EvidenceSummary.From(Model);
}

<section class="h-card" data-scorecards-state="@(Model.ScorecardsAvailable ? "ready" : "error")">
    <div class="h-card-header"><h2 class="h5 mb-1">Qué podemos aprender de H</h2><p class="small text-secondary mb-0">Resumen de 30 días y métricas de 7 / 30 / 90 días. Una apuesta virtual es la primera señal aprobada por partido y configuración.</p></div>
    <div class="h-card-body">
        <div class="h-shadow-note mb-3" data-h-evidence-summary>
            <strong class="d-block mb-1">@summary.Headline</strong>
            <p class="small mb-2">@summary.Detail</p>
            <p class="small mb-0"><strong>Siguiente paso:</strong> @summary.NextStep</p>
        </div>
        @if (!Model.ScorecardsAvailable)
        {
            <div class="alert alert-warning mb-0" role="alert">@Model.ScorecardsErrorMessage <button type="button" class="btn btn-sm btn-outline-warning ms-2 js-retry-scorecards">Reintentar</button></div>
        }
        else if (overallRows.Count == 0)
        {
            <div class="h-shadow-note small">Todavía no hay evidencia suficiente para calcular scorecards. H permanece en observación.</div>
        }
        else
        {
            @if (summary.Configurations.Count > 0)
            {
                <div class="row g-3 mb-3">
                    @foreach (var configuration in summary.Configurations)
                    {
                        <div class="col-12 col-xl-6"><div class="h-metric h-100">
                            <strong class="d-block text-break">@configuration.ConfigurationVersion</strong>
                            <div class="small text-secondary mb-2">30 días · @configuration.DateFromUtc.ToString("yyyy-MM-dd") a @configuration.DateToUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</div>
                            <div class="small">@configuration.Approved primeras aprobaciones · @configuration.SafelySettled liquidadas · @configuration.UnsafeOrUnavailable pendientes o no utilizables</div>
                            <div class="mt-2"><strong>@Units(configuration.ProfitLoss)</strong> · Yield @Pct(configuration.Yield)</div>
                            <div class="small mt-2">Error modelo / mercado: @Num(configuration.PairedModelBrier) / @Num(configuration.PairedMarketBrier) · @(configuration.PairedSamples?.ToString("N0") ?? "—") pares</div>
                            <div class="small">Δ error: @Num(configuration.VerifiedDeltaBrier) · Brecha económica: @Pct(configuration.CalibrationGap)</div>
                            <a class="btn btn-sm btn-outline-primary mt-2" asp-action="Index" asp-controller="BotH2026" asp-route-ConfigurationVersion="@configuration.ConfigurationVersion" asp-route-Decision="Approved">Ver aprobadas de esta versión</a>
                        </div></div>
                    }
                </div>
            }
            <p class="small text-secondary">El yield describe resultados virtuales; no demuestra una ventaja futura. Un Δ error negativo indica menor error que el mercado <strong>en los mismos partidos</strong>. “—” significa que falta evidencia comparable, no cero. Para líneas asiáticas usamos el resultado económico equivalente (incluye push y medias ganancias/pérdidas), no una tasa binaria de aciertos ni Brier binario. No hay aquí una comparación pareada con C o F.</p>
            <div class="row g-3 mb-3">
                @foreach (var row in overallRows)
                {
                    <div class="col-12 col-lg-4"><div class="h-metric h-window h-100"><div class="d-flex justify-content-between align-items-center gap-2"><strong>@row.WindowDays días</strong><span class="badge text-bg-secondary">@row.PromotionState</span></div><div class="row g-2 mt-1 small"><div class="col-6"><span class="text-secondary d-block">Partidos evaluados</span><strong>@row.FixturesEvaluated</strong></div><div class="col-6"><span class="text-secondary d-block">Primeras aprobaciones</span><strong>@row.Approved</strong></div><div class="col-6"><span class="text-secondary d-block">Resueltas seguras</span><strong>@row.SafelySettled</strong></div><div class="col-6"><span class="text-secondary d-block">Yield</span><strong>@Pct(row.Yield)</strong></div><div class="col-6"><span class="text-secondary d-block">P/L</span><strong>@Units(row.ProfitLoss)</strong></div><div class="col-6"><span class="text-secondary d-block">Brecha económica</span><strong>@Pct(row.CalibrationGap)</strong></div><div class="col-6"><span class="text-secondary d-block">Δ error pareado</span><strong>@Num(row.VerifiedDeltaBrier)</strong></div><div class="col-6"><span class="text-secondary d-block">Pares comparables</span><strong>@(row.PairedSamples?.ToString("N0") ?? "—")</strong></div></div></div></div>
                }
            </div>
            <div class="h-table-scroll" tabindex="0" aria-label="Scorecards desplazables H2026">
                <table class="table table-sm table-hover align-middle h-table">
                    <thead><tr><th>Ventana</th><th>Dimensión</th><th>Segmento</th><th>Evaluaciones</th><th>Partidos</th><th>Señales aprob.</th><th>Primeras aprob.</th><th>Liquidadas seguras</th><th>No disponibles</th><th>Yield</th><th>Brecha económica</th><th>Δ error pareado</th><th>Pares</th><th>Cobertura</th><th>Estado</th></tr></thead>
                    <tbody>
                    @foreach (var row in Model.Scorecards.OrderBy(row => row.WindowDays).ThenBy(row => row.Dimension).ThenBy(row => row.Segment))
                    {
                        <tr><td>@row.WindowDays d</td><td>@row.Dimension</td><td>@row.Segment</td><td>@row.Evaluations</td><td>@row.FixturesEvaluated</td><td>@row.ApprovedSignals</td><td>@row.Approved</td><td>@row.SafelySettled</td><td>@row.UnsafeOrUnavailable</td><td>@Pct(row.Yield)</td><td>@Pct(row.CalibrationGap)</td><td>@Num(row.VerifiedDeltaBrier)</td><td>@(row.PairedSamples?.ToString("N0") ?? "—")</td><td>@Pct(row.CoverageRate)</td><td><span class="badge text-bg-secondary">@row.PromotionState</span></td></tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
