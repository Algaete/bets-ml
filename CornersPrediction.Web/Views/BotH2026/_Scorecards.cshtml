@model CornersPrediction.Web.Models.BotPicks.BotH2026IndexViewModel
@{
    var overallRows = Model.Scorecards.Where(row => row.Dimension == "Overall").OrderBy(row => row.WindowDays).ToList();
    string Pct(double? value) => value.HasValue ? value.Value.ToString("P2") : "—";
    string Num(double? value, string format = "N3") => value.HasValue ? value.Value.ToString(format) : "—";
    string Units(double? value) => value.HasValue ? $"{value.Value:+0.00;-0.00;0.00}u" : "—";
}

<section class="h-card" data-scorecards-state="@(Model.ScorecardsAvailable ? "ready" : "error")">
    <div class="h-card-header"><h2 class="h5 mb-1">Scorecards 7 / 30 / 90 días</h2><p class="small text-secondary mb-0">La economía usa sólo la primera señal aprobada por partido y configuración; “aprobadas” no cuenta duplicados como apuestas nuevas.</p></div>
    <div class="h-card-body">
        @if (!Model.ScorecardsAvailable)
        {
            <div class="alert alert-warning mb-0" role="alert">@Model.ScorecardsErrorMessage <button type="button" class="btn btn-sm btn-outline-warning ms-2 js-retry-scorecards">Reintentar</button></div>
        }
        else if (overallRows.Count == 0)
        {
            <div class="h-shadow-note small">Todavía no hay evidencia suficiente para calcular scorecards. H permanece en observación.</div>
        }
        else
        {
            <div class="row g-3 mb-3">
                @foreach (var row in overallRows)
                {
                    <div class="col-12 col-lg-4"><div class="h-metric h-window h-100"><div class="d-flex justify-content-between align-items-center gap-2"><strong>@row.WindowDays días</strong><span class="badge text-bg-secondary">@row.PromotionState</span></div><div class="row g-2 mt-1 small"><div class="col-6"><span class="text-secondary d-block">Partidos</span><strong>@row.FixturesEvaluated</strong></div><div class="col-6"><span class="text-secondary d-block">Resueltas seguras</span><strong>@row.SafelySettled</strong></div><div class="col-6"><span class="text-secondary d-block">Yield</span><strong>@Pct(row.Yield)</strong></div><div class="col-6"><span class="text-secondary d-block">P/L</span><strong>@Units(row.ProfitLoss)</strong></div><div class="col-6"><span class="text-secondary d-block">Brecha calibración</span><strong>@Pct(row.CalibrationGap)</strong></div><div class="col-6"><span class="text-secondary d-block">Δ Brier</span><strong>@Num(row.DeltaBrier)</strong></div></div></div></div>
                }
            </div>
            <div class="h-table-scroll" tabindex="0" aria-label="Scorecards desplazables H2026">
                <table class="table table-sm table-hover align-middle h-table">
                    <thead><tr><th>Ventana</th><th>Dimensión</th><th>Segmento</th><th>Evaluaciones</th><th>Partidos</th><th>Señales aprob.</th><th>Liquidadas seguras</th><th>No disponibles</th><th>Yield</th><th>Calibración</th><th>Δ Brier</th><th>Cobertura</th><th>Estado</th></tr></thead>
                    <tbody>
                    @foreach (var row in Model.Scorecards.OrderBy(row => row.WindowDays).ThenBy(row => row.Dimension).ThenBy(row => row.Segment))
                    {
                        <tr><td>@row.WindowDays d</td><td>@row.Dimension</td><td>@row.Segment</td><td>@row.Evaluations</td><td>@row.FixturesEvaluated</td><td>@row.ApprovedSignals</td><td>@row.SafelySettled</td><td>@row.UnsafeOrUnavailable</td><td>@Pct(row.Yield)</td><td>@Pct(row.CalibrationGap)</td><td>@Num(row.DeltaBrier)</td><td>@Pct(row.CoverageRate)</td><td><span class="badge text-bg-secondary">@row.PromotionState</span></td></tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
