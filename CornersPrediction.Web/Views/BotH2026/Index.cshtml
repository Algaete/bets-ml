@model CornersPrediction.Web.Models.BotPicks.BotH2026IndexViewModel
@{
    ViewData["Title"] = "Bot H2026 · Shadow Lab";
}

<style>
    .h-shell { display: grid; gap: 1rem; min-width: 0; max-width: 100%; }
    .h-hero { border: 1px solid var(--bs-border-color); border-radius: 1rem; padding: 1.25rem; background: linear-gradient(135deg, rgba(25, 135, 84, .14), rgba(13, 110, 253, .08)); }
    .h-status { display: inline-flex; align-items: center; gap: .45rem; border-radius: 999px; padding: .32rem .72rem; font-size: .82rem; font-weight: 750; }
    .h-status::before { content: ""; width: .55rem; height: .55rem; border-radius: 50%; background: currentColor; box-shadow: 0 0 0 .2rem color-mix(in srgb, currentColor 18%, transparent); }
    .h-status-ready { color: var(--bs-success); border: 1px solid rgba(25, 135, 84, .5); background: rgba(25, 135, 84, .1); }
    .h-status-warning { color: var(--bs-warning); border: 1px solid rgba(255, 193, 7, .5); background: rgba(255, 193, 7, .1); }
    .h-metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(145px, 1fr)); gap: .7rem; }
    .h-metric { border: 1px solid var(--bs-border-color); border-radius: .8rem; padding: .85rem; background: var(--bs-body-bg); }
    .h-metric-label { display: block; color: var(--bs-secondary-color); font-size: .72rem; letter-spacing: .04em; text-transform: uppercase; }
    .h-metric-value { display: block; margin-top: .18rem; font-size: 1.28rem; font-weight: 750; }
    .h-guard { display: flex; align-items: flex-start; gap: .65rem; padding: .8rem; border: 1px solid var(--bs-border-color); border-radius: .75rem; }
    .h-guard-mark { display: inline-grid; place-items: center; flex: 0 0 1.5rem; height: 1.5rem; border-radius: 50%; background: rgba(25, 135, 84, .14); color: var(--bs-success); font-weight: 800; }
    .h-card { border: 1px solid var(--bs-border-color); border-radius: 1rem; background: var(--bs-body-bg); overflow: hidden; min-width: 0; max-width: 100%; }
    .h-card-header { padding: 1rem 1.1rem; border-bottom: 1px solid var(--bs-border-color); }
    .h-card-body { padding: 1rem 1.1rem; min-width: 0; max-width: 100%; }
    .h-table-scroll { max-width: 100%; max-height: min(68vh, 760px); overflow: auto; overscroll-behavior: contain; scrollbar-gutter: stable; }
    .h-table { min-width: max-content; margin-bottom: 0; white-space: nowrap; }
    .h-table th { color: var(--bs-secondary-color); font-size: .72rem; letter-spacing: .03em; text-transform: uppercase; }
    .h-table-scroll .h-table thead th { position: sticky; top: 0; z-index: 2; background: var(--bs-body-bg); box-shadow: inset 0 -1px var(--bs-border-color); }
    .h-match { min-width: 220px; white-space: normal; }
    .h-lineage { min-width: 190px; white-space: normal; }
    .h-window { min-width: 210px; border-left: .22rem solid rgba(13, 110, 253, .55); }
    .h-shadow-note { border-left: .25rem solid var(--bs-info); padding: .8rem 1rem; background: rgba(13, 202, 240, .08); border-radius: .25rem .7rem .7rem .25rem; }
</style>

<div class="h-shell">
    <section class="h-hero">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
            <div>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="h-status h-status-warning">Estado cargando aparte</span>
                    <span class="badge text-bg-secondary">SHADOW ONLY</span>
                    <span class="badge text-bg-info">Sólo lectura</span>
                </div>
                <h1 class="h3 mb-2">Bot H2026 · laboratorio controlado</h1>
                <p class="text-secondary mb-0">
                    H observa decisiones y resultados con la cuota exacta disponible al decidir. No apuesta ni puede publicar:
                    esta pantalla sirve para reunir evidencia y detectar si el modelo merece seguir en prueba.
                </p>
            </div>
            <div class="small text-secondary text-end"><div>Bot: <strong class="text-body">H2026</strong></div><div>Los datos de estado aparecerán abajo sin bloquear la tabla.</div></div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger mb-0" role="alert">@Model.ErrorMessage</div>
    }
    @if (!Model.StatusAvailable || !Model.EvaluationsAvailable)
    {
        <div class="alert alert-warning mb-0" role="status"><strong>Carga parcial.</strong> Los bloques que sí respondieron permanecen utilizables.</div>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-warning mb-0" asp-validation-summary="All"></div>
    }

    <div id="HStatusHost" data-url="@Url.Action("Status", "BotH2026")">
        <section class="h-card" aria-live="polite" aria-busy="true"><div class="h-card-header"><h2 class="h5 mb-1">Estado y barreras de seguridad</h2></div><div class="h-card-body"><div class="d-flex align-items-center gap-2"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><strong>Comprobando estado sin bloquear H2026…</strong></div></div></section>
    </div>

    <div id="HScorecardsHost"
         data-url="@Url.Action("Scorecards", "BotH2026", new { PredictionFromUtc = Model.Filters.PredictionFromUtc?.ToString("O"), PredictionToUtc = Model.Filters.PredictionToUtc?.ToString("O"), AsOfUtc = Model.Filters.AsOfUtc?.ToString("O"), ConfigurationVersion = Model.Filters.ConfigurationVersion })">
        <section class="h-card" aria-live="polite" aria-busy="true">
            <div class="h-card-header"><h2 class="h5 mb-1">Scorecards 7 / 30 / 90 días</h2><p class="small text-secondary mb-0">Este cálculo carga aparte para que no bloquee H2026.</p></div>
            <div class="h-card-body"><button type="button" class="btn btn-sm btn-outline-primary js-load-scorecards">Calcular scorecards ahora</button><div class="small text-secondary mt-2">Es una consulta pesada y opcional; la tabla funciona sin ejecutarla.</div></div>
        </section>
    </div>

    <div id="HEvaluationsHost"
         data-url="@Url.Action("Evaluations", "BotH2026", new { PredictionFromUtc = Model.Filters.PredictionFromUtc?.ToString("O"), PredictionToUtc = Model.Filters.PredictionToUtc?.ToString("O"), AsOfUtc = Model.Filters.AsOfUtc?.ToString("O"), Decision = Model.Filters.Decision, MarketType = Model.Filters.MarketType, Selection = Model.Filters.Selection, ConfigurationVersion = Model.Filters.ConfigurationVersion, SettlementState = Model.Filters.SettlementState, Page = Model.Filters.Page, PageSize = Model.Filters.PageSize })">
        <section class="h-card" aria-live="polite" aria-busy="true">
            <div class="h-card-header"><h2 class="h5 mb-1">Evaluaciones capturadas</h2><p class="small text-secondary mb-0">La tabla se carga aparte para abrir H2026 sin esperas largas.</p></div>
            <div class="h-card-body"><div class="d-flex align-items-center gap-2"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><strong>Cargando tabla…</strong></div></div>
        </section>
    </div>
</div>

<script>
(() => {
    const host = document.getElementById('HStatusHost');
    if (!host) return;
    async function loadStatus() {
        try {
            const response = await fetch(host.dataset.url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            host.innerHTML = await response.text();
        } catch (error) {
            host.innerHTML = `<section class="h-card"><div class="h-card-header"><h2 class="h5 mb-1">Estado y barreras de seguridad</h2></div><div class="h-card-body"><div class="alert alert-warning mb-0">El estado demoró demasiado. La tabla sigue funcionando. <button type="button" class="btn btn-sm btn-outline-warning ms-2 js-retry-status">Reintentar</button></div></div></section>`;
        }
    }
    host.addEventListener('click', event => {
        if (event.target.closest('.js-retry-status')) loadStatus();
    });
    loadStatus();
})();

(() => {
    const host = document.getElementById('HScorecardsHost');
    if (!host) return;
    async function loadScorecards() {
        host.setAttribute('aria-busy', 'true');
        try {
            const response = await fetch(host.dataset.url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            host.innerHTML = await response.text();
        } catch (error) {
            host.innerHTML = `<section class="h-card"><div class="h-card-header"><h2 class="h5 mb-1">Scorecards 7 / 30 / 90 días</h2></div><div class="h-card-body"><div data-scorecards-state="error" class="alert alert-warning mb-0">No se pudieron cargar los scorecards. La tabla continúa disponible. <button type="button" class="btn btn-sm btn-outline-warning ms-2 js-retry-scorecards">Reintentar</button></div></div></section>`;
        } finally {
            host.setAttribute('aria-busy', 'false');
        }
    }
    host.addEventListener('click', event => {
        if (event.target.closest('.js-retry-scorecards, .js-load-scorecards')) loadScorecards();
    });
})();

(() => {
    const host = document.getElementById('HEvaluationsHost');
    if (!host) return;
    async function loadEvaluations() {
        host.setAttribute('aria-busy', 'true');
        try {
            const response = await fetch(host.dataset.url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            host.innerHTML = await response.text();
        } catch (error) {
            host.innerHTML = `<section class="h-card"><div class="h-card-header"><h2 class="h5 mb-1">Evaluaciones capturadas</h2></div><div class="h-card-body"><div class="alert alert-warning mb-0">No se pudo cargar la tabla. H2026 sigue abierto. <button type="button" class="btn btn-sm btn-outline-warning ms-2 js-retry-evaluations">Reintentar</button></div></div></section>`;
        } finally {
            host.setAttribute('aria-busy', 'false');
        }
    }
    host.addEventListener('click', event => {
        if (event.target.closest('.js-retry-evaluations')) loadEvaluations();
    });
    loadEvaluations();
})();
</script>
