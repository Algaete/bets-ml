                    .filter(row => Number(getValue(row, 'WindowDays')) === performanceWindow
                        && getValue(row, 'Dimension') === 'BotMarketSideBookmakerVersion')
                    .sort((left, right) => {
                        const order = { Red: 0, Amber: 1, Gray: 2, Green: 3 };
                        return (order[getValue(left, 'TrafficLight')] ?? 4) - (order[getValue(right, 'TrafficLight')] ?? 4)
                            || Number(getValue(right, 'PredictiveFixtures') ?? 0) - Number(getValue(left, 'PredictiveFixtures') ?? 0);
                    });
                scorecardWindowButtons.forEach(button => {
                    const active = Number(button.dataset.scorecardWindow) === performanceWindow;
                    button.classList.toggle('btn-primary', active);
                    button.classList.toggle('btn-outline-secondary', !active);
                });
                scorecardBody.innerHTML = rows.length === 0
                    ? '<tr><td colspan="9" class="text-center text-muted py-3">Sin muestra para esta ventana.</td></tr>'
                    : rows.map(row => {
                        const light = String(getValue(row, 'TrafficLight') ?? 'Gray');
                        const lightClass = light === 'Red' ? 'text-bg-danger'
                            : light === 'Amber' ? 'text-bg-warning'
                                : light === 'Green' ? 'text-bg-success' : 'text-bg-secondary';
                        const model = number(getValue(row, 'AverageModelProbability'));
                        const observed = number(getValue(row, 'ObservedWinRate'));
                        const gap = number(getValue(row, 'CalibrationGap'));
                        const deltaBrier = number(getValue(row, 'DeltaBrier'));
                        const yieldValue = number(getValue(row, 'Yield'));
                        const fixtures = Number(getValue(row, 'PredictiveFixtures') ?? 0);
                        const marketType = String(getValue(row, 'MarketType') ?? '');
                        const controlledTrial = Number(getValue(row, 'WindowDays')) === 30
                            && (marketType === 'HomeTeamGoals' || marketType === 'AwayTeamGoals')
                            && fixtures >= 30
                            && fixtures < 100
                            && yieldValue !== null && yieldValue > 0
                            && gap !== null && Math.abs(gap) <= 0.05
                            && deltaBrier !== null && deltaBrier <= 0
                            && getValue(row, 'ProductionBlocked') !== true;
                        const action = controlledTrial
                            ? 'Prueba controlada · 0.5u'
                            : getValue(row, 'Recommendation') ?? '';
                        return `<tr>
                            <td class="fw-semibold">${escapeHtml(getValue(row, 'BotKey') ?? '-')}</td>
                            <td title="${escapeHtml(getValue(row, 'AutomationVersion') ?? '')}">${escapeHtml(marketLabel(getValue(row, 'MarketType') ?? ''))} · ${escapeHtml(getValue(row, 'SelectedSide') ?? '-')} · ${escapeHtml(getValue(row, 'Bookmaker') ?? '-')}</td>
                            <td class="text-end">${escapeHtml(getValue(row, 'PredictiveResolved') ?? 0)} / ${escapeHtml(getValue(row, 'PredictiveFixtures') ?? 0)}</td>
                            <td class="text-end ${signedClass(yieldValue)}">${yieldValue === null ? '-' : escapeHtml(formatPercent(yieldValue))}</td>
                            <td class="text-end">${model === null || observed === null ? '-' : `${escapeHtml(formatPercent(model))} / ${escapeHtml(formatPercent(observed))}`}</td>
                            <td class="text-end ${signedClass(gap === null ? null : -gap)}">${gap === null ? '-' : escapeHtml(formatPercent(gap))}</td>
                            <td class="text-end ${signedClass(deltaBrier === null ? null : -deltaBrier)}">${deltaBrier === null ? '-' : escapeHtml(formatCompact(deltaBrier))}</td>
                            <td><span class="badge ${lightClass}">${escapeHtml(light)}</span></td>
                            <td class="small">${escapeHtml(action)}</td>
                        </tr>`;
                    }).join('');
                scorecardWrap.classList.remove('d-none');
            };

            const loadPerformanceScorecards = async () => {
                scorecardLoading.classList.remove('d-none');
                scorecardError.classList.add('d-none');
                try {
                    const response = await fetch(performanceScorecardsUrl);
                    if (!response.ok) throw new Error('No se pudo cargar el semáforo del servidor.');
                    performanceScorecards = await response.json();
                    renderPerformanceScorecards();
                } catch (error) {
                    performanceScorecards = [];
                    scorecardWrap.classList.add('d-none');
                    scorecardError.textContent = error instanceof Error ? error.message : 'No se pudo cargar el semáforo.';
                    scorecardError.classList.remove('d-none');
                } finally {
                    scorecardLoading.classList.add('d-none');
                }
            };

            const renderReason = raw => {
                if (!raw) {
                    return '<div class="text-muted">Sin decisionReason.</div>';
                }

                const parsed = parseDecisionReason(raw);
                if (parsed) {
                    return renderJsonValue(parsed);
                }

                return `<details open><summary>Raw decisionReason</summary><pre class="bot-picks-reason-raw">${escapeHtml(raw)}</pre></details>`;
            };

            const renderThresholds = thresholds => {
                const thresholdEntries = [
                    ['MinEdge', thresholds?.MinEdge ?? thresholds?.minEdge],
                    ['MinExpectedValue', thresholds?.MinExpectedValue ?? thresholds?.minExpectedValue],
                    ['MinDistanceToLine', thresholds?.MinDistanceToLine ?? thresholds?.minDistanceToLine],
                    ['MaxContextDifference', thresholds?.MaxContextDifference ?? thresholds?.maxContextDifference],
                    ['MinOddsExclusive', thresholds?.MinOddsExclusive ?? thresholds?.minOddsExclusive],
                    ['StakeMultiplier', thresholds?.StakeMultiplier ?? thresholds?.stakeMultiplier]
                ];

                return `
                    <div class="bot-threshold-grid">
                        ${thresholdEntries.map(([label, value]) => `
                            <div class="bot-threshold-item">
                                <div class="small text-muted">${escapeHtml(label)}</div>
                                <div class="fw-semibold">${escapeHtml(formatCompact(value))}</div>
                            </div>
                        `).join('')}
                    </div>
                `;
            };

            const renderJsonValue = value => {
                if (value === null || value === undefined) {
                    return '<span class="text-muted">null</span>';
                }

                if (Array.isArray(value)) {
                    return `<ol class="mb-0">${value.map(item => `<li>${renderJsonValue(item)}</li>`).join('')}</ol>`;
                }

                if (typeof value === 'object') {
                    return `
                        <div class="bot-picks-reason-grid">
                            ${Object.entries(value).map(([key, val]) => `
                                <div class="text-muted small">${escapeHtml(key)}</div>
                                <div>${renderJsonValue(val)}</div>
                            `).join('')}
                        </div>
                    `;
                }

                return escapeHtml(String(value));
            };

            const intelligenceValue = (value, camelName, pascalName) =>
                value?.[camelName] ?? value?.[pascalName];

            const availabilityLabels = {
                0: 'Sin confirmar', 1: 'Disponible', 2: 'Probable disponible', 3: 'Duda',
                4: 'Probable baja', 5: 'Baja confirmada', 6: 'Suspendido', 7: 'Descanso',
                8: 'No convocado', 9: 'Titular', 10: 'Suplente'
            };
            const eventLabels = {
                0: 'Lesión', 1: 'Enfermedad', 2: 'Suspensión', 3: 'Duda', 4: 'Regreso',
                5: 'Volvió a entrenar', 6: 'Descanso', 7: 'Rotación', 8: 'Exclusión táctica',
                9: 'No convocado', 10: 'Convocado', 11: 'Problema de viaje', 12: 'Fatiga',
                13: 'Cambio de entrenador', 14: 'Cambio táctico', 15: 'Cambio de formación',
                16: 'Probable titular', 17: 'Probable suplente', 18: 'Titular oficial',
                19: 'Suplente oficial', 20: 'Cambio a balón parado', 21: 'Problema interno',
                22: 'Moral positiva', 23: 'Moral negativa', 24: 'Sin clasificar'
            };

            const intelligenceEnumLabel = (value, labels, fallback = 'Sin dato') => {
                if (value === null || value === undefined || value === '') {
                    return fallback;
                }
                return labels[value] ?? String(value);
            };

            const safeExternalUrl = value => {
                try {
                    const url = new URL(String(value ?? ''));
                    return ['http:', 'https:'].includes(url.protocol) ? url.href : null;
                } catch {
                    return null;
                }
            };

            const renderIntelligenceDecision = (decisionReason, fixtureId, evidenceContainerId = null) => {
                const intelligence = decisionReason?.featureSnapshot?.footballIntelligence;
                if (!intelligence?.enabled) {
                    return '';
                }

                const result = intelligence.result ?? {};
                const applied = result.isApplied === true;
                const adjustment = number(result.probabilityAdjustment) ?? 0;
                const adjustmentPp = adjustment * 100;
                const statusClass = applied ? 'is-applied' : 'is-neutral';
                const statusLabel = applied ? 'Aplicada al pick' : 'Neutral: no influyó';
                const containerId = evidenceContainerId ?? `BotPickIntelligenceEvidence-${fixtureId}`;

                return `
                    <section class="bot-intelligence-panel ${statusClass}">
                        <div class="bot-intelligence-heading">
                            <div>
                                <div class="small text-muted text-uppercase fw-bold">Inteligencia prepartido</div>
                                <h3 class="h6 mb-0">${escapeHtml(statusLabel)}</h3>
                            </div>
                            <span class="bot-intelligence-impact ${adjustment >= 0 ? 'is-positive' : 'is-negative'}">
                                ${escapeHtml(`${adjustmentPp >= 0 ? '+' : ''}${adjustmentPp.toFixed(2)} pp`)}
                            </span>
                        </div>
                        <div class="bot-intelligence-metrics">
                            <div><span>Probabilidad antes</span><strong>${escapeHtml(`${((number(result.probabilityBefore) ?? 0) * 100).toFixed(1)}%`)}</strong></div>
                            <div><span>Probabilidad final</span><strong>${escapeHtml(`${((number(result.probabilityAfter) ?? 0) * 100).toFixed(1)}%`)}</strong></div>
                            <div><span>Snapshot local</span><strong>${escapeHtml(result.homeSnapshotId ?? '-')}</strong></div>
                            <div><span>Snapshot visita</span><strong>${escapeHtml(result.awaySnapshotId ?? '-')}</strong></div>
                        </div>
                        <div id="${escapeHtml(containerId)}" class="bot-intelligence-evidence" data-fixture-id="${escapeHtml(fixtureId)}">
                            <div class="text-muted small">Cargando bajas, noticias y fuentes guardadas…</div>
                        </div>
                    </section>`;
            };

            const renderIntelligenceEvidence = payload => {
                const facts = (payload?.facts ?? payload?.Facts ?? [])
                    .filter(fact => intelligenceValue(fact, 'isCurrent', 'IsCurrent') !== false)
                    .sort((left, right) =>
                        (number(intelligenceValue(right, 'effectiveConfidence', 'EffectiveConfidence')) ?? 0) -
                        (number(intelligenceValue(left, 'effectiveConfidence', 'EffectiveConfidence')) ?? 0));
                const documents = payload?.documents ?? payload?.Documents ?? [];
                const documentsById = new Map(documents.map(document => [
                    String(intelligenceValue(document, 'id', 'Id')),
                    document
                ]));

                if (!facts.length) {
                    return '<div class="bot-intelligence-empty">No hay una baja/noticia accionable guardada. El ajuste debe permanecer en 0.</div>';
                }

                const groups = new Map();
                facts.forEach(fact => {
                    const team = intelligenceValue(fact, 'teamNameExtracted', 'TeamNameExtracted') || 'Equipo sin identificar';
                    if (!groups.has(team)) {
                        groups.set(team, []);
                    }
                    groups.get(team).push(fact);
                });

                const teamsHtml = [...groups.entries()].map(([team, teamFacts]) => `
                    <div class="bot-intelligence-team">
                        <div class="bot-intelligence-team-title">${escapeHtml(team)} <span>${teamFacts.length}</span></div>
                        ${teamFacts.map(fact => {
                            const document = documentsById.get(String(intelligenceValue(fact, 'newsDocumentId', 'NewsDocumentId')));
                            const url = safeExternalUrl(intelligenceValue(document, 'url', 'Url'));
                            const confidence = number(intelligenceValue(fact, 'effectiveConfidence', 'EffectiveConfidence'));
                            const player = intelligenceValue(fact, 'playerNameExtracted', 'PlayerNameExtracted') || 'Equipo';
                            const reason = intelligenceValue(fact, 'reason', 'Reason');
                            const evidence = intelligenceValue(fact, 'evidenceSnippet', 'EvidenceSnippet');
                            const structuredReason = `${reason ?? ''} ${evidence ?? ''}`;
                            const isCardSuspension = /(yellow card|red card|tarjeta amarilla|tarjeta roja|cart[aã]o amarelo|cart[aã]o vermelho)/i.test(structuredReason);
                            const availability = isCardSuspension
                                ? 'Suspendido'
                                : intelligenceEnumLabel(
                                    intelligenceValue(fact, 'availabilityStatus', 'AvailabilityStatus'),
                                    availabilityLabels);
                            const event = isCardSuspension
                                ? 'Suspensión por tarjetas'
                                : intelligenceEnumLabel(
                                    intelligenceValue(fact, 'eventType', 'EventType'),
                                    eventLabels);
                            return `
                                <article class="bot-intelligence-fact">
                                    <div class="bot-intelligence-fact-head">
                                        <strong>${escapeHtml(player)}</strong>
                                        <span>${escapeHtml(availability)}</span>
                                    </div>
                                    <div class="small">${escapeHtml(event)}${reason ? ` · ${escapeHtml(reason)}` : ''}</div>
                                    ${evidence ? `<div class="bot-intelligence-quote">${escapeHtml(evidence)}</div>` : ''}
                                    <div class="bot-intelligence-source">
                                        Confianza ${escapeHtml(confidence === null ? '-' : `${(confidence * 100).toFixed(0)}%`)}
                                        ${document ? ` · ${url ? `<a href="${escapeHtml(url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(intelligenceValue(document, 'sourceDomain', 'SourceDomain') || 'Fuente')}</a>` : escapeHtml(intelligenceValue(document, 'sourceDomain', 'SourceDomain') || 'Fuente')}` : ''}
                                    </div>
                                </article>`;
                        }).join('')}
                    </div>`).join('');

                return `<div class="bot-intelligence-teams">${teamsHtml}</div><div class="small text-muted mt-2">${facts.length} hechos vigentes · ${documents.length} fuentes/documentos guardados</div>`;
            };

            const snapshotValue = (snapshot, name) =>
                number(intelligenceValue(snapshot, name.charAt(0).toLowerCase() + name.slice(1), name)) ?? 0;

            const evidenceIsAvailable = value =>
                Number(value) === 5 || String(value ?? '').toLowerCase() === 'available';

            const marketFamilyFromType = marketType => {
                const normalized = String(marketType ?? '').toUpperCase();
                if (normalized.includes('CORNER')) return 'CORNERS';
                if (normalized.includes('SHOTSONGOAL')) return 'SOG';
                if (normalized.includes('SHOT')) return 'SHOTS';
                return 'GOALS';
            };

            const marketScopeFromType = marketType => {
                const normalized = String(marketType ?? '').toUpperCase();
                if (normalized.includes('HOME')) return 'HOME';
                if (normalized.includes('AWAY')) return 'AWAY';
                return 'TOTAL';
            };

            const teamMarketSignal = (snapshot, family, config) => {
                if (!snapshot) return { offensive: 0, defensiveVulnerability: 0 };
                const confidence = Math.min(1, Math.max(0, snapshotValue(snapshot, 'OverallNewsConfidence')));
                const attack = snapshotValue(snapshot, 'AttackAvailabilityImpact');
                const defence = snapshotValue(snapshot, 'DefenceAvailabilityImpact') + snapshotValue(snapshot, 'GoalkeeperAvailabilityImpact');
                const width = snapshotValue(snapshot, 'WidthAvailabilityImpact') + snapshotValue(snapshot, 'CornerCreationImpact');
                const setPiece = snapshotValue(snapshot, 'SetPieceAvailabilityImpact');
                const attackWeight = number(config?.attackWeight) ?? 0.35;
                const defenceWeight = number(config?.defenceWeight) ?? 0.25;
                const widthWeight = number(config?.widthWeight) ?? 0.20;
                const setPieceWeight = number(config?.setPieceWeight) ?? 0.20;
                let ownAttackPenalty;
                if (family === 'CORNERS') {
                    ownAttackPenalty = attackWeight * attack + widthWeight * width + setPieceWeight * setPiece;
                } else if (family === 'SOG') {
                    ownAttackPenalty = attackWeight * (attack + snapshotValue(snapshot, 'FinishingAvailabilityImpact'))
                        + setPieceWeight * snapshotValue(snapshot, 'MissingSotShare');
                } else if (family === 'SHOTS') {
                    ownAttackPenalty = attackWeight * (attack + snapshotValue(snapshot, 'ShotGenerationImpact'))
                        + setPieceWeight * snapshotValue(snapshot, 'MissingShotShare');
                } else {
                    ownAttackPenalty = attackWeight * (attack + snapshotValue(snapshot, 'GoalScoringAvailabilityImpact'))
                        + setPieceWeight * snapshotValue(snapshot, 'MissingGoalShare');
                }
                return {
                    offensive: confidence * Math.min(0, Math.max(-1, -ownAttackPenalty)),
                    defensiveVulnerability: confidence * Math.min(1, Math.max(0, defenceWeight * defence))
                };
            };

            const calculateMarketProbabilityImpact = (family, scope, homeSnapshot, awaySnapshot, intelligenceResult, config) => {
                const home = evidenceIsAvailable(intelligenceResult?.homeEvidenceStatus)
                    ? teamMarketSignal(homeSnapshot, family, config)
                    : { offensive: 0, defensiveVulnerability: 0 };
                const away = evidenceIsAvailable(intelligenceResult?.awayEvidenceStatus)
                    ? teamMarketSignal(awaySnapshot, family, config)
                    : { offensive: 0, defensiveVulnerability: 0 };
                const overSignal = scope === 'HOME'
                    ? home.offensive + away.defensiveVulnerability
                    : scope === 'AWAY'
                        ? away.offensive + home.defensiveVulnerability
                        : (home.offensive + away.offensive + home.defensiveVulnerability + away.defensiveVulnerability) / 2;
                const weight = number(config?.weight) ?? 0.35;
                const maximum = number(config?.maximumProbabilityAdjustment) ?? 0.04;
                return Math.min(maximum, Math.max(-maximum, overSignal * weight));
            };

            const renderIntelligenceMarketImpacts = (payload, decisionReason, item) => {
                const intelligence = decisionReason?.featureSnapshot?.footballIntelligence ?? {};
                const result = intelligence.result ?? {};
                const config = decisionReason?.featureSnapshot?.configuration?.footballIntelligence ?? {};
                const snapshots = payload?.snapshots ?? payload?.Snapshots ?? [];
                const homeSnapshot = snapshots.find(snapshot =>
                    String(intelligenceValue(snapshot, 'id', 'Id')) === String(result.homeSnapshotId));
                const awaySnapshot = snapshots.find(snapshot =>
                    String(intelligenceValue(snapshot, 'id', 'Id')) === String(result.awaySnapshotId));
                const marketType = getValue(item, 'MarketType');
                const activeFamily = marketFamilyFromType(marketType);
                const scope = marketScopeFromType(marketType);
                const scopeLabel = scope === 'HOME' ? 'equipo local' : scope === 'AWAY' ? 'equipo visitante' : 'total del partido';
                const marketDefinitions = [
                    ['GOALS', 'Goles'],
                    ['CORNERS', 'Córners'],
                    ['SHOTS', 'Tiros'],
                    ['SOG', 'Tiros al arco']
                ];
                const cards = marketDefinitions.map(([family, label]) => {
                    const impact = calculateMarketProbabilityImpact(
                        family, scope, homeSnapshot, awaySnapshot, result, config);
                    const impactPp = impact * 100;
                    const direction = impact > 0.00005
                        ? 'Más · favorece Over'
                        : impact < -0.00005
                            ? 'Menos · favorece Under'
                            : 'Neutral';
                    const tone = impact > 0.00005 ? 'is-more' : impact < -0.00005 ? 'is-less' : 'is-neutral';
                    return `
                        <div class="bot-intelligence-market ${tone} ${family === activeFamily ? 'is-current' : ''}">
                            <div class="bot-intelligence-market-head">
                                <strong>${escapeHtml(label)}</strong>
                                ${family === activeFamily ? '<span>Mercado del pick</span>' : ''}
                            </div>
                            <div class="bot-intelligence-market-value">${escapeHtml(`${impactPp >= 0 ? '+' : ''}${impactPp.toFixed(2)} pp`)}</div>
                            <div class="small">${escapeHtml(direction)}</div>
                        </div>`;
                }).join('');

                const snapshotSummary = (snapshot, label) => {
                    if (!snapshot) {
                        return `<div class="bot-intelligence-empty">${escapeHtml(label)}: el snapshot usado ya no está disponible.</div>`;
                    }

                    let detail = {};
                    try {
                        detail = JSON.parse(intelligenceValue(snapshot, 'detailJson', 'DetailJson') || '{}');
                    } catch {
                        detail = {};
                    }
                    const missingPlayers = Array.isArray(detail?.missingPlayers) ? detail.missingPlayers : [];
                    const missingPlayersHtml = missingPlayers.length
                        ? `<div class="bot-intelligence-snapshot-players">
                            <strong>Bajas exactas usadas por el cálculo</strong>
                            ${missingPlayers.map(player => `
                                <span>${escapeHtml(player.playerName || 'Jugador')} · ${escapeHtml(player.position || 'posición sin dato')} · impacto ${escapeHtml(`${((number(player.impact) ?? 0) * 100).toFixed(2)}%`)}</span>`).join('')}
                          </div>`
                        : '<div class="small text-muted mt-2">El snapshot no registró una baja con impacto cuantificable.</div>';

                    return `
                        <div class="bot-intelligence-snapshot-card">
                            <div class="bot-intelligence-market-head"><strong>${escapeHtml(label)}</strong><span>Snapshot ${escapeHtml(intelligenceValue(snapshot, 'id', 'Id'))}</span></div>
                            <div class="bot-intelligence-snapshot-grid">
                                <span>Bajas accionables <strong>${escapeHtml(snapshotValue(snapshot, 'ActionableFactCount'))}</strong></span>
                                <span>Confianza <strong>${escapeHtml(`${(snapshotValue(snapshot, 'OverallNewsConfidence') * 100).toFixed(0)}%`)}</strong></span>
                                <span>Impacto ataque <strong>${escapeHtml(`${(snapshotValue(snapshot, 'AttackAvailabilityImpact') * 100).toFixed(2)}%`)}</strong></span>
                                <span>Impacto defensa <strong>${escapeHtml(`${((snapshotValue(snapshot, 'DefenceAvailabilityImpact') + snapshotValue(snapshot, 'GoalkeeperAvailabilityImpact')) * 100).toFixed(2)}%`)}</strong></span>
                            </div>
                            ${missingPlayersHtml}
                        </div>`;
                };

                return `
                    <div class="bot-intelligence-explanation">
                        <strong>Cómo leerlo:</strong> se recalculó la probabilidad de Over para ${escapeHtml(scopeLabel)}.
                        Un valor negativo significa menos eventos esperados; uno positivo significa más. No modifica directamente la predicción en unidades.
                    </div>
                    <div class="bot-intelligence-market-grid">${cards}</div>
                    <div class="bot-intelligence-snapshot-grid-wrap">
                        ${snapshotSummary(homeSnapshot, getHomeTeam(item))}
                        ${snapshotSummary(awaySnapshot, getAwayTeam(item))}
                    </div>`;
            };

            const fetchIntelligenceEvidence = async (fixtureId, cutoffUtc = null) => {
                const query = new URLSearchParams({ fixtureId: String(fixtureId) });
                if (cutoffUtc) query.set('cutoffUtc', cutoffUtc);
                const response = await fetch(`${intelligenceEndpointUrl}?${query.toString()}`);
                if (!response.ok) throw new Error('No se pudo consultar la evidencia guardada.');
                return await response.json();
            };

            const loadIntelligenceEvidence = async (fixtureId, cutoffUtc = null, containerId = null) => {
                const container = document.getElementById(containerId ?? `BotPickIntelligenceEvidence-${fixtureId}`);
                if (!container) {
                    return;
                }
                try {
                    const payload = await fetchIntelligenceEvidence(fixtureId, cutoffUtc);
                    if (document.getElementById(container.id) === container) {
                        container.innerHTML = renderIntelligenceEvidence(payload);
                    }
                } catch (error) {
                    if (document.getElementById(container.id) === container) {
                        container.innerHTML = `<div class="bot-intelligence-empty">${escapeHtml(error instanceof Error ? error.message : 'No se pudo cargar la evidencia.')}</div>`;
                    }
                }
            };

            const openIntelligence = async id => {
                const item = selectionsById.get(String(id));
                if (!item) return;
                const decisionReason = getDecisionReason(item);
                const intelligence = decisionReason?.featureSnapshot?.footballIntelligence;
                const fixtureId = getValue(item, 'ApiFootballFixtureId');
                const botInfo = getBotInfo(item);

                intelligenceSubtitle.textContent = `${getHomeTeam(item)} vs ${getAwayTeam(item)} · ${botInfo.label} · ${marketLabel(getValue(item, 'MarketType'))}`;
                if (!intelligence?.enabled) {
                    intelligenceBody.innerHTML = `
                        <div class="bot-intelligence-audit-summary is-neutral">
                            <div><span>Resultado</span><strong>No registrada</strong></div>
                            <div><span>Ajuste aplicado</span><strong>0,00 pp</strong></div>
                            <div><span>Versión del pick</span><strong>${escapeHtml(getValue(item, 'AutomationVersion') ?? '-')}</strong></div>
                            <div><span>Fixture API-Football</span><strong>${escapeHtml(fixtureId ?? 'Sin enlace')}</strong></div>
                        </div>
                        <div class="alert alert-info mt-3 mb-0">
                            Este pick fue generado antes de que la inteligencia prepartido quedara incorporada a Bot ${escapeHtml(botInfo.key)}.
                            Por lo tanto, ninguna baja o noticia modificó su probabilidad, edge, EV o decisión.
                        </div>
                        ${fixtureId ? '<div class="bot-intelligence-loading">Buscando información disponible para el partido como referencia; no fue usada por este pick…</div>' : '<div class="bot-intelligence-empty mt-3">No existe FixtureId para consultar información adicional.</div>'}`;
                    intelligenceModal.show();

                    if (fixtureId) {
                        try {
                            const payload = await fetchIntelligenceEvidence(fixtureId, null);
                            intelligenceBody.insertAdjacentHTML(
                                'beforeend',
                                `<div class="bot-intelligence-reference">
                                    <h3 class="h6">Información disponible ahora · solo referencia</h3>
                                    <p class="small text-muted">Estos datos no participaron en la decisión histórica del pick.</p>
                                    ${renderIntelligenceEvidence(payload)}
                                </div>`);
                            intelligenceBody.querySelector('.bot-intelligence-loading')?.remove();
                        } catch (error) {
                            intelligenceBody.querySelector('.bot-intelligence-loading')?.remove();
                            intelligenceBody.insertAdjacentHTML(
                                'beforeend',
                                `<div class="bot-intelligence-empty mt-3">${escapeHtml(error instanceof Error ? error.message : 'No se pudo cargar la referencia.')}</div>`);
                        }
                    }
                    return;
                }

                if (!fixtureId) {
                    intelligenceBody.innerHTML = `
                        <div class="bot-intelligence-audit-summary is-neutral">
                            <div><span>Resultado</span><strong>Sin enlace al partido</strong></div>
                            <div><span>Ajuste aplicado</span><strong>0,00 pp</strong></div>
                        </div>
                        <div class="alert alert-warning mt-3 mb-0">El pick habilitaba inteligencia, pero no tiene ApiFootballFixtureId. No existe evidencia enlazable y el ajuste debe permanecer neutral.</div>`;
                    intelligenceModal.show();
                    return;
                }

                const result = intelligence.result ?? {};
                const adjustment = (number(result.probabilityAdjustment) ?? 0) * 100;
                const applied = result.isApplied === true;
                intelligenceBody.innerHTML = `
                    <div class="bot-intelligence-audit-summary ${applied ? 'is-applied' : 'is-neutral'}">
                        <div><span>Resultado</span><strong>${applied ? 'Aplicado al pick' : 'Neutral: no influyó'}</strong></div>
                        <div><span>Ajuste al lado elegido</span><strong>${escapeHtml(`${adjustment >= 0 ? '+' : ''}${adjustment.toFixed(2)} pp`)}</strong></div>
                        <div><span>Probabilidad antes</span><strong>${escapeHtml(`${((number(result.probabilityBefore) ?? 0) * 100).toFixed(1)}%`)}</strong></div>
                        <div><span>Probabilidad final</span><strong>${escapeHtml(`${((number(result.probabilityAfter) ?? 0) * 100).toFixed(1)}%`)}</strong></div>
                    </div>
                    <div class="bot-intelligence-loading">Cargando snapshots, bajas y fuentes exactas usadas por el bot…</div>`;
                intelligenceModal.show();

                try {
                    const cutoffUtc = decisionReason?.featureSnapshot?.predictionTimestampUtc
                        ?? getValue(item, 'CreatedAtUtc')
                        ?? decisionReason?.featureSnapshot?.oddsCapturedAtUtc
                        ?? decisionReason?.featureSnapshot?.asOfDateUtc
                        ?? null;
                    const payload = await fetchIntelligenceEvidence(fixtureId, cutoffUtc);
                    const probabilityBefore = number(result.probabilityBefore) ?? 0;
                    const probabilityAfter = number(result.probabilityAfter) ?? probabilityBefore;
                    const expectedValueBefore = number(intelligence.expectedValueBeforeFootballIntelligence);
                    const finalEdge = number(getValue(item, 'ProbabilityEdge'));
                    const finalExpectedValue = number(getValue(item, 'ExpectedValue'));
                    const decision = decisionReason?.decision ?? '-';
                    const decisionLabel = String(decision).toLowerCase() === 'approved' ? 'Aprobado' : 'Rechazado';
                    intelligenceBody.innerHTML = `
                        <div class="bot-intelligence-audit-summary ${applied ? 'is-applied' : 'is-neutral'}">
                            <div><span>Resultado</span><strong>${applied ? 'Aplicado al pick' : 'Neutral: no influyó'}</strong></div>
                            <div><span>Ajuste al lado elegido</span><strong>${escapeHtml(`${adjustment >= 0 ? '+' : ''}${adjustment.toFixed(2)} pp`)}</strong></div>
                            <div><span>Probabilidad antes</span><strong>${escapeHtml(`${(probabilityBefore * 100).toFixed(1)}%`)}</strong></div>
                            <div><span>Probabilidad final</span><strong>${escapeHtml(`${(probabilityAfter * 100).toFixed(1)}%`)}</strong></div>
                        </div>
                        <div class="bot-intelligence-decision-flow mt-3">
                            <strong>Cómo entró en la decisión</strong>
                            <div class="bot-intelligence-decision-steps">
                                <span>Probabilidad calibrada <b>${escapeHtml(`${(probabilityBefore * 100).toFixed(1)}%`)}</b></span>
                                <span aria-hidden="true">→</span>
                                <span>Inteligencia <b>${escapeHtml(`${adjustment >= 0 ? '+' : ''}${adjustment.toFixed(2)} pp`)}</b></span>
                                <span aria-hidden="true">→</span>
                                <span>Probabilidad final <b>${escapeHtml(`${(probabilityAfter * 100).toFixed(1)}%`)}</b></span>
                                <span aria-hidden="true">→</span>
                                <span>Decisión <b>${escapeHtml(decisionLabel)}</b></span>
                            </div>
                            <div class="small text-muted mt-2">
                                Después del ajuste, el motor volvió a comprobar edge ${escapeHtml(finalEdge === null ? '-' : `${(finalEdge * 100).toFixed(1)}%`)}
                                y EV ${escapeHtml(finalExpectedValue === null ? '-' : `${(finalExpectedValue * 100).toFixed(1)}%`)}
                                ${expectedValueBefore === null ? '' : `(EV antes ${(expectedValueBefore * 100).toFixed(1)}%)`}.
                                La inteligencia no crea un pick por sí sola: sólo ajusta una señal ya calibrada y todos los umbrales productivos deben seguir cumpliéndose.
                            </div>
                            <div class="small text-muted mt-1">Evidencia disponible hasta ${escapeHtml(formatDate(cutoffUtc))}; no se muestran datos conocidos después de la decisión.</div>
                        </div>
                        <h3 class="h6 mt-4">Impacto calculado por mercado</h3>
                        ${renderIntelligenceMarketImpacts(payload, decisionReason, item)}
                        <h3 class="h6 mt-4">Bajas, noticias y fuentes consideradas</h3>
                        ${renderIntelligenceEvidence(payload)}`;
                } catch (error) {
                    intelligenceBody.insertAdjacentHTML(
                        'beforeend',
                        `<div class="alert alert-warning mt-3">${escapeHtml(error instanceof Error ? error.message : 'No se pudo cargar la auditoría.')}</div>`);
                }
            };

            const parseRobustCodes = value => {
                if (Array.isArray(value)) {
                    return value.filter(item => item !== null && item !== undefined && String(item).trim());
                }

                if (typeof value !== 'string' || !value.trim()) {
                    return [];
                }

                try {
                    const parsed = JSON.parse(value);
                    return Array.isArray(parsed)
                        ? parsed.filter(item => item !== null && item !== undefined && String(item).trim())
                        : [value];
                } catch {
                    return value.split(',').map(item => item.trim()).filter(Boolean);
                }
            };

            const robustSection = (payload, name) => getValue(payload, name) ?? {};
            const robustField = (section, groupedName, evaluation, flatName = groupedName) =>
                getValue(section, groupedName) ?? getValue(evaluation, flatName);

            const robustMetric = (label, value, detail = null) => `
                <div class="robust-evaluation-metric">
                    <span>${escapeHtml(label)}</span>
                    <strong>${escapeHtml(value ?? 'Sin dato')}</strong>
                    ${detail ? `<small>${escapeHtml(detail)}</small>` : ''}
                </div>`;

            const formatRobustInterval = (lower, upper) => {
                const parsedLower = number(lower);
                const parsedUpper = number(upper);
                return parsedLower === null || parsedUpper === null
                    ? 'Sin dato'
                    : `${formatPercent(parsedLower)} – ${formatPercent(parsedUpper)}`;
            };

            const formatAge = seconds => {
                const value = number(seconds);
                if (value === null || value < 0) {
                    return 'Sin dato';
                }

                if (value < 60) return `${Math.round(value)} s`;
                if (value < 3600) return `${Math.round(value / 60)} min`;
                return `${formatCompact(value / 3600)} h`;
            };

            const evidenceStatusPresentation = status => {
                const raw = String(status ?? '').trim();
                const normalized = raw.replace(/[\s_-]/g, '').toLowerCase();
                const states = {
                    appliedpositive: ['Aplicada · impacto positivo', 'is-positive'],
                    appliednegative: ['Aplicada · impacto negativo', 'is-negative'],
                    reviewedneutral: ['Revisada · neutral', 'is-neutral'],
                    insufficientevidence: ['Evidencia insuficiente', 'is-warning'],
                    sourceunavailable: ['Fuente no disponible', 'is-muted'],
                    snapshotexpired: ['Snapshot vencido', 'is-warning'],
                    notapplicable: ['No aplica', 'is-muted']
                };
                const resolved = states[normalized];
                return resolved
                    ? { raw, label: resolved[0], cssClass: resolved[1] }
                    : raw
                        ? { raw, label: raw, cssClass: 'is-muted' }
                        : { raw: '', label: 'Sin dato (no inferido)', cssClass: 'is-muted' };
            };

            const renderEvidenceStatus = status => {
                const state = evidenceStatusPresentation(status);
                const code = state.raw && state.raw !== state.label
                    ? `<small>${escapeHtml(state.raw)}</small>`
                    : '';
                return `<span class="robust-evidence-status ${state.cssClass}">${escapeHtml(state.label)}${code}</span>`;
            };

            const renderRobustCodes = (codes, emptyText, warning = false) => {
                if (!codes.length) {
                    return `<div class="text-muted small">${escapeHtml(emptyText)}</div>`;
                }

                return `<ul class="robust-evaluation-codes ${warning ? 'is-warning' : ''}">
                    ${codes.map(code => `<li><code>${escapeHtml(code)}</code></li>`).join('')}
                </ul>`;
            };

            const renderRobustComponents = components => {
                if (!Array.isArray(components) || components.length === 0) {
                    return '';
                }

                return `
                    <details class="robust-evaluation-components mt-3">
                        <summary>Componentes usados por la evaluación (${components.length})</summary>
                        <div class="table-responsive mt-2">
                            <table class="table table-sm align-middle mb-0">
                                <thead><tr><th>Tipo</th><th class="text-end">Predicción</th><th class="text-end">Prob.</th><th class="text-end">Peso</th><th>Calidad</th><th>Estado</th></tr></thead>
                                <tbody>${components.map(component => {
                                    const usable = robustField(component, 'IsUsable', component, 'IsUsable');
                                    return `<tr>
                                        <td><strong>${escapeHtml(getValue(component, 'Type') ?? getValue(component, 'ComponentType') ?? '-')}</strong><div class="small text-muted">${escapeHtml(getValue(component, 'SourceVersion') ?? '')}</div></td>
                                        <td class="text-end">${escapeHtml(formatCompact(getValue(component, 'PredictedValue')))}</td>
                                        <td class="text-end">${escapeHtml(formatPercent(getValue(component, 'ProbabilityForSelection')))}</td>
                                        <td class="text-end">${escapeHtml(formatCompact(getValue(component, 'Weight')))}</td>
                                        <td>${escapeHtml(formatPercent(getValue(component, 'DataQualityScore')))}</td>
                                        <td>${usable === false
                                            ? `<span class="text-danger">Excluido</span><div class="small text-muted">${escapeHtml(getValue(component, 'ExclusionReason') ?? '')}</div>`
                                            : '<span class="text-success">Usable</span>'}</td>
                                    </tr>`;
                                }).join('')}</tbody>
                            </table>
                        </div>
                    </details>`;
            };

            const renderRobustEvaluation = (payload, item) => {
                const evaluation = robustSection(payload, 'Evaluation');
                const identity = robustSection(payload, 'Identity');
                const versions = robustSection(payload, 'Versions');
                const predictions = robustSection(payload, 'Predictions');
                const consensus = robustSection(payload, 'Consensus');
                const distribution = robustSection(payload, 'Distribution');
                const probability = robustSection(payload, 'Probability');
                const value = robustSection(payload, 'Value');
                const calibration = robustSection(payload, 'Calibration');
                const preMatch = robustSection(payload, 'PreMatchData');
                const components = getValue(payload, 'Components') ?? getValue(evaluation, 'Components') ?? [];

                const currentDecision = robustField(evaluation, 'CurrentDecision', evaluation, 'CurrentSystemDecision')
                    ?? 'BET (pick publicado)';
                const robustDecision = robustField(evaluation, 'RobustDecision', evaluation) ?? 'Sin dato';
                const mode = robustField(evaluation, 'Mode', evaluation, 'EvaluationMode') ?? 'Shadow';
                const originalStake = robustField(evaluation, 'OriginalStake', evaluation);
                const recommendedStake = robustField(evaluation, 'RecommendedStake', evaluation);
                const stakeDifference = number(recommendedStake) !== null && number(originalStake) !== null
                    ? number(recommendedStake) - number(originalStake)
                    : null;
                const robustnessScore = robustField(evaluation, 'RobustnessScore', evaluation);
                const humanReason = robustField(evaluation, 'HumanReadableReason', evaluation);
                const robustDecisionClass = String(robustDecision).toLowerCase().includes('reject')
                    || String(robustDecision).toLowerCase().includes('no bet')
                    ? 'is-rejected'
                    : String(robustDecision).toLowerCase().includes('approve')
                        || String(robustDecision).toLowerCase() === 'bet'
                        ? 'is-approved'
                        : 'is-review';

                const reasons = parseRobustCodes(
                    getValue(payload, 'Reasons') ?? getValue(evaluation, 'RejectionReasonCodesJson'));
                const warnings = parseRobustCodes(
                    getValue(payload, 'Warnings') ?? getValue(evaluation, 'WarningCodesJson'));
                const evidenceStatus = robustField(
                    preMatch,
                    'IntelligenceEvidenceStatus',
                    evaluation,
                    'IntelligenceEvidenceStatus');
                const evidenceTarget = document.getElementById('BotPickRobustEvidenceStatus');
                if (evidenceTarget) {
                    evidenceTarget.innerHTML = renderEvidenceStatus(evidenceStatus);
                }

                const direct = robustField(predictions, 'Direct', evaluation, 'DirectPrediction');
                const home = robustField(predictions, 'Home', evaluation, 'HomePrediction');
                const away = robustField(predictions, 'Away', evaluation, 'AwayPrediction');
                const componentTotal = robustField(predictions, 'Components', evaluation, 'ComponentsPrediction');
                const context = robustField(predictions, 'Context', evaluation, 'ContextPrediction');
                const reconciled = robustField(predictions, 'Reconciled', evaluation, 'ReconciledPrediction');

                const lowerProbability = robustField(probability, 'Lower', evaluation, 'ProbabilityLowerBound')
                    ?? robustField(calibration, 'ProbabilityLower', evaluation, 'ProbabilityLowerBound');
                const upperProbability = robustField(probability, 'Upper', evaluation, 'ProbabilityUpperBound')
                    ?? robustField(calibration, 'ProbabilityUpper', evaluation, 'ProbabilityUpperBound');
                const centralProbability = robustField(probability, 'Central', evaluation, 'CalibratedProbability');
                const beforeCalibration = robustField(probability, 'BeforeCalibration', evaluation, 'RawProbability')
                    ?? robustField(calibration, 'ProbabilityBefore', evaluation, 'RawProbability');
                const afterCalibration = robustField(probability, 'AfterCalibration', evaluation, 'CalibratedProbability')
                    ?? robustField(calibration, 'ProbabilityAfter', evaluation, 'CalibratedProbability');

                const recommendedSide = robustField(consensus, 'RecommendedSide', identity, 'Side')
                    ?? getValue(item, 'SelectedSide');
                const sideAgreement = robustField(consensus, 'SideAgreement', evaluation);
                const sideAgreementLabel = sideAgreement === true ? 'Sí' : sideAgreement === false ? 'No' : 'Sin dato';
                const evaluationVersion = robustField(evaluation, 'EvaluationVersion', evaluation)
                    ?? robustField(versions, 'RobustnessVersion', evaluation, 'RobustnessVersion');

                return `
                    <section class="robust-evaluation-panel" aria-label="Evaluación robusta del pick">
                        <div class="robust-evaluation-heading">
                            <div>
                                <div class="small text-uppercase fw-bold text-muted">Robust Pick Evaluation</div>
                                <h3 class="h5 mb-1">Decisión conservadora · ${escapeHtml(mode)}</h3>
                                <div class="small text-muted">Snapshot #${escapeHtml(robustField(evaluation, 'Sequence', evaluation, 'EvaluationSequence') ?? '-')} · ${escapeHtml(formatDate(robustField(evaluation, 'AsOfUtc', evaluation)))}</div>
                            </div>
                            <span class="robust-decision-badge ${robustDecisionClass}">${escapeHtml(robustDecision)}</span>
                        </div>

                        <div class="robust-decision-comparison">
                            <div><span>Decisión actual</span><strong>${escapeHtml(currentDecision)}</strong></div>
                            <div aria-hidden="true" class="robust-decision-arrow">→</div>
                            <div><span>Decisión robusta en ${escapeHtml(mode)}</span><strong>${escapeHtml(robustDecision)}</strong></div>
                            <div><span>Stake original / recomendado</span><strong>${escapeHtml(formatCompact(originalStake))}u / ${escapeHtml(formatCompact(recommendedStake))}u</strong><small>${stakeDifference === null ? 'Sin comparación' : `${stakeDifference >= 0 ? '+' : ''}${formatCompact(stakeDifference)}u`}</small></div>
                            <div><span>Robustness score</span><strong>${escapeHtml(formatPercent(robustnessScore))}</strong></div>
                        </div>
                        ${humanReason ? `<p class="robust-human-reason">${escapeHtml(humanReason)}</p>` : ''}

                        <div class="row g-3 mt-1">
                            <div class="col-lg-6">
                                <div class="robust-evaluation-section h-100">
                                    <h4>Predicciones</h4>
                                    <div class="robust-evaluation-grid">
                                        ${robustMetric('Direct', formatCompact(direct))}
                                        ${robustMetric('Home', formatCompact(home))}
                                        ${robustMetric('Away', formatCompact(away))}
                                        ${robustMetric('Home + Away', formatCompact(componentTotal))}
                                        ${robustMetric('Context', formatCompact(context))}
                                        ${robustMetric('Reconciled', formatCompact(reconciled))}
                                        ${robustMetric('P10', formatCompact(robustField(distribution, 'P10', evaluation)))}
                                        ${robustMetric('P50', formatCompact(robustField(distribution, 'P50', evaluation)))}
                                        ${robustMetric('P90', formatCompact(robustField(distribution, 'P90', evaluation)))}
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="robust-evaluation-section h-100">
                                    <h4>Consenso</h4>
                                    <div class="robust-evaluation-grid">
                                        ${robustMetric('Lado recomendado', recommendedSide ?? 'Sin dato')}
                                        ${robustMetric('Consenso de lado', sideAgreementLabel)}
                                        ${robustMetric('Rango de predicciones', formatCompact(robustField(consensus, 'Range', evaluation, 'ConsensusRange')))}
                                        ${robustMetric('Gap Direct vs Home + Away', formatCompact(robustField(consensus, 'CoherenceGap', evaluation)))}
                                        ${robustMetric('Worst-case prediction', formatCompact(robustField(consensus, 'WorstCasePrediction', evaluation)))}
                                        ${robustMetric('Distancia directa', formatCompact(robustField(consensus, 'DirectDistance', evaluation)))}
                                        ${robustMetric('Distancia conservadora', formatCompact(robustField(consensus, 'WorstCaseDistance', evaluation)))}
                                        ${robustMetric('Distancia conservadora normalizada', formatCompact(robustField(consensus, 'NormalizedWorstCaseDistance', evaluation)))}
                                        ${robustMetric('Magnitude agreement', formatPercent(robustField(consensus, 'MagnitudeAgreement', evaluation, 'MagnitudeAgreementScore')))}
                                        ${robustMetric('Probability agreement', formatPercent(robustField(consensus, 'ProbabilityAgreement', evaluation, 'ProbabilityAgreementScore')))}
                                        ${robustMetric('Coherence score', formatPercent(robustField(consensus, 'CoherenceScore', evaluation)))}
                                        ${robustMetric('Scenario stability', formatPercent(robustField(consensus, 'ScenarioStability', evaluation, 'ScenarioSideStability')))}
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="robust-evaluation-section mt-3">
                            <h4>Probabilidades y valor</h4>
                            <div class="robust-evaluation-grid is-wide">
                                ${robustMetric('Probabilidad central', formatPercent(centralProbability))}
                                ${robustMetric('Intervalo', formatRobustInterval(lowerProbability, upperProbability))}
                                ${robustMetric('Fair probability', formatPercent(robustField(probability, 'Fair', evaluation, 'ModelFairProbability')))}
                                ${robustMetric('Mercado implícita', formatPercent(robustField(probability, 'MarketImplied', evaluation, 'MarketImpliedProbability')))}
                                ${robustMetric('Mercado no-vig', formatPercent(robustField(probability, 'MarketNoVig', evaluation, 'MarketNoVigProbability')))}
                                ${robustMetric('Point edge', formatPercent(robustField(value, 'PointEdge', evaluation)))}
                                ${robustMetric('Robust edge', formatPercent(robustField(value, 'RobustEdge', evaluation)))}
                                ${robustMetric('Point EV', formatPercent(robustField(value, 'PointEv', evaluation, 'PointExpectedValue')))}
                                ${robustMetric('Robust EV', formatPercent(robustField(value, 'RobustEv', evaluation, 'RobustExpectedValue')))}
                                ${robustMetric('Positive EV stability', formatPercent(robustField(value, 'PositiveEvStability', evaluation)))}
                            </div>
                            <h5 class="h6 mt-3">Settlement distribution</h5>
                            <div class="robust-settlement-strip">
                                ${robustMetric('Win', formatPercent(robustField(distribution, 'PWin', evaluation)))}
                                ${robustMetric('Half win', formatPercent(robustField(distribution, 'PHalfWin', evaluation)))}
                                ${robustMetric('Push', formatPercent(robustField(distribution, 'PPush', evaluation)))}
                                ${robustMetric('Half loss', formatPercent(robustField(distribution, 'PHalfLoss', evaluation)))}
                                ${robustMetric('Loss', formatPercent(robustField(distribution, 'PLoss', evaluation)))}
                            </div>
                            <div class="robust-distribution-meta mt-2">
                                <span>Método: <strong>${escapeHtml(robustField(distribution, 'Method', distribution, 'DistributionMethod') ?? 'Sin dato')}</strong></span>
                                <span>Simulaciones: <strong>${escapeHtml(formatCompact(robustField(distribution, 'SimulationCount', evaluation)))}</strong></span>
                                <span>Effective N: <strong>${escapeHtml(formatCompact(robustField(distribution, 'EffectiveN', evaluation, 'DistributionEffectiveN')))}</strong></span>
                                <span>Error scale: <strong>${escapeHtml(formatCompact(robustField(distribution, 'ErrorScale', evaluation)))}</strong></span>
                            </div>
                        </div>

                        <div class="row g-3 mt-0">
                            <div class="col-lg-6">
                                <div class="robust-evaluation-section h-100">
                                    <h4>Calibración</h4>
                                    <div class="robust-evaluation-grid">
                                        ${robustMetric('Effective N', formatCompact(robustField(calibration, 'EffectiveN', evaluation, 'CalibrationEffectiveN')))}
                                        ${robustMetric('Reliability', formatPercent(robustField(calibration, 'Reliability', evaluation, 'CalibrationReliability')))}
                                        ${robustMetric('Fallback level', robustField(calibration, 'FallbackLevel', evaluation, 'CalibrationFallbackLevel') ?? 'Sin dato')}
                                        ${robustMetric('Exact market N', formatCompact(robustField(calibration, 'ExactMarketN', evaluation, 'CalibrationExactMarketN')))}
                                        ${robustMetric('Family N', formatCompact(robustField(calibration, 'FamilyN', evaluation, 'CalibrationFamilyN')))}
                                        ${robustMetric('Global N', formatCompact(robustField(calibration, 'GlobalN', evaluation, 'CalibrationGlobalN')))}
                                        ${robustMetric('Antes de calibrar', formatPercent(beforeCalibration))}
                                        ${robustMetric('Después de calibrar', formatPercent(afterCalibration))}
                                        ${robustMetric('Intervalo calibrado', formatRobustInterval(lowerProbability, upperProbability))}
                                        ${robustMetric('Método del intervalo', robustField(calibration, 'IntervalMethod', evaluation) ?? 'Sin dato')}
                                        ${robustMetric('Confianza del intervalo', formatPercent(robustField(calibration, 'ConfidenceLevel', evaluation)))}
                                        ${robustMetric('Peso del prior', formatCompact(robustField(calibration, 'PriorWeight', evaluation)))}
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="robust-evaluation-section h-100">
                                    <h4>Datos prepartido</h4>
                                    <div class="robust-evaluation-grid">
                                        ${robustMetric('Lineup status', robustField(preMatch, 'LineupStatus', evaluation) ?? 'Sin dato')}
                                        <div class="robust-evaluation-metric"><span>Intelligence evidence</span><strong>${renderEvidenceStatus(evidenceStatus)}</strong></div>
                                        ${robustMetric('Snapshot age', (() => {
                                            const seconds = robustField(preMatch, 'SnapshotAgeSeconds', evaluation);
                                            const minutes = robustField(preMatch, 'SnapshotAgeMinutes', evaluation);
                                            return seconds !== null && seconds !== undefined
                                                ? formatAge(seconds)
                                                : minutes !== null && minutes !== undefined ? formatAge(number(minutes) * 60) : 'Sin dato';
                                        })())}
                                        ${robustMetric('Odds age', formatAge(robustField(preMatch, 'OddsAgeSeconds', evaluation)))}
                                        ${robustMetric('Estado de cuota', robustField(preMatch, 'OddsAvailabilityStatus', evaluation) ?? 'Sin dato')}
                                        ${robustMetric('Actionable facts', formatCompact(robustField(preMatch, 'ActionableFacts', preMatch, 'ActionableFactCount')))}
                                        ${robustMetric('Independent sources', formatCompact(robustField(preMatch, 'IndependentSources', preMatch, 'IndependentSourceCount')))}
                                        ${robustMetric('Fatigue status', robustField(preMatch, 'FatigueDataStatus', evaluation) ?? 'Sin dato')}
                                        ${robustMetric('Game-state model', robustField(preMatch, 'GameStateModelStatus', evaluation) ?? 'Sin dato')}
                                        ${robustMetric('Odds reliability', formatPercent(robustField(preMatch, 'OddsReliability', evaluation)))}
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3 mt-0">
                            <div class="col-lg-6">
                                <div class="robust-evaluation-section h-100">
                                    <h4>Motivos</h4>
                                    ${renderRobustCodes(reasons, 'Sin motivos de rechazo registrados.')}
                                    ${humanReason ? `<div class="small mt-2">${escapeHtml(humanReason)}</div>` : ''}
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="robust-evaluation-section h-100">
                                    <h4>Warnings</h4>
                                    ${renderRobustCodes(warnings, 'Sin warnings registrados.', true)}
                                </div>
                            </div>
                        </div>

                        <div class="robust-evaluation-section mt-3">
                            <h4>Versiones e identidad</h4>
                            <div class="robust-evaluation-grid is-wide">
                                ${robustMetric('Bot key', robustField(identity, 'BotKey', evaluation) ?? getBotInfo(item).key)}
                                ${robustMetric('Market family', robustField(identity, 'MarketFamily', versions, 'MarketFamily') ?? marketFamily)}
                                ${robustMetric('Market type', robustField(identity, 'MarketType', evaluation) ?? getValue(item, 'MarketType'))}
                                ${robustMetric('Side / line', `${robustField(identity, 'Side', evaluation) ?? getValue(item, 'SelectedSide') ?? '-'} ${formatCompact(robustField(identity, 'Line', evaluation) ?? getValue(item, 'LineValue'))}`)}
                                ${robustMetric('Bookmaker', robustField(identity, 'Bookmaker', evaluation) ?? getValue(item, 'Source'))}
                                ${robustMetric('Automation version', robustField(versions, 'AutomationVersion', evaluation) ?? getValue(item, 'AutomationVersion'))}
                                ${robustMetric('Prediction model', robustField(versions, 'PredictionModelVersion', evaluation, 'BaseModelVersion') ?? robustField(versions, 'BaseModelVersion', evaluation, 'BaseModelVersion'))}
                                ${robustMetric('Selector version', robustField(versions, 'SelectorVersion', evaluation))}
                                ${robustMetric('Calibration version', robustField(versions, 'CalibrationVersion', evaluation))}
                                ${robustMetric('Intelligence version', robustField(versions, 'IntelligenceVersion', evaluation))}
                                ${robustMetric('Settlement version', robustField(versions, 'SettlementVersion', evaluation))}
                                ${robustMetric('Robustness version', robustField(versions, 'RobustnessVersion', evaluation) ?? evaluationVersion)}
                                ${robustMetric('Policy version', robustField(versions, 'PolicyVersion', evaluation))}
                            </div>
                        </div>
                        ${renderRobustComponents(components)}
                    </section>`;
            };

            const loadRobustEvaluation = async (id, requestId, item) => {
                const target = document.getElementById('BotPickRobustEvaluationPanel');
                if (!target) {
                    return;
                }

                try {
                    let payload = robustEvaluationsById.get(String(id));
                    if (!payload) {
                        const response = await fetch(`${robustEvaluationEndpointUrl}?id=${encodeURIComponent(id)}`);
                        if (response.status === 404) {
                            if (requestId !== activeDetailRequest) return;
                            target.innerHTML = `
                                <div class="robust-evaluation-empty">
                                    <strong>Sin evaluación robusta</strong>
                                    <span>Este pick es histórico o todavía no fue procesado por la capa Shadow. Su detalle original sigue disponible y no se inventan datos faltantes.</span>
                                </div>`;
                            const evidenceTarget = document.getElementById('BotPickRobustEvidenceStatus');
                            if (evidenceTarget) evidenceTarget.textContent = 'Sin snapshot robusto';
                            return;
                        }

                        if (!response.ok) {
                            let message = 'No se pudo cargar la evaluación robusta.';
                            try {
                                const error = await response.json();
                                message = getValue(error, 'Error') ?? getValue(error, 'Message') ?? message;
                            } catch {
                                // Keep the safe fallback; an upstream proxy can return HTML.
                            }
                            throw new Error(message);
                        }

                        payload = await response.json();
                        robustEvaluationsById.set(String(id), payload);
                    }

                    if (requestId !== activeDetailRequest) return;
                    target.innerHTML = renderRobustEvaluation(payload, item);
                } catch (error) {
                    if (requestId !== activeDetailRequest) return;
                    target.innerHTML = `
                        <div class="robust-evaluation-error" role="alert">
                            <strong>Evaluación robusta no disponible</strong>
                            <span>${escapeHtml(error instanceof Error ? error.message : 'No se pudo consultar la API.')}</span>
                        </div>`;
                    const evidenceTarget = document.getElementById('BotPickRobustEvidenceStatus');
                    if (evidenceTarget) evidenceTarget.textContent = 'Error al consultar snapshot';
                }
            };

            const openDetail = id => {
                const item = selectionsById.get(String(id));
                if (!item) {
                    return;
                }

                const requestId = ++activeDetailRequest;

	                const sourceUrl = getValue(item, 'SourceUrl');
	                const botInfo = getBotInfo(item);
	                const decisionReason = getDecisionReason(item);
	                const fixtureId = getValue(item, 'ApiFootballFixtureId');
	                detailSubtitle.textContent = `${getHomeTeam(item)} vs ${getAwayTeam(item)} · ${getLeague(item)} · ${botInfo.label}`;
	                sourceLink.classList.toggle('d-none', !sourceUrl);
	                sourceLink.href = sourceUrl || '#';

                detailBody.innerHTML = `
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="small text-muted">Predicción total de ${escapeHtml(marketUnitLabel)}</div>
                            <div class="fw-semibold">${escapeHtml(formatCompact(getValue(item, 'PredictedTotalCorners')))}</div>
                        </div>
                        <div class="col-md-4">
                            <div class="small text-muted">Distancia contra linea</div>
                            <div class="fw-semibold">${escapeHtml(formatCompact(getValue(item, 'DistanceToLine')))}</div>
                        </div>
	                        <div class="col-md-4">
	                            <div class="small text-muted">Recommended side</div>
	                            <div class="fw-semibold">${escapeHtml(getValue(item, 'RecommendedSide') ?? '-')}</div>
	                        </div>
	                        <div class="col-md-4">
	                            <div class="small text-muted">Bot</div>
	                            <div><span class="bot-badge ${botInfo.badgeClass}">${escapeHtml(botInfo.label)}</span></div>
	                        </div>
	                        <div class="col-md-4">
	                            <div class="small text-muted">Automation version</div>
	                            <div class="fw-semibold">${escapeHtml(getValue(item, 'AutomationVersion') ?? 'Legacy')}</div>
	                        </div>
	                        <div class="col-md-4">
	                            <div class="small text-muted">Enlace resultado local</div>
	                            <div class="fw-semibold">Fixture ${escapeHtml(getValue(item, 'ApiFootballFixtureId') ?? '-')} · MatchHistory ${escapeHtml(getValue(item, 'MatchHistoryId') ?? '-')}</div>
	                        </div>
	                        <div class="col-md-4">
	                            <div class="small text-muted">Liquidación automática</div>
	                            <div class="fw-semibold">${escapeHtml(getValue(item, 'SettlementSource') ?? '-')} · ${escapeHtml(getValue(item, 'SettlementMatchStatus') ?? '-')}</div>
	                            <div class="small text-muted">${escapeHtml(getValue(item, 'SettlementReason') ?? getValue(item, 'LastSettlementCheckReason') ?? '-')}</div>
	                        </div>
	                        <div class="col-md-4">
	                            <div class="small text-muted">Estado de evidencia robusta</div>
	                            <div id="BotPickRobustEvidenceStatus"><span class="placeholder-glow"><span class="placeholder col-8"></span></span></div>
	                        </div>
	                        <div class="col-md-4">
	                            <div class="small text-muted">Direct / Home / Away</div>
	                            <div class="fw-semibold">${escapeHtml(formatCompact(getValue(item, 'PredTotalDirect')))} / ${escapeHtml(formatCompact(getValue(item, 'PredHomeCorners')))} / ${escapeHtml(formatCompact(getValue(item, 'PredAwayCorners')))}</div>
                        </div>
                        <div class="col-md-4">
                            <div class="small text-muted">Context total</div>
                            <div class="fw-semibold">${escapeHtml(formatCompact(getValue(item, 'ContextTotalCorners')))}</div>
                        </div>
                        <div class="col-md-4">
                            <div class="small text-muted">Context difference</div>
                            <div class="fw-semibold">${escapeHtml(formatCompact(getValue(item, 'ContextDifference')))}</div>
                        </div>
                        <div class="col-md-4">
                            <div class="small text-muted">Created</div>
                            <div class="fw-semibold">${escapeHtml(formatDate(getValue(item, 'CreatedAtUtc')))}</div>
                        </div>
                        <div class="col-md-4">
                            <div class="small text-muted">Updated</div>
                            <div class="fw-semibold">${escapeHtml(formatDate(getValue(item, 'UpdatedAtUtc')))}</div>
                        </div>
                        <div class="col-md-4">
                            <div class="small text-muted">Settled</div>
                            <div class="fw-semibold">${escapeHtml(formatDateOnly(getValue(item, 'SettledAtUtc')))}</div>
                        </div>
	                    </div>
	                    ${renderIntelligenceDecision(decisionReason, fixtureId)}
	                    <div id="BotPickRobustEvaluationPanel" class="mt-3">
                            <div class="robust-evaluation-loading" role="status">
                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                <span>Cargando evaluación robusta Shadow…</span>
                            </div>
                        </div>
	                    <hr />
	                    <h3 class="h6">Thresholds usados</h3>
	                    ${renderThresholds(decisionReason?.thresholds)}
	                    <hr />
	                    <h3 class="h6">Decision reason</h3>
                    ${renderReason(getValue(item, 'DecisionReason'))}
                `;

                if (fixtureId && decisionReason?.featureSnapshot?.footballIntelligence?.enabled) {
                    const cutoffUtc = decisionReason?.featureSnapshot?.asOfDateUtc ?? null;
                    void loadIntelligenceEvidence(fixtureId, cutoffUtc);
                }

                detailModal.show();
                void loadRobustEvaluation(id, requestId, item);
            };

            filtersForm.addEventListener('submit', event => {
                event.preventDefault();
                loadSelections();
            });

            const syncFlatStakeStep = () => {
                const isClp = betCurrencySelect.value === 'CLP';
                flatBetStakeInput.step = isClp ? '1' : '0.01';
                flatBetStakeInput.min = isClp ? '1' : '0.01';

                const currentStake = number(flatBetStakeInput.value);
                if (isClp && currentStake !== null) {
                    flatBetStakeInput.value = String(Math.max(1, Math.round(currentStake)));
                    localStorage.setItem('bot-picks-flat-bet-stake', flatBetStakeInput.value);
                }
            };

            betCurrencySelect.addEventListener('change', () => {
                localStorage.setItem('bot-picks-bet-currency', betCurrencySelect.value);
                syncFlatStakeStep();
                render();
            });
            flatBetStakeInput.addEventListener('input', () => {
                localStorage.setItem('bot-picks-flat-bet-stake', flatBetStakeInput.value);
                render();
            });
            monthInput.addEventListener('change', () => {
                setMonthRange(parseMonthKey(monthInput.value));
            });
            previousMonthButton.addEventListener('click', () => {
                const selected = parseMonthKey(monthInput.value);
                setMonthRange(new Date(selected.getFullYear(), selected.getMonth() - 1, 1));
            });
            currentMonthButton.addEventListener('click', () => {
                const today = new Date();
                setMonthRange(new Date(today.getFullYear(), today.getMonth(), 1));
            });
            nextMonthButton.addEventListener('click', () => {
                const selected = parseMonthKey(monthInput.value);
                setMonthRange(new Date(selected.getFullYear(), selected.getMonth() + 1, 1));
            });
            botCHistoricalPendingButton.addEventListener('click', () => {
                const today = new Date();
                const formatDateInput = date =>
                    `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
                monthInput.value = '';
                dateFromInput.value = '2026-06-19';
                dateToInput.value = formatDateInput(today);
                statusSelect.value = 'Pending';
                tableBotKey = '';
                tableView = 'pending';
                tableBotSelect.value = '';
                localStorage.setItem(`${storagePrefix}-table-bot`, tableBotKey);
                localStorage.setItem(`${storagePrefix}-table-view`, tableView);
                filtersForm.requestSubmit();
            });
            dateFromInput.addEventListener('change', () => {
                if (!dateFromInput.value) {
                    return;
                }

                monthInput.value = dateFromInput.value.slice(0, 7);
                const selected = parseMonthKey(monthInput.value);
                const today = new Date();
                nextMonthButton.disabled =
                    selected.getFullYear() === today.getFullYear() &&
                    selected.getMonth() === today.getMonth();
            });
            monthlyHistoryBody.addEventListener('click', event => {
                const monthButton = event.target.closest('button[data-history-month]');
                if (monthButton) {
                    setMonthRange(parseMonthKey(monthButton.dataset.historyMonth));
                }
            });

	            refreshButton.addEventListener('click', () => {
                loadSelections();
                loadMonthlyHistory();
                loadPerformanceScorecards();
            });
            scorecardWindowButtons.forEach(button => button.addEventListener('click', () => {
                performanceWindow = Number(button.dataset.scorecardWindow) || 30;
                renderPerformanceScorecards();
            }));
            settleLocalButton?.addEventListener('click', settleLocalSelections);
            settlePendingButton?.addEventListener('click', settlePendingSelections);
		    let searchDebounce;
		    searchInput.addEventListener('input', () => {
                clearTimeout(searchDebounce);
                searchDebounce = setTimeout(() => render(true), 180);
            });
            strategyPlanSelect.addEventListener('change', () => render(true));
            intelligenceFilterSelect.addEventListener('change', () => render(true));
            tableBotSelect.addEventListener('change', () => {
                tableBotKey = tableBotSelect.value;
                localStorage.setItem(`${storagePrefix}-table-bot`, tableBotKey);
                render(true);
            });
            tableViewButtons.forEach(button => {
                button.addEventListener('click', () => {
                    tableView = button.dataset.tableView ?? 'all';
                    pendingReasonFilter = 'all';
                    localStorage.setItem(`${storagePrefix}-table-view`, tableView);
                    render(true);
                });
            });
            pendingReasonButtons.forEach(button => {
                button.addEventListener('click', () => {
                    pendingReasonFilter = button.dataset.pendingReason ?? 'all';
                    tableView = 'pending';
                    localStorage.setItem(`${storagePrefix}-table-view`, tableView);
                    render(true);
                });
            });
            leaguePerformanceSearch.addEventListener('input', () =>
                renderLeaguePerformance(leaguePerformanceItems));
            leaguePerformanceSort.addEventListener('change', () =>
                renderLeaguePerformance(leaguePerformanceItems));
            botTabButtons.forEach(button => {
                button.addEventListener('click', () => {
                    activeBotTab = button.dataset.botTab ?? '';
                    localStorage.setItem(`${storagePrefix}-active-tab`, activeBotTab);
                    render(true);
                });
            });
            comparisonCards.forEach(card => {
                const selectSummaryBot = () => {
                    activeBotTab = card.dataset.summaryBot ?? 'C';
                    localStorage.setItem(`${storagePrefix}-active-tab`, activeBotTab);
                    render(true);
                    document.getElementById('BotPicksSummary').scrollIntoView({ behavior: 'smooth', block: 'start' });
                };
                card.addEventListener('click', selectSummaryBot);
                card.addEventListener('keydown', event => {
                    if (event.key === 'Enter' || event.key === ' ') {
                        event.preventDefault();
                        selectSummaryBot();
                    }
                });
            });
		            initialBankrollInput.addEventListener('input', () => {
	                localStorage.setItem(`${storagePrefix}-initial-bankroll`, initialBankrollInput.value);
	                render();
	            });
		            tableBody.addEventListener('click', event => {
	                const resolveButton = event.target.closest('button[data-resolve-selection]');
	                if (resolveButton) {
	                    resolveSelection(resolveButton.dataset.resolveSelection);
	                    return;
	                }

	                const deleteButton = event.target.closest('button[data-delete-selection]');
	                if (deleteButton) {
	                    deleteSelection(deleteButton.dataset.deleteSelection);
	                    return;
	                }

	                const statusButton = event.target.closest('button[data-status-action]');
	                if (statusButton) {
	                    updateSelectionStatus(statusButton.dataset.selectionId, statusButton.dataset.statusAction);
	                    return;
	                }

	                const button = event.target.closest('button[data-detail-id]');
	                if (button) {
	                    openDetail(button.dataset.detailId);
	                    return;
	                }

	                const intelligenceButton = event.target.closest('button[data-intelligence-id]');
	                if (intelligenceButton) {
	                    void openIntelligence(intelligenceButton.dataset.intelligenceId);
	                }
	            });

	            tableBody.addEventListener('keydown', event => {
	                const input = event.target.closest('input[data-actual-result]');
	                if (input && event.key === 'Enter') {
	                    event.preventDefault();
	                    resolveSelection(input.dataset.actualResult);
	                }
	            });

            paginationButtons.addEventListener('click', event => {
                const pageButton = event.target.closest('button[data-page]');
                if (!pageButton || pageButton.disabled) {
                    return;
                }

                const nextPage = Number(pageButton.dataset.page);
                if (!Number.isInteger(nextPage) || nextPage < 1) {
                    return;
                }

                currentPage = nextPage;
                renderRows();
                document.getElementById('BotPicksTableTitle').scrollIntoView({
                    behavior: 'smooth',
                    block: 'start'
                });
            });

            document.querySelectorAll('[data-sort]').forEach(button => {
                button.addEventListener('click', () => {
                    const nextField = button.dataset.sort;
                    if (sortField === nextField) {
                        sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
                    } else {
                        sortField = nextField;
                        sortDirection = nextField === 'matchDate' ? 'asc' : 'desc';
                    }

                    render(true);
                });
            });

            syncFlatStakeStep();
            const initialMonth = parseMonthKey(monthInput.value);
            const today = new Date();
            nextMonthButton.disabled =
                initialMonth.getFullYear() === today.getFullYear() &&
                initialMonth.getMonth() === today.getMonth();
            loadSelections();
            loadMonthlyHistory();
            loadPerformanceScorecards();
        })();
    </script>
}
