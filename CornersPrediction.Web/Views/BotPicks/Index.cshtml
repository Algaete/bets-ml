            const emptyState = document.getElementById('BotPicksEmpty');
            const tableWrap = document.getElementById('BotPicksTableWrap');
            const tableBody = document.getElementById('BotPicksTableBody');
            const errorState = document.getElementById('BotPicksError');
            const settlementResultState = document.getElementById('BotPicksSettlementResult');
            const visibleCount = document.getElementById('BotPicksVisibleCount');
            const sortState = document.getElementById('BotPicksSortState');
            const tableTitle = document.getElementById('BotPicksTableTitle');
            const pagination = document.getElementById('BotPicksPagination');
            const paginationSummary = document.getElementById('BotPicksPaginationSummary');
            const paginationButtons = document.getElementById('BotPicksPaginationButtons');
            const botTabButtons = Array.from(document.querySelectorAll('[data-bot-tab]'));
            const comparisonCards = Array.from(document.querySelectorAll('[data-summary-bot]'));
            const detailModalElement = document.getElementById('BotPickDetailModal');
            const detailModal = bootstrap.Modal.getOrCreateInstance(detailModalElement);
            const detailSubtitle = document.getElementById('BotPickDetailSubtitle');
            const detailBody = document.getElementById('BotPickDetailBody');
            const sourceLink = document.getElementById('BotPickSourceLink');
            const monthlyHistoryLoading = document.getElementById('BotPicksMonthlyHistoryLoading');
            const monthlyHistoryEmpty = document.getElementById('BotPicksMonthlyHistoryEmpty');
            const monthlyHistoryWrap = document.getElementById('BotPicksMonthlyHistoryWrap');
            const monthlyHistoryBody = document.getElementById('BotPicksMonthlyHistoryBody');
            const summaryPeriod = document.getElementById('BotPicksSummaryPeriod');
            const bankrollChart = document.getElementById('BotPicksBankrollChart');
            const bankrollChartWrap = document.getElementById('BotPicksBankrollChartWrap');
            const bankrollChartEmpty = document.getElementById('BotPicksBankrollChartEmpty');
            const chartRecommendedValue = document.getElementById('BotPicksChartRecommendedValue');
            const chartAllValue = document.getElementById('BotPicksChartAllValue');
            const leaguePerformanceSearch = document.getElementById('BotPicksDsLeagueSearch');
            const leaguePerformanceSort = document.getElementById('BotPicksDsLeagueSort');
            const productionPlanSection = document.getElementById('BotPicksProductionPlan');
            const perBotSummarySection = document.getElementById('BotPicksPerBotSummary');
            const selectBotSummaryNotice = document.getElementById('BotPicksSelectBotSummary');
            const summaryTitle = document.getElementById('BotPicksSummaryTitle');
            const summaryScope = document.getElementById('BotPicksSummaryScope');
            const bankrollChartTitle = document.getElementById('BotPicksBankrollChartTitle');
            const summarySample = document.getElementById('BotPicksSummarySample');
            const botContextTitle = document.getElementById('BotPicksBotContextTitle');
            const botContextText = document.getElementById('BotPicksBotContextText');
            const botContextSample = document.getElementById('BotPicksBotContextSample');
            const selectionsById = new Map();
            const productionPlansById = new Map();
            const summaryProductionPlansById = new Map();

            let selections = [];
            let filteredSelections = [];
            let tableSelections = [];
            let monthlyHistoryItems = [];
            const pageSize = 20;
            let currentPage = 1;
	            let sortField = 'matchDate';
	            let sortDirection = 'asc';
            let activeBotTab = localStorage.getItem(`${storagePrefix}-active-tab`) ?? 'C';
            let tableBotKey = localStorage.getItem(`${storagePrefix}-table-bot`) ?? '';
            let tableView = localStorage.getItem(`${storagePrefix}-table-view`) ?? 'all';
            let leaguePerformanceItems = [];
		            let requestController;

            if (!['', 'A', 'B', 'C', 'D', 'E', 'F', 'Legacy'].includes(activeBotTab)) {
                activeBotTab = 'C';
            }

            if (!['', 'A', 'B', 'C', 'D', 'E', 'F', 'Legacy'].includes(tableBotKey)) {
                tableBotKey = '';
            }

            if (!['all', 'pending', 'resolved'].includes(tableView)) {
                tableView = 'all';
            }

            tableBotSelect.value = tableBotKey;

	            const savedInitialBankroll = localStorage.getItem(`${storagePrefix}-initial-bankroll`);
	            if (savedInitialBankroll && Number.isFinite(Number(savedInitialBankroll))) {
	                initialBankrollInput.value = savedInitialBankroll;
	            }

            const savedBetCurrency = localStorage.getItem('bot-picks-bet-currency');
            if (['CLP', 'USD', 'AUD'].includes(savedBetCurrency)) {
                betCurrencySelect.value = savedBetCurrency;
            }

            const savedFlatBetStake = Number(localStorage.getItem('bot-picks-flat-bet-stake'));
            if (Number.isFinite(savedFlatBetStake) && savedFlatBetStake > 0) {
                flatBetStakeInput.value = String(savedFlatBetStake);
            }

            const getValue = (item, name) => item[name.charAt(0).toLowerCase() + name.slice(1)] ?? item[name];
            const number = value => {
                const parsed = Number(value);
                return Number.isFinite(parsed) ? parsed : null;
            };
            const escapeHtml = value => String(value ?? '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');

            const parseDecisionReason = raw => {
                if (!raw || typeof raw !== 'string') {
                    return null;
                }

                try {
                    const parsed = JSON.parse(raw);
                    return parsed && typeof parsed === 'object' ? parsed : null;
                } catch {
                    return null;
                }
            };

            const getDecisionReason = item => parseDecisionReason(getValue(item, 'DecisionReason'));

            const getBotInfo = item => {
                const version = String(getValue(item, 'AutomationVersion') ?? '').trim();
                const normalizedVersion = version.toUpperCase();
                const decision = getDecisionReason(item);
                const decisionBotKey = String(decision?.botProfile ?? '').toUpperCase();
                if (normalizedVersion.endsWith('-A') || decisionBotKey === 'A') {
                    return { key: 'A', statsKey: 'A', label: 'Bot A', description: 'Actual', badgeClass: 'bot-badge-a' };
                }

                if (normalizedVersion.endsWith('-B') || decisionBotKey === 'B') {
                    return { key: 'B', statsKey: 'B', label: 'Bot B', description: 'Conservador', badgeClass: 'bot-badge-b' };
                }

                if (normalizedVersion.endsWith('-C2026') || ['C', 'C2026'].includes(decisionBotKey)) {
                    return { key: 'C', statsKey: 'C', label: 'Bot C', description: 'Modelos 2026', badgeClass: 'bot-badge-c' };
                }

                if (normalizedVersion.endsWith('-D2026') || ['D', 'D2026'].includes(decisionBotKey)) {
                    return { key: 'D', statsKey: 'D', label: 'Bot D', description: 'Brecha de nivel', badgeClass: 'bot-badge-d' };
                }

                if (normalizedVersion.endsWith('-E2026') || ['E', 'E2026'].includes(decisionBotKey)) {
                    return { key: 'E', statsKey: 'E', label: 'Bot E', description: 'Calibración empírica', badgeClass: 'bot-badge-e' };
                }
                if (normalizedVersion.endsWith('-F2026') || ['F', 'F2026'].includes(decisionBotKey)) {
                    return { key: 'F', statsKey: 'F', label: 'Bot F', description: 'Legacy ML calibrado', badgeClass: 'bot-badge-f' };
                }

                if (decision?.botProfile) {
                    return {
                        key: 'Legacy',
                        statsKey: 'Legacy',
                        label: decision.displayName || decision.botProfile,
                        description: `Personalizado · ${decision.botProfile}`,
                        badgeClass: 'bot-badge-legacy'
                    };
                }

                return { key: 'Legacy', statsKey: 'Legacy', label: 'Legacy', description: version || 'Sin version', badgeClass: 'bot-badge-legacy' };
            };

            const hasNeutralAdjustment = item => getDecisionReason(item)?.isNeutralAdjusted === true;

            const dateFormatter = new Intl.DateTimeFormat(locale, {
                year: 'numeric',
                month: 'short',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit'
            });
            const dateOnlyFormatter = new Intl.DateTimeFormat(locale, {
                year: 'numeric',
                month: 'short',
                day: '2-digit'
            });
            const decimalFormatter = new Intl.NumberFormat(locale, {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
            const compactDecimalFormatter = new Intl.NumberFormat(locale, {
                minimumFractionDigits: 0,
                maximumFractionDigits: 2
            });

            const formatDate = value => {
                if (!value) {
                    return '-';
                }

                const date = new Date(value);
                return Number.isNaN(date.getTime()) ? '-' : dateFormatter.format(date);
            };

            const formatDateOnly = value => {
                if (!value) {
                    return '-';
                }

                const date = new Date(value);
                return Number.isNaN(date.getTime()) ? '-' : dateOnlyFormatter.format(date);
            };

            const formatDecimal = (value, fallback = '-') => {
                const parsed = number(value);
                return parsed === null ? fallback : decimalFormatter.format(parsed);
            };

            const formatCompact = value => {
                const parsed = number(value);
                return parsed === null ? '-' : compactDecimalFormatter.format(parsed);
            };

            const formatPercent = value => {
                const parsed = number(value);
                if (parsed === null) {
                    return '-';
                }

                const percent = Math.abs(parsed) <= 1 ? parsed * 100 : parsed;
                return `${compactDecimalFormatter.format(percent)}%`;
            };

            const formatQueryNumber = (value, decimals = 2) => {
                const parsed = number(value);
                return parsed === null ? null : parsed.toFixed(decimals);
            };

	            const signedClass = value => {
	                const parsed = number(value);
	                return parsed === null || parsed === 0 ? 'text-muted' : parsed > 0 ? 'text-success' : 'text-danger';
	            };

	            const statusRowClass = status => {
	                const normalized = String(status ?? '').toLowerCase();
	                if (normalized === 'won') return 'bot-pick-row-won';
	                if (normalized === 'lost') return 'bot-pick-row-lost';
	                if (normalized === 'push' || normalized === 'void') return 'bot-pick-row-void';
	                return 'bot-pick-row-pending';
	            };

		            const simulatedProfitLoss = (item, stakeUnits) => {
		                const status = String(getValue(item, 'Status') ?? '').toLowerCase();
		                const odds = number(getValue(item, 'Odds'));
		                const storedProfit = number(getValue(item, 'ProfitLoss'));
		                const storedStake = number(getValue(item, 'Stake'));
		                if (['won', 'lost', 'push'].includes(status) && storedProfit !== null && storedStake !== null && storedStake > 0) {
		                    return (storedProfit / storedStake) * stakeUnits;
		                }

		                if (status === 'won' && odds !== null) {
	                    return stakeUnits * (odds - 1);
	                }

	                if (status === 'lost') {
	                    return -stakeUnits;
	                }

	                return 0;
	            };

            const statusBadgeClass = status => {
                const normalized = String(status ?? '').toLowerCase();
                if (normalized === 'won') return 'text-bg-success';
                if (normalized === 'lost') return 'text-bg-danger';
                if (normalized === 'push' || normalized === 'void') return 'text-bg-secondary';
                if (normalized === 'pending') return 'text-bg-warning';
                return 'text-bg-light';
            };

            const sideBadgeClass = side => String(side ?? '').toLowerCase() === 'over'
                ? 'text-bg-success'
                : 'text-bg-info';

            const highValueClass = value => {
                const parsed = number(value);
                return parsed !== null && parsed >= 0.08 ? 'fw-semibold text-success' : '';
            };

            const marketLabel = marketType => {
                const normalized = String(marketType ?? '');
                if (normalized === 'HomeTeamCorners') return 'Corners local';
                if (normalized === 'AwayTeamCorners') return 'Corners visita';
                if (normalized === 'HomeTeamGoals') return 'Goles local';
                if (normalized === 'AwayTeamGoals') return 'Goles visita';
                if (normalized === 'TotalGoals') return 'Goles totales';
                if (normalized === 'HomeTeamShots') return 'Tiros local';
                if (normalized === 'AwayTeamShots') return 'Tiros visita';
                if (normalized === 'TotalShots') return 'Tiros totales';
                if (normalized === 'HomeTeamShotsOnGoal') return 'Tiros al arco local';
                if (normalized === 'AwayTeamShotsOnGoal') return 'Tiros al arco visita';
                if (normalized === 'TotalShotsOnGoal') return 'Tiros al arco totales';
                return 'Corners totales';
            };

            const actualResultValue = item => {
                const marketType = String(getValue(item, 'MarketType') ?? '');
                if (['HomeTeamCorners', 'HomeTeamGoals', 'HomeTeamShots', 'HomeTeamShotsOnGoal'].includes(marketType)) {
                    return number(getValue(item, 'ActualHomeCorners'));
                }

                if (['AwayTeamCorners', 'AwayTeamGoals', 'AwayTeamShots', 'AwayTeamShotsOnGoal'].includes(marketType)) {
                    return number(getValue(item, 'ActualAwayCorners'));
                }

                return number(getValue(item, 'ActualTotalCorners'));
            };

            const settlementOutcomeLabel = item => {
                const status = String(getValue(item, 'Status') ?? '').toLowerCase();
                const actual = actualResultValue(item);
                const profitLoss = number(getValue(item, 'ProfitLoss'));
                const stake = number(getValue(item, 'Stake'));
                const odds = number(getValue(item, 'Odds'));

                if (status === 'pending') return 'Pendiente';
                if (status === 'push') return 'Push · apuesta devuelta';
                if (status === 'void') return actual === null ? 'Anulada' : 'Devuelta';

                if (status === 'won') {
                    const fullWin = stake !== null && odds !== null
                        ? Math.round(stake * (odds - 1) * 100) / 100
                        : null;
                    return profitLoss !== null && fullWin !== null && profitLoss < fullWin - 0.01
                        ? 'Media ganancia'
                        : 'Ganada completa';
                }

                if (status === 'lost') {
                    return profitLoss !== null && stake !== null && Math.abs(profitLoss) < stake - 0.01
                        ? 'Media pérdida'
                        : 'Perdida completa';
                }

                return getValue(item, 'Status') ?? '-';
            };

	            const confidenceBadgeClass = confidence => {
	                const normalized = String(confidence ?? '').toLowerCase();
	                if (normalized === 'very high' || normalized === 'very_high') return 'text-bg-primary';
	                if (normalized === 'high') return 'text-bg-success';
	                if (normalized === 'medium') return 'text-bg-warning';
	                if (normalized === 'low') return 'text-bg-secondary';
	                return 'text-bg-light';
            };

            const getLeague = item => getValue(item, 'StandardizedLeague') || getValue(item, 'League') || '-';
            const getHomeTeam = item => getValue(item, 'StandardizedHomeTeam') || getValue(item, 'HomeTeam') || '-';
            const getAwayTeam = item => getValue(item, 'StandardizedAwayTeam') || getValue(item, 'AwayTeam') || '-';
            const normalizePlanKey = value => String(value ?? '')
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .toLowerCase()
                .replace(/[^a-z0-9]+/g, ' ')
                .trim();
            const canonicalLeagueLabel = item => {
                const league = getLeague(item);
                const aliases = {
                    'brasil brasileirao serie b': 'Brazil - Serie B',
                    'brazil serie b': 'Brazil - Serie B',
                    'conmebol copa sudamericana': 'Copa Sudamericana',
                    'copa sudamericana': 'Copa Sudamericana',
                    'ecuador liga pro serie a': 'Ecuador - Serie A',
                    'ecuador serie a': 'Ecuador - Serie A',
                    'mexico liga mx': 'México - Liga MX',
                    'noruega eliteserien': 'Norway - Eliteserien',
                    'norway eliteserien': 'Norway - Eliteserien',
                    'conference league clasificacion': 'UEFA Conference League - Clasificación',
                    'europa league clasificacion': 'UEFA Europa League - Clasificación',
                    'uefa europa league qualifiers': 'UEFA Europa League - Clasificación'
                };
                return aliases[normalizePlanKey(league)] || league;
            };
            const productionMatchKey = item => [
                String(getValue(item, 'MatchDate') ?? '').slice(0, 16),
                normalizePlanKey(getHomeTeam(item)),
                normalizePlanKey(getAwayTeam(item))
            ].join('|');
            const productionSignalKey = item => [
                productionMatchKey(item),
                getValue(item, 'MarketType'),
                getValue(item, 'SelectedSide'),
                formatQueryNumber(getValue(item, 'LineValue'), 2)
            ].join('|');

            const monitoringReason = item => {
                const source = String(getValue(item, 'Source') ?? '');
                const normalizedSource = source.trim().toLowerCase();
                const marketType = String(getValue(item, 'MarketType') ?? '');
                const odds = number(getValue(item, 'Odds'));

                if (canonicalLeagueLabel(item) === 'Brazil - Serie B') {
                    return 'Brasil Serie B bloqueada por inestabilidad';
                }

                if (!['pinnacle', 'betano'].includes(normalizedSource)) {
                    return `${source || 'Casa desconocida'} queda en monitoreo`;
                }

                if (marketFamily !== 'corners') {
                    if (odds === null || odds < 1.6) {
                        return 'Cuota menor a 1.60';
                    }

                    return null;
                }

                if (marketType === 'TotalCorners') {
                    return 'Corners totales queda en monitoreo';
                }

                if (!['HomeTeamCorners', 'AwayTeamCorners'].includes(marketType)) {
                    return 'Mercado fuera del plan productivo';
                }

                if (odds === null || odds < 1.6) {
                    return 'Cuota menor a 1.60';
                }

                return null;
            };

            const buildProductionPlans = (items, planMap = productionPlansById) => {
                planMap.clear();
                const eligibleByMatch = new Map();

                items.forEach(item => {
                    const id = String(getValue(item, 'AutomatedCornerBetSelectionId'));
                    const reason = monitoringReason(item);
                    planMap.set(id, {
                        key: 'monitor',
                        stakeUnits: 0,
                        label: 'Monitoreo',
                        reason: reason ?? 'Otra señal fue priorizada para este partido',
                        rowClass: 'bot-production-monitor'
                    });

                    if (reason !== null) {
                        return;
                    }

                    const key = productionMatchKey(item);
                    if (!eligibleByMatch.has(key)) {
                        eligibleByMatch.set(key, []);
                    }
                    eligibleByMatch.get(key).push(item);
                });

                const botPriority = item => {
                    const botKey = getBotInfo(item).key;
                    return botKey === 'A' ? 4 : botKey === 'C' ? 3 : botKey === 'B' ? 2 : 1;
                };
                const marketPriority = item =>
                    getValue(item, 'MarketType') === 'HomeTeamCorners' ? 2 : 1;

                eligibleByMatch.forEach(candidates => {
                    candidates.sort((left, right) =>
                        marketPriority(right) - marketPriority(left) ||
                        (number(getValue(right, 'SelectionScore')) ?? 0) -
                            (number(getValue(left, 'SelectionScore')) ?? 0) ||
                        (number(getValue(right, 'Odds')) ?? 0) -
                            (number(getValue(left, 'Odds')) ?? 0) ||
                        botPriority(right) - botPriority(left));

                    const selected = candidates[0];
                    const selectedId = String(getValue(selected, 'AutomatedCornerBetSelectionId'));
                    const isHomeMarket = getValue(selected, 'MarketType') === 'HomeTeamCorners';
                    const primaryStakeUnits = marketFamily === 'corners' ? (isHomeMarket ? 1 : 0.5) : 1;
                    const selectedSource = String(getValue(selected, 'Source') ?? '').trim() || 'Casa';
                    const selectedSignalKey = productionSignalKey(selected);
                    const consensusBots = [...new Set(
                        candidates
                            .filter(item => productionSignalKey(item) === selectedSignalKey)
                            .map(item => getBotInfo(item).key)
                            .filter(key => key !== 'Legacy'))]
                        .sort();
                    const consensusText = consensusBots.length > 1
                        ? ` Consenso ${consensusBots.join('+')}.`
                        : '';

                    planMap.set(selectedId, {
                        key: primaryStakeUnits === 1 ? 'stake-1' : 'stake-half',
                        stakeUnits: primaryStakeUnits,
                        label: primaryStakeUnits === 1 ? 'Apostar 1u' : 'Apostar 0.5u',
                        reason: `${selectedSource} ${marketLabel(getValue(selected, 'MarketType')).toLowerCase()}.${consensusText}`,
                        rowClass: primaryStakeUnits === 1
                            ? 'bot-production-primary'
                            : 'bot-production-secondary'
                    });

                    candidates.slice(1).forEach(item => {
                        const id = String(getValue(item, 'AutomatedCornerBetSelectionId'));
                        const isDuplicate = productionSignalKey(item) === selectedSignalKey;
                        planMap.set(id, {
                            key: 'monitor',
                            stakeUnits: 0,
                            label: 'Monitoreo',
                            reason: isDuplicate
                                ? `Duplicado de la señal seleccionada (${getBotInfo(selected).label})`
                                : `Otra señal fue priorizada: ${marketLabel(getValue(selected, 'MarketType'))}`,
                            rowClass: 'bot-production-monitor'
                        });
                    });
                });
            };

            const getProductionPlan = item =>
                productionPlansById.get(String(getValue(item, 'AutomatedCornerBetSelectionId'))) ?? {
                    key: 'monitor',
                    stakeUnits: 0,
                    label: 'Monitoreo',
                    reason: 'Sin clasificación productiva',
                    rowClass: 'bot-production-monitor'
                };

            const getSummaryProductionPlan = item =>
                summaryProductionPlansById.get(String(getValue(item, 'AutomatedCornerBetSelectionId'))) ?? {
                    key: 'monitor',
                    stakeUnits: 0,
                    label: 'Monitoreo',
                    reason: 'Sin clasificación productiva para el bot activo',
                    rowClass: 'bot-production-monitor'
                };

            const updateProductionPlanSummary = items => {
                const pendingItems = items.filter(item =>
                    String(getValue(item, 'Status') ?? '').toLowerCase() === 'pending' &&
                    new Date(getValue(item, 'MatchDate')).getTime() > Date.now());
                const plans = pendingItems.map(getSummaryProductionPlan);
                document.getElementById('BotPicksPlanOneUnit').textContent =
                    plans.filter(plan => plan.key === 'stake-1').length.toString();
                document.getElementById('BotPicksPlanHalfUnit').textContent =
                    plans.filter(plan => plan.key === 'stake-half').length.toString();
                document.getElementById('BotPicksPlanMonitoring').textContent =
                    plans.filter(plan => plan.key === 'monitor').length.toString();
            };

            const ratioValue = value => {
                const parsed = number(value);
                if (parsed === null) {
                    return null;
                }

                return Math.abs(parsed) > 1 ? parsed / 100 : parsed;
            };

            const settledStatus = item =>
                ['won', 'lost', 'push'].includes(String(getValue(item, 'Status') ?? '').toLowerCase());

            const normalizedUnitProfit = item => {
                const status = String(getValue(item, 'Status') ?? '').toLowerCase();
                const odds = number(getValue(item, 'Odds'));
                const storedProfit = number(getValue(item, 'ProfitLoss'));
                const storedStake = number(getValue(item, 'Stake'));
                if (['won', 'lost', 'push'].includes(status) && storedProfit !== null && storedStake !== null && storedStake > 0) {
                    return storedProfit / storedStake;
                }

                if (status === 'won' && odds !== null) {
                    return odds - 1;
                }

                return status === 'lost' ? -1 : 0;
            };

            const performanceOf = items => {
                const settled = items.filter(settledStatus);
                const won = settled.filter(item =>
                    String(getValue(item, 'Status')).toLowerCase() === 'won').length;
                const lost = settled.filter(item =>
                    String(getValue(item, 'Status')).toLowerCase() === 'lost').length;
                const push = settled.length - won - lost;
                const decisive = won + lost;
                const unitProfit = settled.reduce((sum, item) => sum + normalizedUnitProfit(item), 0);
                const actualStake = settled.reduce(
                    (sum, item) => sum + (number(getValue(item, 'Stake')) ?? 0),
                    0);
                const actualProfit = settled.reduce((sum, item) => {
                    const stored = number(getValue(item, 'ProfitLoss'));
                    const stake = number(getValue(item, 'Stake')) ?? 1;
                    return sum + (stored ?? normalizedUnitProfit(item) * stake);
                }, 0);
                const odds = settled
                    .map(item => number(getValue(item, 'Odds')))
                    .filter(value => value !== null);
                const edges = settled
                    .map(item => ratioValue(getValue(item, 'ProbabilityEdge')))
                    .filter(value => value !== null);
                const modelProbabilities = settled
                    .map(item => ratioValue(getValue(item, 'ModelProbability')))
                    .filter(value => value !== null);

                return {
                    items: settled,
                    count: settled.length,
                    won,
                    lost,
                    push,
                    hitRate: decisive > 0 ? won / decisive : null,
                    unitProfit,
                    unitRoi: settled.length > 0 ? unitProfit / settled.length : null,
                    actualStake,
                    actualProfit,
                    actualRoi: actualStake > 0 ? actualProfit / actualStake : null,
                    avgOdds: odds.length > 0 ? odds.reduce((sum, value) => sum + value, 0) / odds.length : null,
                    avgEdge: edges.length > 0 ? edges.reduce((sum, value) => sum + value, 0) / edges.length : null,
                    avgModelProbability: modelProbabilities.length > 0
                        ? modelProbabilities.reduce((sum, value) => sum + value, 0) / modelProbabilities.length
                        : null
                };
            };

            const sampleLabel = count => {
                if (count >= 100) return { label: 'Muestra fuerte', className: 'is-strong' };
                if (count >= 30) return { label: 'Muestra en desarrollo', className: 'is-developing' };
                if (count > 0) return { label: 'Muestra exploratoria', className: 'is-early' };
                return { label: 'Sin muestra', className: '' };
            };

            const dataScienceGroup = (dimension, label, items) => ({
                dimension,
                label,
                performance: performanceOf(items)
            });

            const groupBy = (items, dimension, labelSelector) => {
                const groups = new Map();
                items.forEach(item => {
                    const label = labelSelector(item) || 'Sin dato';
                    if (!groups.has(label)) {
                        groups.set(label, []);
                    }
                    groups.get(label).push(item);
                });

                return Array.from(groups, ([label, groupItems]) =>
                    dataScienceGroup(dimension, label, groupItems));
            };

            const bucketGroups = (items, dimension, buckets, valueSelector) =>
                buckets.map(bucket => dataScienceGroup(
                    dimension,
                    bucket.label,
                    items.filter(item => {
                        const value = valueSelector(item);
                        return value !== null && value >= bucket.min && value < bucket.max;
                    })));

            const renderDataScienceBandRows = (bodyId, groups) => {
                const body = document.getElementById(bodyId);
                body.innerHTML = groups.map(group => {
                    const stats = group.performance;
                    return `
                        <tr>
                            <td class="fw-semibold">${escapeHtml(group.label)}</td>
                            <td class="text-end">${stats.count}</td>
                            <td class="text-end">${stats.hitRate === null ? '-' : escapeHtml(formatPercent(stats.hitRate))}</td>
                            <td class="text-end ${signedClass(stats.unitRoi)}">${stats.unitRoi === null ? '-' : escapeHtml(formatPercent(stats.unitRoi))}</td>
                            <td class="text-end ${signedClass(stats.unitProfit)}">${stats.count === 0 ? '-' : escapeHtml(formatDecimal(stats.unitProfit))}</td>
                        </tr>
                    `;
                }).join('');
            };

            const renderLeaguePerformance = items => {
                leaguePerformanceItems = items;
                const groups = groupBy(items, 'Liga', canonicalLeagueLabel)
                    .filter(group => group.performance.count > 0);
                const reliableGroups = groups.filter(group => group.performance.count >= 10);
                const comparisonGroups = reliableGroups.length > 0 ? reliableGroups : groups;
                const byRoiDescending = [...comparisonGroups].sort((left, right) =>
                    (right.performance.unitRoi ?? Number.NEGATIVE_INFINITY) -
                    (left.performance.unitRoi ?? Number.NEGATIVE_INFINITY) ||
                    right.performance.count - left.performance.count);
                const bestLeague = byRoiDescending[0] ?? null;
                const worstLeague = byRoiDescending.at(-1) ?? null;
                const reliabilityText = reliableGroups.length > 0 ? 'muestra 10+' : 'muestra exploratoria';

                document.getElementById('BotPicksDsLeagueCount').textContent =
                    `${groups.length} ${groups.length === 1 ? 'liga' : 'ligas'}`;
                document.getElementById('BotPicksDsBestLeague').textContent = bestLeague?.label ?? '-';
                document.getElementById('BotPicksDsBestLeagueDetail').textContent = bestLeague
                    ? `${bestLeague.performance.count} apuestas · ROI ${formatPercent(bestLeague.performance.unitRoi)} · ${reliabilityText}`
                    : 'Esperando resultados';
                document.getElementById('BotPicksDsWorstLeague').textContent = worstLeague?.label ?? '-';
                document.getElementById('BotPicksDsWorstLeagueDetail').textContent = worstLeague
                    ? `${worstLeague.performance.count} apuestas · ROI ${formatPercent(worstLeague.performance.unitRoi)} · ${reliabilityText}`
                    : 'Esperando resultados';

                const searchTerm = normalizePlanKey(leaguePerformanceSearch.value);
                const sortMode = leaguePerformanceSort.value;
                const visibleGroups = groups
                    .filter(group => !searchTerm || normalizePlanKey(group.label).includes(searchTerm))
                    .sort((left, right) => {
                        if (sortMode === 'roi-asc') {
                            return (left.performance.unitRoi ?? Number.POSITIVE_INFINITY) -
                                (right.performance.unitRoi ?? Number.POSITIVE_INFINITY) ||
                                right.performance.count - left.performance.count;
                        }
                        if (sortMode === 'profit-desc') {
                            return right.performance.unitProfit - left.performance.unitProfit ||
                                right.performance.count - left.performance.count;
                        }
                        if (sortMode === 'sample-desc') {
                            return right.performance.count - left.performance.count ||
                                (right.performance.unitRoi ?? Number.NEGATIVE_INFINITY) -
                                    (left.performance.unitRoi ?? Number.NEGATIVE_INFINITY);
                        }
                        return (right.performance.unitRoi ?? Number.NEGATIVE_INFINITY) -
                            (left.performance.unitRoi ?? Number.NEGATIVE_INFINITY) ||
                            right.performance.count - left.performance.count;
                    });

                const body = document.getElementById('BotPicksDsLeaguesBody');
                body.innerHTML = visibleGroups.length === 0
                    ? '<tr><td colspan="10" class="text-center text-muted py-4">No hay ligas con resultados para este filtro.</td></tr>'
                    : visibleGroups.map((group, index) => {
                        const stats = group.performance;
                        const reading = stats.count >= 30
                            ? stats.unitRoi > 0 ? 'Señal positiva' : 'Revisar'
                            : stats.count >= 10
                                ? stats.unitRoi > 0 ? 'Tendencia positiva' : 'Tendencia negativa'
                                : 'Exploratoria';
                        const readingClass = stats.count >= 30 && stats.unitRoi > 0
                            ? 'is-ready'
                            : stats.unitRoi < 0 ? 'is-negative' : '';
                        const extremeClass = group === bestLeague
                            ? 'is-best'
                            : group === worstLeague ? 'is-worst' : '';

                        return `
                            <tr class="${extremeClass}">
                                <td class="text-end text-muted">${index + 1}</td>
                                <td class="fw-semibold bot-ds-league-name">${escapeHtml(group.label)}</td>
                                <td class="text-end">${stats.count}</td>
                                <td class="text-end">${stats.won} / ${stats.lost}</td>
                                <td class="text-end">${stats.hitRate === null ? '-' : escapeHtml(formatPercent(stats.hitRate))}</td>
                                <td class="text-end">${escapeHtml(formatCompact(stats.avgOdds))}</td>
                                <td class="text-end">${stats.avgEdge === null ? '-' : escapeHtml(formatPercent(stats.avgEdge))}</td>
                                <td class="text-end ${signedClass(stats.unitProfit)}">${escapeHtml(formatDecimal(stats.unitProfit))}</td>
                                <td class="text-end fw-semibold ${signedClass(stats.unitRoi)}">${stats.unitRoi === null ? '-' : escapeHtml(formatPercent(stats.unitRoi))}</td>
                                <td><span class="bot-ds-reading ${readingClass}">${escapeHtml(reading)}</span></td>
                            </tr>
                        `;
                    }).join('');
            };

            const renderDataScience = items => {
                const summary = performanceOf(items);
                const sample = sampleLabel(summary.count);
                const sampleBadge = document.getElementById('BotPicksDsSampleBadge');
                sampleBadge.textContent = sample.label;
                sampleBadge.className = `bot-ds-sample-badge ${sample.className}`;
                document.getElementById('BotPicksDsScope').textContent =
                    `${summary.count} resueltas de ${items.length} visibles`;
                document.getElementById('BotPicksDsSettled').textContent = summary.count.toString();
                document.getElementById('BotPicksDsRecord').textContent =
                    `${summary.won} W / ${summary.lost} L / ${summary.push} Push`;
                document.getElementById('BotPicksDsHitRate').textContent =
                    summary.hitRate === null ? '-' : formatPercent(summary.hitRate);
                document.getElementById('BotPicksDsBreakeven').textContent =
                    summary.avgOdds === null
                        ? 'Break-even -'
                        : `Break-even ${formatPercent(1 / summary.avgOdds)} a cuota ${formatCompact(summary.avgOdds)}`;

                const roiElement = document.getElementById('BotPicksDsRoi');
                roiElement.textContent = summary.actualRoi === null ? '-' : formatPercent(summary.actualRoi);
                roiElement.className = signedClass(summary.actualRoi);
                document.getElementById('BotPicksDsProfit').textContent =
                    summary.count === 0
                        ? 'P/L -'
                        : `P/L ${formatDecimal(summary.actualProfit)} sobre ${formatDecimal(summary.actualStake)} de stake`;
                document.getElementById('BotPicksDsAvgEdge').textContent =
                    summary.avgEdge === null ? '-' : formatPercent(summary.avgEdge);
                document.getElementById('BotPicksDsCalibration').textContent =
                    summary.avgModelProbability === null || summary.hitRate === null
                        ? 'Prob. modelo vs real -'
                        : `Modelo ${formatPercent(summary.avgModelProbability)} vs real ${formatPercent(summary.hitRate)}`;

                const edgeGroups = bucketGroups(items, 'Edge', [
                    { label: '< 5%', min: Number.NEGATIVE_INFINITY, max: 0.05 },
                    { label: '5% - 8%', min: 0.05, max: 0.08 },
                    { label: '8% - 12%', min: 0.08, max: 0.12 },
                    { label: '12%+', min: 0.12, max: Number.POSITIVE_INFINITY }
                ], item => ratioValue(getValue(item, 'ProbabilityEdge')));
                const oddsGroups = bucketGroups(items, 'Cuota', [
                    { label: '< 1.60', min: Number.NEGATIVE_INFINITY, max: 1.6 },
                    { label: '1.60 - 1.79', min: 1.6, max: 1.8 },
                    { label: '1.80 - 1.99', min: 1.8, max: 2 },
                    { label: '2.00+', min: 2, max: Number.POSITIVE_INFINITY }
                ], item => number(getValue(item, 'Odds')));

                renderDataScienceBandRows('BotPicksDsEdgeBody', edgeGroups);
                renderDataScienceBandRows('BotPicksDsOddsBody', oddsGroups);
                renderLeaguePerformance(items);

                const segmentGroups = [
                    ...groupBy(items, 'Bot', item => getBotInfo(item).label),
                    ...groupBy(items, 'Plan', item => getProductionPlan(item).label),
                    ...groupBy(items, 'Mercado', item => marketLabel(getValue(item, 'MarketType'))),
                    ...groupBy(items, 'Casa', item => getValue(item, 'Source') || 'Sin casa')
                ]
                    .filter(group => group.performance.count > 0)
                    .sort((left, right) =>
                        (right.performance.unitRoi ?? Number.NEGATIVE_INFINITY) -
                        (left.performance.unitRoi ?? Number.NEGATIVE_INFINITY) ||
                        right.performance.count - left.performance.count);
                const displayGroups = segmentGroups.slice(0, 12);
                document.getElementById('BotPicksDsSegmentCount').textContent =
                    `${segmentGroups.length} segmentos`;
                document.getElementById('BotPicksDsSegmentsBody').innerHTML =
                    displayGroups.length === 0
                        ? '<tr><td colspan="9" class="text-center text-muted py-4">Aun no hay resultados para analizar.</td></tr>'
                        : displayGroups.map(group => {
                            const stats = group.performance;
                            const reading = stats.count >= 30
                                ? stats.unitRoi > 0 ? 'Senal positiva' : 'Revisar'
                                : stats.count >= 10
                                    ? 'Tendencia inicial'
                                    : 'Muestra pequena';
                            return `
                                <tr>
                                    <td><span class="bot-ds-dimension">${escapeHtml(group.dimension)}</span></td>
                                    <td class="fw-semibold">${escapeHtml(group.label)}</td>
                                    <td class="text-end">${stats.count}</td>
                                    <td class="text-end">${stats.won} / ${stats.lost}</td>
                                    <td class="text-end">${escapeHtml(formatCompact(stats.avgOdds))}</td>
                                    <td class="text-end">${stats.avgEdge === null ? '-' : escapeHtml(formatPercent(stats.avgEdge))}</td>
                                    <td class="text-end">${stats.hitRate === null ? '-' : escapeHtml(formatPercent(stats.hitRate))}</td>
                                    <td class="text-end ${signedClass(stats.unitRoi)}">${stats.unitRoi === null ? '-' : escapeHtml(formatPercent(stats.unitRoi))}</td>
                                    <td><span class="bot-ds-reading ${stats.count >= 30 ? 'is-ready' : ''}">${escapeHtml(reading)}</span></td>
                                </tr>
                            `;
                        }).join('');

                const reliableGroups = segmentGroups.filter(group => group.performance.count >= 10);
                const bestGroup = reliableGroups[0] ?? segmentGroups[0] ?? null;
                document.getElementById('BotPicksDsBestSegment').textContent =
                    bestGroup?.label ?? '-';
                document.getElementById('BotPicksDsBestSegmentDetail').textContent = bestGroup
                    ? `${bestGroup.dimension} · ${bestGroup.performance.count} apuestas · ROI 1u ${formatPercent(bestGroup.performance.unitRoi)}`
                    : 'Esperando resultados';

                const populatedEdgeGroups = edgeGroups.filter(group => group.performance.count >= 5);
                const edgeIsMonotonic = populatedEdgeGroups.length >= 2 &&
                    populatedEdgeGroups.every((group, index) =>
                        index === 0 ||
                        (group.performance.unitRoi ?? Number.NEGATIVE_INFINITY) >=
                        (populatedEdgeGroups[index - 1].performance.unitRoi ?? Number.NEGATIVE_INFINITY));
                const insight = document.getElementById('BotPicksDsInsight');
                if (summary.count === 0) {
                    insight.textContent = 'Liquida apuestas para comenzar a detectar patrones.';
                } else if (summary.count < 10) {
                    insight.textContent = `Hay ${summary.count} resultados: todavia es pronto para cambiar la estrategia. Prioriza completar la muestra.`;
                } else if (edgeIsMonotonic) {
                    insight.textContent = `El retorno mejora al subir el edge en las bandas con al menos 5 apuestas. Es una señal favorable, aun sujeta al tamaño de muestra.`;
                } else if (bestGroup) {
                    insight.textContent = `${bestGroup.label} lidera entre los segmentos observados, pero un edge mayor aun no muestra una mejora consistente en todas las bandas.`;
                } else {
                    insight.textContent = 'La muestra ya permite comparar segmentos, pero todavia no aparece un patron dominante.';
                }
            };

            const formatRecommendation = item => {
                const marketType = getValue(item, 'MarketType');
                const side = getValue(item, 'SelectedSide') ?? '-';
                const line = formatCompact(getValue(item, 'LineValue'));

                if (marketType === 'HomeTeamCorners') {
                    return `${getHomeTeam(item)} ${side} ${line} corners`;
                }

                if (marketType === 'AwayTeamCorners') {
                    return `${getAwayTeam(item)} ${side} ${line} corners`;
                }

                if (marketType === 'HomeTeamGoals') {
                    return `${getHomeTeam(item)} ${side} ${line} goles`;
                }

                if (marketType === 'AwayTeamGoals') {
                    return `${getAwayTeam(item)} ${side} ${line} goles`;
                }

                if (marketType === 'TotalGoals') {
                    return `${side} ${line} goles totales`;
                }

                if (marketType === 'HomeTeamShots') {
                    return `${getHomeTeam(item)} ${side} ${line} tiros`;
                }

                if (marketType === 'AwayTeamShots') {
                    return `${getAwayTeam(item)} ${side} ${line} tiros`;
                }

                if (marketType === 'TotalShots') {
                    return `${side} ${line} tiros totales`;
                }

                if (marketType === 'HomeTeamShotsOnGoal') {
                    return `${getHomeTeam(item)} ${side} ${line} tiros al arco`;
                }

                if (marketType === 'AwayTeamShotsOnGoal') {
                    return `${getAwayTeam(item)} ${side} ${line} tiros al arco`;
                }

                if (marketType === 'TotalShotsOnGoal') {
                    return `${side} ${line} tiros al arco totales`;
                }

                return `${side} ${line} corners totales`;
            };

            const toBettingMarketType = marketType => {
                const normalized = String(marketType ?? '');
                if (normalized === 'HomeTeamCorners') return 'HomeCorners';
                if (normalized === 'AwayTeamCorners') return 'AwayCorners';
                if (normalized === 'HomeTeamGoals') return 'HomeGoals';
                if (normalized === 'AwayTeamGoals') return 'AwayGoals';
                if (normalized === 'TotalGoals') return 'TotalGoals';
                if (normalized === 'HomeTeamShots') return 'HomeShots';
                if (normalized === 'AwayTeamShots') return 'AwayShots';
                if (normalized === 'TotalShots') return 'TotalShots';
                if (normalized === 'HomeTeamShotsOnGoal') return 'HomeShotsOnGoal';
                if (normalized === 'AwayTeamShotsOnGoal') return 'AwayShotsOnGoal';
                if (normalized === 'TotalShotsOnGoal') return 'TotalShotsOnGoal';
                return 'TotalCorners';
            };

            const toBettingConfidence = confidence => {
                const normalized = String(confidence ?? '').trim().toLowerCase().replaceAll('_', ' ');
                if (normalized === 'very high') return 'VeryHigh';
                if (normalized === 'high') return 'High';
                if (normalized === 'low') return 'Low';
                return 'Medium';
            };

            const toDateInputValue = value => {
                if (!value) {
                    return '';
                }

                const raw = String(value);
                if (/^\d{4}-\d{2}-\d{2}/.test(raw)) {
                    return raw.slice(0, 10);
                }

                const date = new Date(raw);
                return Number.isNaN(date.getTime()) ? '' : date.toISOString().slice(0, 10);
            };

            const buildBettingNotes = (item, stakeStrategy, stakeUnits) => {
                const botInfo = getBotInfo(item);
                const parts = [
                    `${botInfo.label} recommendation: ${formatRecommendation(item)}`,
                    `Stake strategy: ${stakeStrategy}`,
                    `Production plan: ${formatCompact(stakeUnits)}u flat`,
                    `AutomationVersion: ${getValue(item, 'AutomationVersion') || 'Legacy'}`,
                    `SelectionId: ${getValue(item, 'AutomatedCornerBetSelectionId')}`,
                    `RunId: ${getValue(item, 'RunId') || '-'}`,
                    `Edge: ${formatPercent(getValue(item, 'ProbabilityEdge'))}`,
                    `EV: ${formatPercent(getValue(item, 'ExpectedValue'))}`,
                    `Score: ${formatCompact(getValue(item, 'SelectionScore'))}`
                ];

                const sourceUrl = getValue(item, 'SourceUrl');
                if (sourceUrl) {
                    parts.push(`Source: ${sourceUrl}`);
                }

                return parts.join('\n');
            };

            const buildBettingCreateUrl = (item, stakeStrategy, stakeUnits = 1) => {
                const matchDate = toDateInputValue(getValue(item, 'MatchDate'));
                const normalizedStrategy = stakeStrategy === 'Kelly'
                    ? 'Kelly'
                    : stakeStrategy === 'QuarterKelly'
                        ? 'QuarterKelly'
                        : 'None';
                const parameters = new URLSearchParams({
                    currencyCode: betCurrencySelect.value,
                    league: getLeague(item),
                    season: getValue(item, 'Season') || (matchDate ? matchDate.slice(0, 4) : new Date().getFullYear().toString()),
                    matchDate,
                    homeTeam: getHomeTeam(item),
                    awayTeam: getAwayTeam(item),
                    marketType: toBettingMarketType(getValue(item, 'MarketType')),
                    betSelection: getValue(item, 'SelectedSide') || 'Over',
                    bookmaker: getValue(item, 'Source') || '',
                    kellyStrategy: normalizedStrategy,
                    confidenceLevel: toBettingConfidence(getValue(item, 'ConfidenceLevel')),
                    predictionModel: ['C', 'D', 'E', 'F'].includes(getBotInfo(item).key)
                        ? `AutomatedBot${getBotInfo(item).key}`
                        : marketFamily === 'goals'
                            ? 'AutomatedGoalsBot'
                            : marketFamily === 'shots'
                                ? 'AutomatedShotsBot'
                                : marketFamily === 'sog'
                                    ? 'AutomatedSogBot'
                                    : 'AutomatedCornersBot',
                    notes: buildBettingNotes(
                        item,
                        normalizedStrategy === 'None' ? 'Flat' : normalizedStrategy,
                        stakeUnits)
                });
                const numericParameters = {
                    line: formatQueryNumber(getValue(item, 'LineValue'), 2),
                    odds: formatQueryNumber(getValue(item, 'Odds'), 2)
                };
                if (normalizedStrategy === 'None') {
                    const baseStake = number(flatBetStakeInput.value) ?? 0;
                    const plannedStake = baseStake * stakeUnits;
                    numericParameters.stake = formatQueryNumber(
                        betCurrencySelect.value === 'CLP' ? Math.round(plannedStake) : plannedStake,
                        2);
                }
                Object.entries(numericParameters).forEach(([key, value]) => {
                    if (value !== null) {
                        parameters.set(key, value);
                    }
                });

                const modelProbability = number(getValue(item, 'ModelProbability'));
                if (normalizedStrategy !== 'None' && modelProbability !== null) {
                    parameters.set(
                        'estimatedProbabilityPercent',
                        (Math.abs(modelProbability) <= 1 ? modelProbability * 100 : modelProbability).toFixed(2));
                }

                return `/Betting/Create?${parameters.toString()}`;
            };

            const monthKeyFromDate = date =>
                `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;

            const parseMonthKey = value => {
                const match = /^(\d{4})-(\d{2})$/.exec(String(value ?? ''));
                return match
                    ? new Date(Number(match[1]), Number(match[2]) - 1, 1)
                    : new Date(new Date().getFullYear(), new Date().getMonth(), 1);
            };

            const setMonthRange = (monthDate, submit = true) => {
                const today = new Date();
                const monthStart = new Date(monthDate.getFullYear(), monthDate.getMonth(), 1);
                const currentMonthStart = new Date(today.getFullYear(), today.getMonth(), 1);
                if (monthStart > currentMonthStart) {
                    return;
                }

                const monthEnd = new Date(monthStart.getFullYear(), monthStart.getMonth() + 1, 0);
                const formatDateInput = date =>
                    `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;

                monthInput.value = monthKeyFromDate(monthStart);
                dateFromInput.value = formatDateInput(monthStart);
                dateToInput.value = formatDateInput(monthEnd);
                nextMonthButton.disabled = monthStart.getTime() === currentMonthStart.getTime();

                if (submit) {
                    filtersForm.requestSubmit();
                }
            };

            const buildQuery = () => {
                const query = new URLSearchParams();
                query.set('marketFamily', marketFamily);
                if (dateFromInput.value) query.set('dateFrom', dateFromInput.value);
                if (dateToInput.value) query.set('dateTo', dateToInput.value);
                if (statusSelect.value) query.set('status', statusSelect.value);
                if (bookmakerSelect.value) query.set('bookmaker', bookmakerSelect.value);
                if (marketTypeSelect.value) query.set('marketType', marketTypeSelect.value);
                if (leagueInput.value.trim()) query.set('league', leagueInput.value.trim());
                const serialized = query.toString();
                return serialized ? `?${serialized}` : '';
            };

            const botTabLabel = botKey => {
                if (botKey === 'A') return 'Bot A Actual';
                if (botKey === 'B') return 'Bot B Conservador';
                if (botKey === 'C') return 'Bot C · Modelos 2026';
                if (botKey === 'D') return 'Bot D · Brecha de nivel';
                if (botKey === 'E') return 'Bot E · Calibración empírica';
                if (botKey === 'F') return 'Bot F · Legacy ML calibrado';
                if (botKey === 'Legacy') return 'Otros / Legacy';
                return 'Todos los bots';
            };

            const botContextCopy = botKey => {
                if (botKey === 'D') {
                    return marketFamily === 'goals'
                        ? {
                            title: 'Brecha de nivel · hipótesis útil en goles por equipo',
                            text: 'El gap no cambia directamente el número predicho por el ML: ajusta la probabilidad final según la diferencia de nivel. Tiene más sentido en goles del local o visitante que en goles totales; todavía es experimental.'
                        }
                        : {
                            title: 'Brecha de nivel · señal contextual experimental',
                            text: 'La diferencia de nivel puede describir dominio, pero no garantiza más córners o tiros. El Bot D ajusta la probabilidad final y debe validarse por mercado, selección y lado.'
                        };
                }

                if (botKey === 'E') {
                    return {
                        title: 'Calibración empírica · aprende por mercado',
                        text: marketFamily === 'goals'
                            ? 'No pertenece exclusivamente a goles, pero hoy es el mercado con mayor evidencia útil. Separa goles totales, local y visita; la muestra todavía debe tratarse como exploratoria.'
                            : 'Es agnóstica al mercado, pero nunca traslada automáticamente lo aprendido en goles. Si faltan resultados comparables para este mercado, reduce la confianza o no publica el pick.'
                    };
                }

                if (botKey === 'F') {
                    return {
                        title: 'Legacy ML + calibración empírica',
                        text: 'Usa como señal base los modelos anteriores de córners, goles, tiros y tiros al arco. Después aplica el mismo aprendizaje walk-forward de resultados asiáticos de Bot E, aislado en su propia evidencia F.'
                    };
                }

                if (botKey === 'C') {
                    return {
                        title: 'Selector base · ML, edge y contexto',
                        text: 'Combina la predicción del modelo con historial, calidad y contexto. Es la referencia para medir si los experimentos D y E realmente agregan valor.'
                    };
                }

                if (botKey === 'A') {
                    return { title: 'Bot A · estrategia actual', text: 'Sirve como línea base histórica. Sus estadísticas se mantienen separadas para no mezclar resultados con los modelos experimentales.' };
                }

                if (botKey === 'B') {
                    return { title: 'Bot B · variante conservadora', text: 'Aplica criterios más restrictivos. Compáralo con A usando muestra resuelta, retorno y yield, no solo porcentaje de acierto.' };
                }

                if (botKey === 'Legacy') {
                    return { title: 'Bots personalizados o históricos', text: 'Agrupa versiones que no corresponden a A–E. Úsalo para auditoría; no mezcles su rendimiento con un experimento activo.' };
                }

                return { title: 'Comparación general', text: 'Las tarjetas comparan bots, pero el resumen financiero necesita un bot activo para evitar mezclar estrategias experimentales.' };
            };

            const matchesSearch = item => {
                const search = searchInput.value.trim().toLowerCase();
                if (!search) {
                    return true;
                }

                return [
                    getLeague(item),
                    getValue(item, 'League'),
                    getHomeTeam(item),
                    getAwayTeam(item),
                    getValue(item, 'Source'),
                    getValue(item, 'SourceMatchId')
                ]
                    .filter(Boolean)
                    .some(value => String(value).toLowerCase().includes(search));
            };

            const matchesStrategyPlan = item => {
                const selectedPlan = strategyPlanSelect.value;
                const plan = getProductionPlan(item);
                if (!selectedPlan) {
                    return true;
                }

                if (selectedPlan === 'bet') {
                    return plan.stakeUnits > 0;
                }

                return plan.key === selectedPlan;
            };

            const getSearchFilteredSelections = () =>
                selections.filter(item => matchesSearch(item) && matchesStrategyPlan(item));

            const updateBotTabs = baseItems => {
                const countByBot = botKey => baseItems.filter(item => getBotInfo(item).key === botKey).length;
                document.getElementById('BotPicksTabAllCount').textContent = `${baseItems.length}`;
                document.getElementById('BotPicksTabACount').textContent = `${countByBot('A')}`;
                document.getElementById('BotPicksTabBCount').textContent = `${countByBot('B')}`;
                document.getElementById('BotPicksTabCCount').textContent = `${countByBot('C')}`;
                document.getElementById('BotPicksTabDCount').textContent = `${countByBot('D')}`;
                document.getElementById('BotPicksTabECount').textContent = `${countByBot('E')}`;
                document.getElementById('BotPicksTabFCount').textContent = `${countByBot('F')}`;
                document.getElementById('BotPicksTabLegacyCount').textContent = `${countByBot('Legacy')}`;

                botTabButtons.forEach(button => {
                    const isActive = button.dataset.botTab === activeBotTab;
                    button.classList.toggle('is-active', isActive);
                    button.setAttribute('aria-selected', isActive ? 'true' : 'false');
                    button.tabIndex = isActive ? 0 : -1;
                });

                comparisonCards.forEach(card =>
                    card.classList.toggle('is-active', card.dataset.summaryBot === activeBotTab));

                tableTitle.textContent = 'Recomendaciones de todos los bots';

                const hasActiveSummaryBot = activeBotTab !== '';
                productionPlanSection.classList.toggle('d-none', !hasActiveSummaryBot);
                perBotSummarySection.classList.toggle('d-none', !hasActiveSummaryBot);
                selectBotSummaryNotice.classList.toggle('d-none', hasActiveSummaryBot);

                if (hasActiveSummaryBot) {
                    const activeLabel = botTabLabel(activeBotTab);
                    const activeItems = baseItems.filter(item => getBotInfo(item).key === activeBotTab);
                    const activePerformance = performanceOf(activeItems);
                    const sample = sampleLabel(activePerformance.count);
                    const context = botContextCopy(activeBotTab);
                    summaryTitle.textContent = `Resumen del período · ${activeLabel}`;
                    summaryScope.textContent =
                        `Solo incluye ${activeLabel}; respeta las fechas y los demás filtros aplicados.`;
                    bankrollChartTitle.textContent = `Evolución del saldo · ${activeLabel}`;
                    botContextTitle.textContent = context.title;
                    botContextText.textContent = context.text;
                    botContextSample.textContent = `${sample.label} · ${activePerformance.count} resueltas`;
                    botContextSample.className = `bot-ds-sample-badge ${sample.className}`;
                } else {
                    const context = botContextCopy('');
                    botContextTitle.textContent = context.title;
                    botContextText.textContent = context.text;
                    botContextSample.textContent = 'Selecciona un bot';
                    botContextSample.className = 'bot-ds-sample-badge';
                }

                if (settlePendingButton && !settlePendingButton.disabled) {
                    settlePendingButton.textContent = 'Completar faltantes';
                    settlePendingButton.title =
                        'Revisar todos los bots y mercados: MatchHistory primero y API-Football cuando falten datos';
                }
            };

            const setLoading = isLoading => {
                loadingState.classList.toggle('d-none', !isLoading);
                tableWrap.classList.toggle('d-none', isLoading || tableSelections.length === 0);
                emptyState.classList.toggle('d-none', isLoading || tableSelections.length > 0);
                pagination.classList.toggle('d-none', isLoading || tableSelections.length <= pageSize);
                refreshButton.disabled = isLoading;
            };

            const setError = message => {
                errorState.textContent = message ?? '';
                errorState.classList.toggle('d-none', !message);
            };

            const renderBankrollChart = items => {
                const initialBankroll = number(initialBankrollInput.value) ?? 100;
                const settledItems = items
                    .filter(item => ['won', 'lost', 'push'].includes(String(getValue(item, 'Status')).toLowerCase()))
                    .slice()
                    .sort((left, right) => {
                        const leftDate = new Date(getValue(left, 'MatchDate')).getTime();
                        const rightDate = new Date(getValue(right, 'MatchDate')).getTime();
                        if (leftDate !== rightDate) {
                            return leftDate - rightDate;
                        }

                        return Number(getValue(left, 'AutomatedCornerBetSelectionId')) -
                            Number(getValue(right, 'AutomatedCornerBetSelectionId'));
                    });

                const inputDateLabel = value => {
                    if (!value) return '-';
                    const parsed = new Date(`${value}T12:00:00`);
                    return Number.isNaN(parsed.getTime()) ? value : dateOnlyFormatter.format(parsed);
                };
                summaryPeriod.textContent = `${inputDateLabel(dateFromInput.value)} – ${inputDateLabel(dateToInput.value)}`;

                let allBalance = initialBankroll;
                let recommendedBalance = initialBankroll;
                const points = [{ all: allBalance, recommended: recommendedBalance, label: 'Inicio' }];
                settledItems.forEach(item => {
                    allBalance += simulatedProfitLoss(item, 1);
                    recommendedBalance += simulatedProfitLoss(item, getSummaryProductionPlan(item).stakeUnits);
                    points.push({
                        all: allBalance,
                        recommended: recommendedBalance,
                        label: formatDateOnly(getValue(item, 'MatchDate'))
                    });
                });

                chartRecommendedValue.textContent = `${formatDecimal(recommendedBalance)}u`;
                chartAllValue.textContent = `${formatDecimal(allBalance)}u`;
                bankrollChartEmpty.classList.toggle('d-none', settledItems.length > 0);
                bankrollChartWrap.classList.toggle('d-none', settledItems.length === 0);

                if (settledItems.length === 0) {
                    bankrollChart.innerHTML = '';
                    return;
                }

                const width = 1000;
                const height = 320;
                const left = 70;
                const right = 24;
                const top = 24;
                const bottom = 46;
                const plotWidth = width - left - right;
                const plotHeight = height - top - bottom;
                const values = points.flatMap(point => [point.all, point.recommended]);
                const rawMin = Math.min(...values);
                const rawMax = Math.max(...values);
                const padding = Math.max((rawMax - rawMin) * 0.12, 0.75);
                const minValue = rawMin - padding;
                const maxValue = rawMax + padding;
                const valueRange = maxValue - minValue;
                const x = index => left + (index / Math.max(points.length - 1, 1)) * plotWidth;
                const y = value => top + ((maxValue - value) / valueRange) * plotHeight;
                const pathFor = key => points
                    .map((point, index) => `${index === 0 ? 'M' : 'L'} ${x(index).toFixed(2)} ${y(point[key]).toFixed(2)}`)
                    .join(' ');

                const gridLines = Array.from({ length: 5 }, (_, index) => {
                    const ratio = index / 4;
                    const value = maxValue - ratio * valueRange;
                    const rowY = top + ratio * plotHeight;
                    return `
                        <line class="bot-chart-grid-line" x1="${left}" y1="${rowY}" x2="${width - right}" y2="${rowY}"></line>
                        <text class="bot-chart-axis-label" x="${left - 10}" y="${rowY + 4}" text-anchor="end">${escapeHtml(formatCompact(value))}u</text>
                    `;
                }).join('');

                const labelIndexes = Array.from(new Set([0, 0.25, 0.5, 0.75, 1]
                    .map(ratio => Math.round((points.length - 1) * ratio))));
                const xLabels = labelIndexes.map(index => `
                    <text class="bot-chart-axis-label" x="${x(index)}" y="${height - 15}" text-anchor="${index === 0 ? 'start' : index === points.length - 1 ? 'end' : 'middle'}">
                        ${escapeHtml(points[index].label)}
                    </text>
                `).join('');
                const lastIndex = points.length - 1;
                const initialY = y(initialBankroll);

                bankrollChart.innerHTML = `
                    <title>Evolución del saldo desde ${escapeHtml(formatDecimal(initialBankroll))} unidades</title>
                    ${gridLines}
                    <line class="bot-chart-start-line" x1="${left}" y1="${initialY}" x2="${width - right}" y2="${initialY}"></line>
                    <text class="bot-chart-start-label" x="${left + 8}" y="${initialY - 8}">Saldo inicial ${escapeHtml(formatDecimal(initialBankroll))}u</text>
                    <path class="bot-chart-path-all" d="${pathFor('all')}"></path>
                    <path class="bot-chart-path-recommended" d="${pathFor('recommended')}"></path>
                    <circle class="bot-chart-end-all" cx="${x(lastIndex)}" cy="${y(points[lastIndex].all)}" r="5"></circle>
                    <circle class="bot-chart-end-recommended" cx="${x(lastIndex)}" cy="${y(points[lastIndex].recommended)}" r="5"></circle>
                    ${xLabels}
                `;
            };

            const summarize = (items, comparisonItems = items) => {
		                const summarizeBot = botKey => {
                            const botItems = comparisonItems.filter(item => {
                                const botInfo = getBotInfo(item);
                                return botInfo.key === botKey;
                            });
		                    const won = botItems.filter(item => String(getValue(item, 'Status')).toLowerCase() === 'won').length;
		                    const lost = botItems.filter(item => String(getValue(item, 'Status')).toLowerCase() === 'lost').length;
		                    const pending = botItems.filter(item => String(getValue(item, 'Status')).toLowerCase() === 'pending').length;
