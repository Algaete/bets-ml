@model CornersPrediction.Web.Models.BotPicks.BotPicksIndexViewModel

@{
    var language = UiText.GetLanguage(Context);
    ViewData["Title"] = Model.Market.Title;
    var dateFrom = Model.Filters.DateFrom?.ToString("yyyy-MM-dd");
    var dateTo = Model.Filters.DateTo?.ToString("yyyy-MM-dd");
    var selectedMonth = Model.Filters.DateFrom?.ToString("yyyy-MM");
    var selectedStatus = Model.Filters.Status ?? string.Empty;
    var selectedBookmaker = Model.Filters.Bookmaker ?? string.Empty;
    var selectedMarketType = Model.Filters.MarketType ?? string.Empty;
    var canUpdateResults = User.IsInRole("Admin");
    var marketFamily = Model.Market.Key;
    var isCornersMarket = marketFamily == "corners";
    var historicalPlanLabel = marketFamily switch
    {
        "corners" => "CORNERS V1",
        "goals" => "GOALS V1",
        _ => null
    };
}

<div class="betting-hero bot-picks-hero mb-3">
    <div>
        <div class="text-muted small text-uppercase fw-semibold">@Model.Market.Eyebrow</div>
        <h1 class="h3 mb-1">@Model.Market.Title</h1>
        <p class="text-muted mb-0">@Model.Market.Description</p>
    </div>
    <div class="bot-picks-hero-actions">
        <div class="bot-picks-bankroll-settings" aria-label="Configuración de simulación">
        <label class="bot-picks-bankroll-control">
            <span>Bankroll inicial (u)</span>
            <input id="BotPicksInitialBankroll" class="form-control form-control-sm" type="number" min="0" step="0.01" value="100" />
        </label>
        <label class="bot-picks-bankroll-control">
            <span>Moneda apuesta</span>
            <select id="BotPicksBetCurrency" class="form-select form-select-sm">
                <option value="CLP">CLP</option>
                <option value="USD">USD</option>
                <option value="AUD">AUD</option>
            </select>
        </label>
        <label class="bot-picks-bankroll-control">
            <span>Stake plano</span>
            <input id="BotPicksFlatBetStake" class="form-control form-control-sm" type="number" min="0.01" step="1" value="1" />
        </label>
        </div>
        @if (canUpdateResults)
        {
            <div class="bot-picks-bulk-actions" aria-label="Liquidación automática">
                <button id="SettleLocalBotPicksButton" class="btn btn-primary" type="button"
                        title="Liquida todos los bots y mercados usando únicamente MatchHistory">
                    Liquidar desde MatchHistory
                </button>
                <button id="SettlePendingBotPicksButton" class="btn btn-outline-success" type="button"
                        title="Para los pendientes: busca el partido en API-Football, sincroniza MatchHistory y vuelve a liquidar">
                    Completar faltantes
                </button>
            </div>
        }
        <button id="RefreshBotPicksButton" class="btn btn-outline-secondary" type="button">Actualizar</button>
    </div>
</div>

<div class="bot-picks-command-bar mb-4">
    <nav class="bot-market-switcher" aria-label="Mercado de Bot Picks">
        @foreach (var marketLink in new[]
        {
            (Key: "corners", Label: "Córners"),
            (Key: "goals", Label: "Goles"),
            (Key: "shots", Label: "Tiros"),
            (Key: "sog", Label: "Tiros al arco")
        })
        {
            <a class="bot-market-switcher-link @(marketFamily == marketLink.Key ? "is-active" : "")"
               aria-current="@(marketFamily == marketLink.Key ? "page" : null)"
               asp-controller="BotPicks"
               asp-action="Index"
               asp-route-market="@marketLink.Key"
               asp-route-DateFrom="@dateFrom"
               asp-route-DateTo="@dateTo"
               asp-route-Status="@selectedStatus"
               asp-route-League="@Model.Filters.League"
               asp-route-Bookmaker="@selectedBookmaker">@marketLink.Label</a>
        }
    </nav>
    <nav class="bot-picks-section-nav" aria-label="Secciones de Bot Picks">
        <a href="#BotPicksSummary">Resumen</a>
        <a href="#BotPicksRecommendations">Recomendaciones</a>
        <a href="#BotPicksDataScience">Laboratorio</a>
    </nav>
</div>

<div id="BotPicksError" class="alert alert-danger d-none" role="alert"></div>
<div id="BotPicksSettlementResult" class="alert alert-success d-none" role="status"></div>

@if (marketFamily == "goals")
{
    <div class="alert alert-info bot-picks-settlement-help" role="note">
        <strong>Liquidación asiática:</strong> escribe el dato que indica cada fila: goles del local,
        goles de la visita o goles totales. Ingresa un solo entero —por ejemplo, en Arsenal 3–0,
        un pick “Goles visita” se liquida con <strong>0</strong>— y pulsa <strong>Liquidar</strong>.
        El sistema calcula automáticamente ganancia completa, media ganancia, devolución, media pérdida o pérdida completa.
        Ejemplo: Under 2,25 con 2 goles = media ganancia; Over 2,25 con 2 goles = media pérdida.
    </div>
}

<div class="bot-picks-tabs-heading">
    <div>
        <h2 class="h6 mb-1">Alcance del resumen · @Model.Market.Title</h2>
        <p class="text-muted small mb-0">Plan global muestra la cartera canónica entre todos los bots. Elige un bot para aislar su aporte sin mezclar mercados.</p>
    </div>
</div>
<section class="bot-picks-tabs mb-3" role="tablist" aria-label="Bot activo para el resumen">
    <button class="bot-picks-tab" type="button" role="tab" data-bot-tab="" aria-selected="false">
        <span class="bot-picks-tab-label">Plan global · todos</span>
        <span id="BotPicksTabAllCount" class="bot-picks-tab-count">...</span>
    </button>
    <button class="bot-picks-tab bot-picks-tab-a" type="button" role="tab" data-bot-tab="A" aria-selected="false">
        <span class="bot-picks-tab-label">Bot A Actual</span>
        <span id="BotPicksTabACount" class="bot-picks-tab-count">...</span>
    </button>
    <button class="bot-picks-tab bot-picks-tab-c" type="button" role="tab" data-bot-tab="C" aria-selected="false">
        <span class="bot-picks-tab-label">Bot C · Modelos 2026</span>
        <span id="BotPicksTabCCount" class="bot-picks-tab-count">...</span>
    </button>
    <button class="bot-picks-tab bot-picks-tab-d" type="button" role="tab" data-bot-tab="D" aria-selected="false">
        <span class="bot-picks-tab-label">Bot D · Brecha de nivel</span>
        <span id="BotPicksTabDCount" class="bot-picks-tab-count">...</span>
    </button>
    <button class="bot-picks-tab bot-picks-tab-e" type="button" role="tab" data-bot-tab="E" aria-selected="false">
        <span class="bot-picks-tab-label">Bot E · Calibración empírica</span>
        <span id="BotPicksTabECount" class="bot-picks-tab-count">...</span>
    </button>
    <button class="bot-picks-tab bot-picks-tab-f" type="button" role="tab" data-bot-tab="F" aria-selected="false">
        <span class="bot-picks-tab-label">Bot F · Legacy calibrado</span>
        <span id="BotPicksTabFCount" class="bot-picks-tab-count">...</span>
    </button>
    <button id="BotPicksLegacyTab" class="bot-picks-tab bot-picks-tab-legacy d-none" type="button" role="tab" data-bot-tab="Legacy" aria-selected="false">
        <span class="bot-picks-tab-label">Bots personalizados</span>
        <span id="BotPicksTabLegacyCount" class="bot-picks-tab-count">...</span>
    </button>
</section>

<div id="BotPicksSelectBotSummary" class="alert alert-info d-none mb-4" role="note">
    El plan global consolida todos los bots activos y conserva una sola apuesta productiva por partido.
</div>

<aside id="BotPicksBotContext" class="bot-picks-context-card mb-4" aria-live="polite">
    <div>
        <span class="bot-picks-context-eyebrow">Cómo leer el bot activo</span>
        <strong id="BotPicksBotContextTitle">...</strong>
        <p id="BotPicksBotContextText" class="mb-0">...</p>
    </div>
    <span id="BotPicksBotContextSample" class="bot-ds-sample-badge">Sin muestra</span>
</aside>

<section id="BotPicksProductionPlan" class="bot-production-plan mb-4" aria-label="Plan productivo del bot activo">
    <div class="bot-production-plan-copy">
        <div class="text-uppercase fw-semibold">Plan productivo controlado</div>
        <h2>Máximo una apuesta principal por partido</h2>
        @if (isCornersMarket)
        {
            <p>Para partidos futuros rige el gate actual. El gráfico reconstruye por separado CORNERS V1 con la regla que estaba vigente antes del cambio: una señal por partido, córners local a 1u o visita a 0.5u. Es una simulación histórica, no una apuesta confirmada.</p>
        }
        else if (Model.Market.Key == "goals")
        {
            <p>Para partidos futuros, sólo goles de equipo con gate vigente: Green usa 1u y una prueba controlada exacta puede usar 0.5u. El resultado anterior se conserva aparte como simulación histórica GOALS V1 a 1u; el cambio de hoy no reescala el pasado.</p>
        }
        else
        {
            <p>Mercado en monitoreo: todavía no existe una muestra resuelta suficiente para recomendar apuestas productivas. El gráfico seguirá mostrando todos los picks a 1u, pero no inventará una cartera recomendada.</p>
        }
    </div>
    <div class="bot-production-plan-stats">
        <div class="bot-production-stat bot-production-stat-primary">
            <span>Para apostar 1u</span>
            <strong id="BotPicksPlanOneUnit">...</strong>
        </div>
        <div class="bot-production-stat bot-production-stat-secondary">
            <span>Para apostar 0.5u</span>
            <strong id="BotPicksPlanHalfUnit">...</strong>
        </div>
        <div class="bot-production-stat bot-production-stat-monitor">
            <span>Monitoreo pendiente</span>
            <strong id="BotPicksPlanMonitoring">...</strong>
        </div>
    </div>
</section>

<div id="BotPicksSummary" class="bot-picks-anchor"></div>
<div id="BotPicksPerBotSummary">
<div class="bot-summary-heading mb-3">
    <div>
        <h2 id="BotPicksSummaryTitle" class="h6 mb-1">Resumen del período por bot</h2>
        <div id="BotPicksSummaryScope" class="text-muted small">Todos los indicadores respetan el bot activo, las fechas y los filtros aplicados.</div>
    </div>
    <div class="d-flex flex-wrap justify-content-end gap-2">
        <span id="BotPicksSummarySample" class="bot-ds-sample-badge">Sin muestra</span>
        <span id="BotPicksSummaryPeriod" class="bot-period-badge">...</span>
    </div>
</div>

<section class="metric-grid bot-picks-metric-grid mb-4" aria-label="Resumen estadístico de Bot Picks">
    <div class="metric-tile bot-metric-total">
        <div id="BotPicksTotalLabel" class="metric-label">Señales de todos los bots</div>
        <div id="BotPicksTotal" class="metric-value">...</div>
    </div>
    <div class="metric-tile bot-metric-pending">
        <div class="metric-label">Pendientes</div>
        <div id="BotPicksPending" class="metric-value">...</div>
    </div>
    <div class="metric-tile bot-metric-won">
        <div class="metric-label">Ganadas</div>
        <div id="BotPicksWon" class="metric-value">...</div>
    </div>
    <div class="metric-tile bot-metric-lost">
        <div class="metric-label">Perdidas</div>
        <div id="BotPicksLost" class="metric-value">...</div>
    </div>
    <div class="metric-tile">
        <div class="metric-label">Push / Void</div>
        <div id="BotPicksVoid" class="metric-value">...</div>
    </div>
    <div class="metric-tile">
        <div class="metric-label">Resultado del período · todos a 1u</div>
        <div id="BotPicksProfitLoss" class="metric-value">...</div>
        <div id="BotPicksProfitLossHelp" class="metric-footnote">Sólo picks ganados y perdidos</div>
    </div>
    <div class="metric-tile">
        <div class="metric-label">Yield del período · todos a 1u</div>
        <div id="BotPicksYieldPct" class="metric-value">...</div>
        <div id="BotPicksYieldHelp" class="metric-footnote">Resultado ÷ unidades apostadas</div>
    </div>
    <div class="metric-tile">
        <div class="metric-label">@(historicalPlanLabel is null ? "ROI del plan productivo" : $"ROI histórico · simulación {historicalPlanLabel}")</div>
        <div id="BotPicksRecommendedYieldPct" class="metric-value">...</div>
        <div id="BotPicksRecommendedYieldHelp" class="metric-footnote">@(historicalPlanLabel is null ? "Sólo apuestas canónicas del backend" : "Regla histórica congelada; no es el gate actual")</div>
    </div>
    <div class="metric-tile">
        <div class="metric-label">@(historicalPlanLabel is null ? "Saldo siguiendo el plan recomendado" : $"Saldo de la simulación histórica {historicalPlanLabel}")</div>
        <div id="BotPicksRecommendedBankroll" class="metric-value">...</div>
        <div id="BotPicksRecommendedUnits" class="metric-footnote">Saldo inicial + resultado del plan</div>
    </div>
    <div class="metric-tile">
        <div class="metric-label">Saldo apostando todos los picks</div>
        <div id="BotPicksBankroll" class="metric-value">...</div>
        <div id="BotPicksAllUnits" class="metric-footnote">Saldo inicial + resultado apostando 1u en cada pick</div>
    </div>
</section>

<section class="surface-panel bot-bankroll-chart-panel mb-4" aria-labelledby="BotPicksBankrollChartTitle">
    <div class="bot-bankroll-chart-heading">
        <div>
            <h2 id="BotPicksBankrollChartTitle" class="h6 mb-1">Evolución del saldo</h2>
            <div class="text-muted small">Cada punto agrega un pick resuelto del período, ordenado por fecha. Los pendientes no cambian el saldo.</div>
        </div>
        <div class="bot-bankroll-chart-values" aria-label="Saldos finales del gráfico">
            <span><i class="bot-chart-dot bot-chart-dot-recommended"></i>@(historicalPlanLabel is null ? "Plan recomendado" : $"Histórico {historicalPlanLabel}") <strong id="BotPicksChartRecommendedValue">...</strong></span>
            <span><i class="bot-chart-dot bot-chart-dot-all"></i>Todos a 1u <strong id="BotPicksChartAllValue">...</strong></span>
        </div>
    </div>
    <div id="BotPicksBankrollPlanEmpty" class="alert alert-warning d-none mb-3" role="note"></div>
    <div id="BotPicksBankrollChartEmpty" class="alert alert-light border d-none mb-0">Aún no hay picks resueltos para graficar en este período.</div>
    <div id="BotPicksBankrollChartWrap" class="bot-bankroll-chart-wrap">
        <svg id="BotPicksBankrollChart" viewBox="0 0 1000 320" role="img" aria-label="Gráfico de evolución del saldo"></svg>
    </div>
</section>
</div>

<section class="bot-comparison-grid mb-4" aria-label="Comparación por bot del período">
    <div class="bot-comparison-card bot-comparison-card-a" data-summary-bot="A" role="button" tabindex="0" aria-label="Ver estadísticas del Bot A">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <div>
                <div class="metric-label">Bot A Actual</div>
                <div id="BotPicksBotATotal" class="bot-comparison-total">...</div>
            </div>
            <span class="bot-badge bot-badge-a">Bot A</span>
        </div>
        <div id="BotPicksBotARecord" class="bot-comparison-record">...</div>
        <div class="bot-comparison-footer">
            <span id="BotPicksBotAProfit">P/L ...</span>
            <span id="BotPicksBotAYield">Yield ...</span>
        </div>
        <div id="BotPicksBotAPlan" class="bot-comparison-plan">Plan ...</div>
        <span id="BotPicksBotASample" class="bot-comparison-sample">Sin muestra</span>
    </div>
    <div class="bot-comparison-card bot-comparison-card-c" data-summary-bot="C" role="button" tabindex="0" aria-label="Ver estadísticas del Bot C">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <div>
                <div class="metric-label">Bot C · Modelos 2026</div>
                <div id="BotPicksBotCTotal" class="bot-comparison-total">...</div>
            </div>
            <span class="bot-badge bot-badge-c">Bot C</span>
        </div>
        <div id="BotPicksBotCRecord" class="bot-comparison-record">...</div>
        <div class="bot-comparison-footer">
            <span id="BotPicksBotCProfit">P/L ...</span>
            <span id="BotPicksBotCYield">Yield ...</span>
        </div>
        <div id="BotPicksBotCPlan" class="bot-comparison-plan">Plan ...</div>
        <span id="BotPicksBotCSample" class="bot-comparison-sample">Sin muestra</span>
    </div>
    <div class="bot-comparison-card bot-comparison-card-d" data-summary-bot="D" role="button" tabindex="0" aria-label="Ver estadísticas del Bot D">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <div>
                <div class="metric-label">Bot D · Brecha de nivel</div>
                <div id="BotPicksBotDTotal" class="bot-comparison-total">...</div>
            </div>
            <span class="bot-badge bot-badge-d">Bot D</span>
        </div>
        <div id="BotPicksBotDRecord" class="bot-comparison-record">...</div>
        <div class="bot-comparison-footer">
            <span id="BotPicksBotDProfit">P/L ...</span>
            <span id="BotPicksBotDYield">Yield ...</span>
        </div>
        <div id="BotPicksBotDPlan" class="bot-comparison-plan">Plan ...</div>
        <span id="BotPicksBotDSample" class="bot-comparison-sample">Sin muestra</span>
    </div>
    <div class="bot-comparison-card bot-comparison-card-e" data-summary-bot="E" role="button" tabindex="0" aria-label="Ver estadísticas del Bot E">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <div>
                <div class="metric-label">Bot E · Calibración empírica</div>
                <div id="BotPicksBotETotal" class="bot-comparison-total">...</div>
            </div>
            <span class="bot-badge bot-badge-e">Bot E</span>
        </div>
        <div id="BotPicksBotERecord" class="bot-comparison-record">...</div>
        <div class="bot-comparison-footer">
            <span id="BotPicksBotEProfit">P/L ...</span>
            <span id="BotPicksBotEYield">Yield ...</span>
        </div>
        <div id="BotPicksBotEPlan" class="bot-comparison-plan">Plan ...</div>
        <span id="BotPicksBotESample" class="bot-comparison-sample">Sin muestra</span>
    </div>
    <div class="bot-comparison-card bot-comparison-card-f" data-summary-bot="F" role="button" tabindex="0" aria-label="Ver estadísticas del Bot F">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <div><div class="metric-label">Bot F · Legacy ML calibrado</div><div id="BotPicksBotFTotal" class="bot-comparison-total">...</div></div>
            <span class="bot-badge bot-badge-f">Bot F</span>
        </div>
        <div id="BotPicksBotFRecord" class="bot-comparison-record">...</div>
        <div class="bot-comparison-footer"><span id="BotPicksBotFProfit">P/L ...</span><span id="BotPicksBotFYield">Yield ...</span></div>
        <div id="BotPicksBotFPlan" class="bot-comparison-plan">Plan ...</div>
        <span id="BotPicksBotFSample" class="bot-comparison-sample">Sin muestra</span>
    </div>
    <div id="BotPicksLegacyCard" class="bot-comparison-card bot-comparison-card-legacy d-none" data-summary-bot="Legacy" role="button" tabindex="0" aria-label="Ver estadísticas de bots personalizados">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <div>
                <div class="metric-label">Bots personalizados</div>
                <div id="BotPicksBotLegacyTotal" class="bot-comparison-total">...</div>
            </div>
            <span class="bot-badge bot-badge-legacy">Custom</span>
        </div>
        <div id="BotPicksBotLegacyRecord" class="bot-comparison-record">...</div>
        <div class="bot-comparison-footer">
            <span id="BotPicksBotLegacyProfit">P/L ...</span>
            <span id="BotPicksBotLegacyYield">Yield ...</span>
        </div>
        <div id="BotPicksBotLegacyPlan" class="bot-comparison-plan">Plan ...</div>
        <span id="BotPicksBotLegacySample" class="bot-comparison-sample">Sin muestra</span>
    </div>
</section>

<details id="BotPicksServerMonitoring" class="surface-panel bot-picks-collapsible mb-4" open>
    <summary>
        <span>
            <strong>Semáforo automático del servidor</strong>
            <small>Guardia 7/30/90 días por versión, mercado, lado y casa; Green habilita 1u y una cohorte GOALS controlada puede habilitar 0.5u</small>
        </span>
        <span aria-hidden="true">Abrir</span>
    </summary>
    <div class="bot-picks-collapsible-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <p class="text-muted small mb-0">El yield y la calibración se calculan una vez por partido para que duplicados no inflen la evidencia; Δ Brier positivo significa que el mercado predijo mejor. Un número económico verde sólo significa ROI positivo: Green exige 100 partidos independientes. En goles de equipo, una cohorte exacta con 30–99 partidos, ROI positivo, brecha <= 5 pp y Δ Brier <= 0 puede entrar sólo como prueba controlada de 0.5u.</p>
            <div class="btn-group btn-group-sm" role="group" aria-label="Ventana del semáforo">
                <button type="button" class="btn btn-outline-secondary" data-scorecard-window="7">7 días</button>
                <button type="button" class="btn btn-primary" data-scorecard-window="30">30 días</button>
                <button type="button" class="btn btn-outline-secondary" data-scorecard-window="90">90 días</button>
            </div>
        </div>
        <div id="BotPicksScorecardLoading" class="text-muted small">Calculando scorecards...</div>
        <div id="BotPicksScorecardError" class="alert alert-warning d-none mb-0"></div>
        <div id="BotPicksScorecardWrap" class="table-responsive d-none">
            <table class="table table-sm align-middle mb-0">
                <thead><tr><th>Bot</th><th>Mercado</th><th class="text-end">Picks / partidos</th><th class="text-end">Yield</th><th class="text-end">Modelo / real</th><th class="text-end">Brecha</th><th class="text-end">Δ Brier</th><th>Semáforo</th><th>Acción</th></tr></thead>
                <tbody id="BotPicksScorecardBody"></tbody>
            </table>
        </div>
    </div>
</details>

<details class="surface-panel bot-picks-collapsible mb-4">
    <summary>
        <span>
            <strong>Historial mensual</strong>
            <small>Comparación por bot y mes</small>
        </span>
        <span aria-hidden="true">Abrir</span>
    </summary>
    <div class="bot-picks-collapsible-body">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <div class="text-muted small">Cada fila pertenece a un bot y calcula su yield mensual: resultado del mes ÷ stake resuelto del mes.</div>
        </div>
        <span class="badge text-bg-light">W / L / V / P · P/L · Yield</span>
    </div>
    <div id="BotPicksMonthlyHistoryLoading" class="text-muted small">Cargando historial mensual...</div>
    <div id="BotPicksMonthlyHistoryEmpty" class="alert alert-light border d-none mb-0">Aún no hay meses con recomendaciones.</div>
    <div id="BotPicksMonthlyHistoryWrap" class="table-responsive d-none">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>Mes</th>
                    <th>Bot</th>
                    <th class="text-end">Apuestas</th>
                    <th class="text-end">W / L / Push / V / P</th>
                    <th class="text-end">Stake resuelto</th>
                    <th class="text-end">P/L</th>
                    <th class="text-end">Yield del mes</th>
                </tr>
            </thead>
            <tbody id="BotPicksMonthlyHistoryBody"></tbody>
        </table>
    </div>
    </div>
</details>

<div id="BotPicksRecommendations" class="bot-picks-anchor"></div>
<form id="BotPicksFilters" class="surface-panel mb-3">
    @Html.AntiForgeryToken()
    <input type="hidden" name="market" value="@marketFamily" />
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="h6 mb-1">Filtros</h2>
            <div class="text-muted small">Estos filtros afectan la tabla y el resumen. El bot del resumen se elige arriba; la tabla puede filtrarse por separado.</div>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-end">
            <label class="bot-picks-month-picker">
                <span>Mes</span>
                <input id="BotPicksMonth" class="form-control form-control-sm" type="month" value="@selectedMonth" />
            </label>
            <button id="BotPicksPreviousMonth" class="btn btn-sm btn-outline-secondary" type="button">← Mes anterior</button>
            <button id="BotPicksCurrentMonth" class="btn btn-sm btn-outline-secondary" type="button">Mes actual</button>
            <button id="BotPicksNextMonth" class="btn btn-sm btn-outline-secondary" type="button">Mes siguiente →</button>
            <button id="BotPicksBotCHistoricalPending" class="btn btn-sm btn-outline-success" type="button">Pendientes desde 19 jun</button>
            <a class="btn btn-sm btn-outline-secondary" asp-controller="BotPicks" asp-action="Index" asp-route-market="@marketFamily">Limpiar</a>
            <button class="btn btn-sm btn-outline-primary" type="submit">Aplicar</button>
        </div>
    </div>

    <div class="row g-3 align-items-end">
        <div class="col-sm-6 col-xl-2">
            <label class="form-label" for="DateFrom">Desde</label>
            <input id="DateFrom" name="DateFrom" class="form-control" type="date" value="@dateFrom" />
        </div>
        <div class="col-sm-6 col-xl-2">
            <label class="form-label" for="DateTo">Hasta</label>
            <input id="DateTo" name="DateTo" class="form-control" type="date" value="@dateTo" />
        </div>
        <div class="col-sm-6 col-xl-2">
            <label class="form-label" for="Status">Estado</label>
            <select id="Status" name="Status" class="form-select">
                <option value="">Todos</option>
                @foreach (var status in new[] { "Pending", "Won", "Lost", "Push", "Void" })
                {
                    var statusLabel = status switch
                    {
                        "Pending" => "Pendiente",
                        "Won" => "Ganada",
                        "Lost" => "Perdida",
                        "Push" => "Devuelta",
                        "Void" => "Anulada",
                        _ => status
                    };
                    if (selectedStatus.Equals(status, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@status" selected>@statusLabel</option>
                    }
                    else
                    {
                        <option value="@status">@statusLabel</option>
                    }
                }
            </select>
        </div>
        <div class="col-sm-6 col-xl-2">
            <label class="form-label" for="MarketType">Mercado</label>
            <select id="MarketType" name="MarketType" class="form-select">
                <option value="">Todos</option>
                @foreach (var marketType in Model.Market.Options)
                {
                    if (selectedMarketType.Equals(marketType.Value, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@marketType.Value" selected>@marketType.Label</option>
                    }
                    else
                    {
                        <option value="@marketType.Value">@marketType.Label</option>
                    }
                }
            </select>
        </div>
        <div class="col-sm-6 col-xl-2">
            <label class="form-label" for="Bookmaker">Casa de apuesta</label>
            <select id="Bookmaker" name="Bookmaker" class="form-select">
                <option value="">Todas</option>
                @foreach (var bookmaker in new[] { "Betano", "Pinnacle" })
                {
                    if (selectedBookmaker.Equals(bookmaker, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@bookmaker" selected>@bookmaker</option>
                    }
                    else
                    {
                        <option value="@bookmaker">@bookmaker</option>
                    }
                }
            </select>
        </div>
        <div class="col-sm-6 col-xl-2">
            <label class="form-label" for="League">Liga</label>
            <input id="League" name="League" class="form-control" value="@Model.Filters.League" placeholder="Todas las ligas" autocomplete="off" />
        </div>
        <div class="col-sm-6 col-xl-2">
            <label class="form-label" for="SearchText">Buscar</label>
            <input id="SearchText" class="form-control" type="search" placeholder="Equipo o liga" autocomplete="off" />
        </div>
        <div class="col-sm-6 col-xl-2">
            <label class="form-label" for="StrategyPlan">Plan productivo</label>
            <select id="StrategyPlan" class="form-select">
                <option value="">Todos</option>
                <option value="bet">Para apostar</option>
                <option value="stake-1">Stake 1u</option>
                <option value="stake-half">Stake 0.5u</option>
                <option value="monitor">Monitoreo</option>
            </select>
        </div>
        <div class="col-sm-6 col-xl-2">
            <label class="form-label" for="IntelligenceFilter">Inteligencia</label>
            <select id="IntelligenceFilter" class="form-select">
                <option value="">Todos</option>
                <option id="BotPicksIntelligenceAppliedOption" value="applied">Aplicada al pick</option>
                <option value="neutral">Neutral / sin evidencia</option>
                <option value="reference">Solo referencia histórica</option>
                <option value="not-compatible">Sin enlace al partido</option>
            </select>
        </div>
    </div>
</form>

<section class="surface-panel bot-picks-recommendations-panel">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <div>
