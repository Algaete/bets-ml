            <button type="button" data-pending-reason="missing-stat"><span>Falta estadística</span><strong id="BotPicksPendingMissingStat">0</strong></button>
            <button type="button" data-pending-reason="ambiguous"><span>Coincidencia ambigua</span><strong id="BotPicksPendingAmbiguous">0</strong></button>
            <button type="button" data-pending-reason="other"><span>Otra causa</span><strong id="BotPicksPendingOther">0</strong></button>
