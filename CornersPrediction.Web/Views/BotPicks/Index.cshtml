                const intelligence = getDecisionReason(item)?.featureSnapshot?.footballIntelligence;
                if (!intelligence?.enabled) {
                    return {
                        key: 'reference',
                        applied: false,
                        adjustment: 0,
                        label: 'Inteligencia · referencia',
                        title: 'Este pick no incorporó inteligencia prepartido en su decisión.'
