@model CornersPrediction.Web.Models.BotPicks.BotG2026IndexViewModel
@{
    var overall = Model.Scorecards.FirstOrDefault(row => row.Dimension == "Overall");
    string Pct(double? value) => value.HasValue ? value.Value.ToString("P2") : "—";
    string Num(double? value, string format = "N3") => value.HasValue ? value.Value.ToString(format) : "—";
    string Money(double? value) => value.HasValue ? $"{value.Value:+0.00;-0.00;0.00}u" : "—";
}

<div data-scorecards-state="@(Model.ScorecardsAvailable ? "ready" : "error")">
    @if (overall is not null)
    {
        @if (overall.CandidatesEvaluated > 0 && overall.CandidatesAbstained == overall.CandidatesEvaluated)
        {
            <div class="alert alert-warning mb-3" role="note">
                <strong>El 100% está en Abstain.</strong> No hay señal apostable: revisa el runtime, la calibración y OOD antes de interpretar el rendimiento.
            </div>
        }
        <section class="g-metrics mb-3" aria-label="Resumen general G2026">
            <div class="g-metric"><span>Candidatos</span><strong>@overall.CandidatesEvaluated</strong></div>
            <div class="g-metric"><span>Fixtures</span><strong>@overall.FixturesEvaluated</strong></div>
            <div class="g-metric"><span>Fixtures resueltos</span><strong>@overall.ResolvedFixtures</strong></div>
            <div class="g-metric"><span>Aprobados</span><strong>@overall.CandidatesApproved</strong></div>
            <div class="g-metric"><span>Abstenciones</span><strong>@overall.CandidatesAbstained</strong></div>
            <div class="g-metric"><span>Coverage</span><strong>@Pct(overall.CoverageRate)</strong></div>
            <div class="g-metric"><span>Publication</span><strong>@Pct(overall.PublicationRate)</strong></div>
            <div class="g-metric"><span>Brier G / market</span><strong>@Num(overall.Brier) / @Num(overall.MarketBrier)</strong></div>
            <div class="g-metric"><span>Yield</span><strong>@Pct(overall.Yield)</strong></div>
            <div class="g-metric"><span>Stage sugerido</span><strong>@overall.SuggestedPromotionStage</strong></div>
        </section>
    }

    <section class="g-panel">
        <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
            <div><h2 class="h5 mb-1">Scorecards</h2><div class="small text-secondary">Métricas predictivas sobre candidatos auditados; economía sobre decisiones Approved resueltas.</div></div>
            <span class="badge @(Model.ScorecardsAvailable ? "text-bg-success" : "text-bg-warning")">@(Model.ScorecardsAvailable ? "Disponible" : "No disponible")</span>
        </div>
        @if (!Model.ScorecardsAvailable)
        {
            <div class="alert alert-warning mb-0" role="alert">@Model.ScorecardsErrorMessage <button type="button" class="btn btn-sm btn-outline-warning ms-2 js-retry-scorecards">Reintentar</button></div>
        }
        else
        {
            <div class="g-table-scroll" tabindex="0" aria-label="Scorecards desplazables G2026">
                <table class="table table-sm align-middle g-table mb-0">
                    <thead><tr><th>Dimensión</th><th>Segmento</th><th class="text-end">N</th><th class="text-end">Resolved</th><th class="text-end">Coverage</th><th class="text-end">Yield</th><th class="text-end">Brier</th><th class="text-end">Δ Brier</th><th class="text-end">LogLoss</th><th class="text-end">ECE</th><th class="text-end">Max DD</th><th>Stage</th></tr></thead>
                    <tbody>
                    @foreach (var row in Model.Scorecards)
                    {
                        <tr><td>@row.Dimension</td><td>@row.Segment</td><td class="text-end">@row.CandidatesEvaluated</td><td class="text-end">@row.Resolved</td><td class="text-end">@Pct(row.CoverageRate)</td><td class="text-end">@Pct(row.Yield)</td><td class="text-end">@Num(row.Brier)</td><td class="text-end">@Num(row.DeltaBrier)</td><td class="text-end">@Num(row.LogLoss)</td><td class="text-end">@Num(row.Ece)</td><td class="text-end">@Money(row.MaximumDrawdown)</td><td>@row.SuggestedPromotionStage</td></tr>
                    }
                    @if (Model.Scorecards.Count == 0)
                    {
                        <tr><td colspan="12" class="text-center text-secondary py-4">No hay scorecards G2026 para estos filtros.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
