@model CornersPrediction.Web.Models.BotPicks.BotG2026IndexViewModel
@{
    string Pct(double? value, string fallback = "—") => value.HasValue ? $"{value.Value:P2}" : fallback;
    string DecisionClass(string value) => value switch
    {
        "Approved" => "bg-success-subtle text-success-emphasis",
        "Abstain" => "bg-warning-subtle text-warning-emphasis",
        _ => "bg-secondary-subtle text-secondary-emphasis"
    };
}

<section class="g-panel" data-candidates-state="@(Model.CandidatesAvailable ? "ready" : "error")">
    <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="h5 mb-1">Candidate audit</h2>
            @if (Model.CandidatesAvailable)
            {
                <div class="small text-secondary">
                    @Model.Candidates.TotalRows candidatos · página @Model.Candidates.Page de @Math.Max(1, Model.Candidates.TotalPages)
                    · sólo se descargan @Model.Candidates.PageSize por página
                </div>
            }
            else
            {
                <div class="small text-secondary">La consulta de candidatos falló; esto no cambia el estado del runtime ni los scorecards.</div>
            }
        </div>
        <span class="badge @(Model.CandidatesAvailable ? "text-bg-success" : "text-bg-warning")">@(Model.CandidatesAvailable ? "Disponible" : "No disponible")</span>
    </div>

    @if (!Model.CandidatesAvailable)
    {
        <div class="alert alert-warning mb-0" role="alert">
            @Model.CandidatesErrorMessage
            <button type="button" class="btn btn-sm btn-outline-warning ms-2 js-retry-candidates">Reintentar</button>
        </div>
    }
    else
    {
        <div class="g-table-scroll" tabindex="0" aria-label="Tabla desplazable de candidatos G2026">
            <table class="table table-hover table-sm align-middle g-table mb-0">
                <thead>
                    <tr><th>Fixture</th><th>Apuesta</th><th>Modo</th><th>Decisión</th><th class="g-prob">Market</th><th class="g-prob">Raw</th><th class="g-prob">Cal.</th><th class="g-prob">Conserv.</th><th class="g-prob">Edge</th><th class="g-prob">Cons. edge</th><th class="g-prob">EV</th><th class="g-prob">Cons. EV</th><th class="g-prob">Uncert.</th><th class="g-prob">Reliability</th><th class="g-prob">OOD</th><th>Resultado</th><th data-no-sort="true">Detalle</th></tr>
                </thead>
                <tbody>
                @foreach (var candidate in Model.Candidates.Items)
                {
                    <tr>
                        <td><div class="fw-semibold">@candidate.HomeTeam vs @candidate.AwayTeam</div><div class="text-secondary">@candidate.FixtureDateUtc.ToString("yyyy-MM-dd HH:mm") UTC · @candidate.Bookmaker</div></td>
                        <td><div>@candidate.MarketType · @candidate.Selection @candidate.Line</div><div class="text-secondary">@@ @candidate.SelectedOdds.ToString("0.00")</div></td>
                        <td><span class="badge @(candidate.Published ? "bg-danger" : "bg-warning text-dark")">@candidate.PublicationStatus</span></td>
                        <td><span class="badge @DecisionClass(candidate.Decision)">@candidate.Decision</span><div class="text-secondary">@candidate.DecisionReason</div></td>
                        <td class="g-prob">@Pct(candidate.MarketNoVigProbability)</td><td class="g-prob">@Pct(candidate.CandidateProbability)</td><td class="g-prob">@Pct(candidate.CalibratedProbability)</td><td class="g-prob">@Pct(candidate.ConservativeProbability)</td>
                        <td class="g-prob">@Pct(candidate.RawEdge)</td><td class="g-prob">@Pct(candidate.ConservativeEdge)</td><td class="g-prob">@Pct(candidate.RawExpectedValue)</td><td class="g-prob">@Pct(candidate.ConservativeExpectedValue)</td>
                        <td class="g-prob">@Pct(candidate.UncertaintyScore)</td><td class="g-prob">@Pct(candidate.CalibrationReliability)</td><td class="g-prob">@Pct(candidate.OutOfDistributionScore)</td>
                        <td>@(candidate.Result ?? "Pending") @if (candidate.ProfitLoss.HasValue) { <span class="d-block">@candidate.ProfitLoss.Value.ToString("+0.00;-0.00;0.00")u</span> }</td>
                        <td class="g-detail">
                            <details>
                                <summary>Audit #@candidate.CandidateId</summary>
                                <dl class="row mb-1 mt-2">
                                    <dt class="col-5">Prediction UTC</dt><dd class="col-7">@candidate.PredictionTimestampUtc.ToString("O")</dd>
                                    <dt class="col-5">Odds UTC</dt><dd class="col-7">@candidate.OddsTimestampUtc.ToString("O")</dd>
                                    <dt class="col-5">Config</dt><dd class="col-7">@candidate.ConfigurationVersion</dd>
                                    <dt class="col-5">Base model</dt><dd class="col-7">@candidate.BaseModelVersion</dd>
                                    <dt class="col-5">Meta / Cal.</dt><dd class="col-7">@candidate.MetaModelVersion / @candidate.CalibrationVersion</dd>
                                    <dt class="col-5">Uncertainty / OOD</dt><dd class="col-7">@candidate.UncertaintyVersion / @candidate.OodVersion</dd>
                                    <dt class="col-5">Confidence bounds</dt><dd class="col-7">@Pct(candidate.ProbabilityLowerBound) – @Pct(candidate.ProbabilityUpperBound)</dd>
                                </dl>
                                <div class="js-g-audit-detail">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary js-load-g-audit"
                                            data-url="@Url.Action("Candidate", "BotG2026", new { id = candidate.CandidateId })">
                                        Cargar razones completas
                                    </button>
                                </div>
                            </details>
                        </td>
                    </tr>
                }
                @if (Model.Candidates.Items.Count == 0)
                {
                    <tr data-lab-no-sort="true"><td colspan="17" class="text-center text-secondary py-4">No hay candidatos G2026 para estos filtros.</td></tr>
                }
                </tbody>
            </table>
        </div>

        @if (Model.Candidates.TotalPages > 1)
        {
            <nav class="d-flex justify-content-between align-items-center mt-3" aria-label="Paginación G2026">
                <a class="btn btn-sm btn-outline-secondary @(Model.Candidates.Page <= 1 ? "disabled" : "")"
                   asp-action="Index" asp-route-DateFromUtc="@Model.Filters.DateFromUtc?.ToString("O")" asp-route-DateToUtc="@Model.Filters.DateToUtc?.ToString("O")"
                   asp-route-Decision="@Model.Filters.Decision" asp-route-PublicationStatus="@Model.Filters.PublicationStatus" asp-route-MarketType="@Model.Filters.MarketType"
                   asp-route-Selection="@Model.Filters.Selection" asp-route-Bookmaker="@Model.Filters.Bookmaker" asp-route-ConfigurationVersion="@Model.Filters.ConfigurationVersion"
                   asp-route-Result="@Model.Filters.Result" asp-route-Page="@(Model.Candidates.Page - 1)" asp-route-PageSize="@Model.Filters.PageSize">Anterior</a>
                <span class="small text-secondary">Página @Model.Candidates.Page / @Model.Candidates.TotalPages</span>
                <a class="btn btn-sm btn-outline-secondary @(Model.Candidates.Page >= Model.Candidates.TotalPages ? "disabled" : "")"
                   asp-action="Index" asp-route-DateFromUtc="@Model.Filters.DateFromUtc?.ToString("O")" asp-route-DateToUtc="@Model.Filters.DateToUtc?.ToString("O")"
                   asp-route-Decision="@Model.Filters.Decision" asp-route-PublicationStatus="@Model.Filters.PublicationStatus" asp-route-MarketType="@Model.Filters.MarketType"
                   asp-route-Selection="@Model.Filters.Selection" asp-route-Bookmaker="@Model.Filters.Bookmaker" asp-route-ConfigurationVersion="@Model.Filters.ConfigurationVersion"
                   asp-route-Result="@Model.Filters.Result" asp-route-Page="@(Model.Candidates.Page + 1)" asp-route-PageSize="@Model.Filters.PageSize">Siguiente</a>
            </nav>
        }
    }
</section>
