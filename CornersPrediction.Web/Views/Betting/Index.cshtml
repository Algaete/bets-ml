@model CornersPrediction.Web.Models.Betting.BettingIndexViewModel
@using CornersPrediction.Web.Models.Betting

@{
    Func<string, string> T = key => UiText.T(Context, key);
    ViewData["Title"] = T("Betting.Title");
    var moneyStep = Model.WorkingCurrencyCode == "CLP" ? "1" : "0.01";
    var settledBets = Model.Summary.WonBets + Model.Summary.LostBets + Model.Summary.VoidBets + Model.Summary.CashoutBets;
    var activeFilterCount = new[]
    {
        Model.Filters.CurrencyCode,
        Model.Filters.League,
        Model.Filters.Season,
        Model.Filters.HomeTeam,
        Model.Filters.AwayTeam,
        Model.Filters.Status,
        Model.Filters.MarketType,
        Model.Filters.Bookmaker
    }.Count(value => !string.IsNullOrWhiteSpace(value)) +
    (Model.Filters.DateFrom.HasValue ? 1 : 0) +
    (Model.Filters.DateTo.HasValue ? 1 : 0);
    var exportRoutes = new Dictionary<string, string>();
    void AddExportRoute(string key, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            exportRoutes[key] = value;
        }
    }

    AddExportRoute(nameof(Model.Filters.CurrencyCode), Model.Filters.CurrencyCode);
    AddExportRoute(nameof(Model.Filters.League), Model.Filters.League);
    AddExportRoute(nameof(Model.Filters.Season), Model.Filters.Season);
    AddExportRoute(nameof(Model.Filters.HomeTeam), Model.Filters.HomeTeam);
    AddExportRoute(nameof(Model.Filters.AwayTeam), Model.Filters.AwayTeam);
    AddExportRoute(nameof(Model.Filters.Status), Model.Filters.Status);
    AddExportRoute(nameof(Model.Filters.MarketType), Model.Filters.MarketType);
    AddExportRoute(nameof(Model.Filters.Bookmaker), Model.Filters.Bookmaker);
    AddExportRoute(nameof(Model.Filters.DateFrom), Model.Filters.DateFrom?.ToString("yyyy-MM-dd"));
    AddExportRoute(nameof(Model.Filters.DateTo), Model.Filters.DateTo?.ToString("yyyy-MM-dd"));
    var excelExportRoutes = new Dictionary<string, string>(exportRoutes)
    {
        ["format"] = "excel"
    };
    var pdfExportRoutes = new Dictionary<string, string>(exportRoutes)
    {
        ["format"] = "pdf"
    };
}

@functions {
    private static string StatusBadge(string status) => status switch
    {
        "Won" => "text-bg-success",
        "Lost" => "text-bg-danger",
        "Pending" => "text-bg-warning",
        "Void" => "text-bg-info",
        "Cashout" => "text-bg-secondary",
        _ => "text-bg-light"
    };

    private static string StatusButton(string status) => status switch
    {
        "Won" => "btn-outline-success",
        "Lost" => "btn-outline-danger",
        "Void" => "btn-outline-info",
        "Cashout" => "btn-outline-secondary",
        _ => "btn-outline-secondary"
    };

    private static string MoneyClass(decimal value) => value > 0 ? "text-success" : value < 0 ? "text-danger" : "text-muted";

    private static string Money(decimal value, string currencyCode) =>
        currencyCode == "CLP" ? $"{currencyCode} {value:N0}" : $"{currencyCode} {value:N2}";

    private static string ActualMarketResult(BettingRecordViewModel record)
    {
        return record.MarketType switch
        {
            "TotalShots" => $"Shots {(record.ActualTotalShots?.ToString() ?? "-")}",
            "TotalShotsOnGoal" => $"SOG {(record.ActualTotalShotsOnGoal?.ToString() ?? "-")}",
            _ => $"Corners {(record.ActualTotalCorners?.ToString() ?? "-")}"
        };
    }
}

<div class="betting-hero mb-4">
    <div>
        <div class="text-muted small text-uppercase fw-semibold">@T("Betting.Desk")</div>
        <h1 class="h3 mb-1">@T("Betting.Title")</h1>
        <p class="text-muted mb-0">@T("Betting.Description")</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" asp-controller="Betting" asp-action="Export" asp-all-route-data="excelExportRoutes">
            Export Excel
        </a>
        <a class="btn btn-outline-secondary" asp-controller="Betting" asp-action="Export" asp-all-route-data="pdfExportRoutes">
            Export PDF
        </a>
        <button class="btn btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#BankrollMovementPanel" aria-expanded="false" aria-controls="BankrollMovementPanel">
            @T("Betting.AddMovement")
        </button>
        <a class="btn btn-primary" asp-controller="Betting" asp-action="Create" asp-route-currencyCode="@Model.WorkingCurrencyCode">@T("Betting.Create")</a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<section class="betting-dashboard mb-4">
    <div class="bankroll-panel">
        <div class="d-flex justify-content-between align-items-start gap-3">
            <div>
                <div class="small text-muted">@T("Betting.CurrentBankroll")</div>
                <div class="bankroll-value">@Money(Model.CurrentBankroll, Model.WorkingCurrencyCode)</div>
                <div class="small text-muted">@Model.WorkingCurrencyCode</div>
            </div>
            <span class="badge text-bg-light">@Model.Summary.TotalBets @T("Common.Records")</span>
        </div>
        <div class="mt-3 pt-3 border-top">
            <div class="d-flex justify-content-between gap-3">
                <span class="small text-muted">@T("Betting.PendingStake")</span>
                <span class="fw-semibold">@Money(Model.PendingStake, Model.WorkingCurrencyCode)</span>
            </div>
            <div class="d-flex justify-content-between gap-3 mt-2">
                <span>
                    <span class="small text-muted d-block">@T("Betting.AvailableBankroll")</span>
                    <span class="small text-muted">@T("Betting.AvailableBankrollHint")</span>
                </span>
                <span class="h5 mb-0 @MoneyClass(Model.AvailableBankroll)">@Money(Model.AvailableBankroll, Model.WorkingCurrencyCode)</span>
            </div>
        </div>

        <div class="currency-tabs mt-4" aria-label="@T("Fields.Currency")">
            @{
                var allCurrencyClass = string.IsNullOrWhiteSpace(Model.Filters.CurrencyCode) ? "active" : string.Empty;
            }
            <a class="@allCurrencyClass" asp-controller="Betting" asp-action="Index">@T("Common.All")</a>
            @foreach (var currencyCode in BettingOptions.CurrencyCodes)
            {
                var currencyClass = Model.Filters.CurrencyCode == currencyCode ? "active" : string.Empty;
                <a class="@currencyClass" asp-controller="Betting" asp-action="Index" asp-route-currencyCode="@currencyCode">@currencyCode</a>
            }
        </div>
    </div>

    <div class="metric-grid">
        <div class="metric-tile">
            <div class="metric-label">@T("Betting.TotalStake")</div>
            <div class="metric-value">@Money(Model.Summary.TotalStake, Model.WorkingCurrencyCode)</div>
        </div>
        <div class="metric-tile">
            <div class="metric-label">@T("Betting.NetPL")</div>
            <div class="metric-value @MoneyClass(Model.Summary.TotalProfitLoss)">@Money(Model.Summary.TotalProfitLoss, Model.WorkingCurrencyCode)</div>
        </div>
        <div class="metric-tile">
            <div class="metric-label">@T("Betting.Roi")</div>
            <div class="metric-value">@Model.Summary.RoiPercent.ToString("N2")%</div>
        </div>
        <div class="metric-tile">
            <div class="metric-label">@T("Betting.WinRate")</div>
            <div class="metric-value">@Model.Summary.WinRatePercent.ToString("N2")%</div>
        </div>
        <div class="metric-tile compact">
            <div class="metric-label">@T("Betting.Pending")</div>
            <div class="metric-value">@Model.Summary.PendingBets</div>
        </div>
        <div class="metric-tile compact">
            <div class="metric-label">@T("Betting.Settled")</div>
            <div class="metric-value">@settledBets</div>
        </div>
        <div class="metric-tile compact">
            <div class="metric-label">@T("Betting.AverageOdds")</div>
            <div class="metric-value">@Model.Summary.AverageOdds.ToString("N2")</div>
        </div>
        <div class="metric-tile compact">
            <div class="metric-label">@T("Betting.AverageStake")</div>
            <div class="metric-value">@Money(Model.Summary.AverageStake, Model.WorkingCurrencyCode)</div>
        </div>
    </div>
</section>

<div class="collapse mb-4" id="BankrollMovementPanel">
    <form method="post" asp-controller="Betting" asp-action="CreateBankrollTransaction" class="surface-panel">
        @Html.AntiForgeryToken()
        <input type="hidden" name="CurrencyCode" value="@Model.WorkingCurrencyCode" />
        <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
            <div>
                <h2 class="h6 mb-1">@T("Betting.BankrollTransaction")</h2>
                <div class="text-muted small">@Model.WorkingCurrencyCode</div>
            </div>
        </div>
        <div class="row g-3 align-items-end">
            <div class="col-md-3 col-lg-2">
                <label class="form-label" for="BankrollTransactionDate">@T("Fields.Date")</label>
                <input id="BankrollTransactionDate" name="TransactionDate" type="date" class="form-control" value="@Model.BankrollForm.TransactionDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3 col-lg-2">
                <label class="form-label" for="BankrollType">@T("Fields.Type")</label>
                <select id="BankrollType" name="Type" class="form-select">
                    @foreach (var type in BettingOptions.BankrollTransactionTypes)
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </div>
            <div class="col-md-3 col-lg-2">
                <label class="form-label" for="BankrollAmount">@T("Fields.Amount")</label>
                <input id="BankrollAmount" name="Amount" type="number" step="@moneyStep" class="form-control" />
            </div>
            <div class="col-md-3 col-lg-2">
                <label class="form-label" for="BankrollBettingRecordId">@T("Fields.BetId")</label>
                <input id="BankrollBettingRecordId" name="BettingRecordId" type="number" class="form-control" />
            </div>
            <div class="col-lg-3">
                <label class="form-label" for="BankrollNotes">@T("Fields.Notes")</label>
                <input id="BankrollNotes" name="Notes" class="form-control" />
            </div>
            <div class="col-lg-1 d-grid">
                <button class="btn btn-primary" type="submit">@T("Common.Save")</button>
            </div>
        </div>
    </form>
</div>

<form method="get" class="surface-panel mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="h6 mb-1">@T("Betting.Filters")</h2>
            <div class="text-muted small">@activeFilterCount active</div>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-sm btn-outline-secondary" asp-controller="Betting" asp-action="Index">@T("Common.All")</a>
            <button class="btn btn-sm btn-outline-primary" type="submit">@T("Common.Apply")</button>
        </div>
    </div>

    <div class="row g-3 align-items-end">
        <div class="col-sm-6 col-md-3 col-xl-2">
            <label class="form-label" for="CurrencyCode">@T("Fields.Currency")</label>
            <select id="CurrencyCode" name="CurrencyCode" class="form-select">
                <option value="">@T("Common.All")</option>
                @foreach (var currencyCode in BettingOptions.CurrencyCodes)
                {
                    if (Model.Filters.CurrencyCode == currencyCode)
                    {
                        <option value="@currencyCode" selected>@currencyCode</option>
                    }
                    else
                    {
                        <option value="@currencyCode">@currencyCode</option>
                    }
                }
            </select>
        </div>
        <div class="col-sm-6 col-md-3 col-xl-2">
            <label class="form-label" for="Status">@T("Fields.Status")</label>
            <select id="Status" name="Status" class="form-select">
                <option value="">@T("Common.All")</option>
                @foreach (var status in BettingOptions.Statuses)
                {
                    if (Model.Filters.Status == status)
                    {
                        <option value="@status" selected>@status</option>
                    }
                    else
                    {
                        <option value="@status">@status</option>
                    }
                }
            </select>
        </div>
        <div class="col-sm-6 col-md-3 col-xl-2">
            <label class="form-label" for="MarketType">@T("Fields.Market")</label>
            <select id="MarketType" name="MarketType" class="form-select">
                <option value="">@T("Common.All")</option>
                @foreach (var marketType in BettingOptions.MarketTypes)
                {
                    if (Model.Filters.MarketType == marketType)
                    {
                        <option value="@marketType" selected>@BettingOptions.MarketTypeLabel(marketType)</option>
                    }
                    else
                    {
                        <option value="@marketType">@BettingOptions.MarketTypeLabel(marketType)</option>
                    }
                }
            </select>
        </div>
        <div class="col-sm-6 col-md-3 col-xl-2">
            <label class="form-label" for="League">@T("Fields.League")</label>
            <input id="League" name="League" class="form-control" value="@Model.Filters.League" />
        </div>
        <div class="col-sm-6 col-md-3 col-xl-2">
            <label class="form-label" for="Bookmaker">@T("Fields.Bookmaker")</label>
            <input id="Bookmaker" name="Bookmaker" class="form-control" value="@Model.Filters.Bookmaker" />
        </div>
        <div class="col-sm-6 col-md-3 col-xl-2">
            <label class="form-label" for="Season">@T("Fields.Season")</label>
            <input id="Season" name="Season" class="form-control" value="@Model.Filters.Season" />
        </div>
        <div class="col-sm-6 col-md-3">
            <label class="form-label" for="HomeTeam">@T("Fields.HomeTeam")</label>
            <input id="HomeTeam" name="HomeTeam" class="form-control" value="@Model.Filters.HomeTeam" />
        </div>
        <div class="col-sm-6 col-md-3">
            <label class="form-label" for="AwayTeam">@T("Fields.AwayTeam")</label>
            <input id="AwayTeam" name="AwayTeam" class="form-control" value="@Model.Filters.AwayTeam" />
        </div>
        <div class="col-sm-6 col-md-3">
            <label class="form-label" for="DateFrom">@T("Fields.DateFrom")</label>
            <input id="DateFrom" name="DateFrom" class="form-control" type="date" value="@Model.Filters.DateFrom?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-sm-6 col-md-3">
            <label class="form-label" for="DateTo">@T("Fields.DateTo")</label>
            <input id="DateTo" name="DateTo" class="form-control" type="date" value="@Model.Filters.DateTo?.ToString("yyyy-MM-dd")" />
        </div>
    </div>
</form>

<section class="surface-panel mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="h6 mb-1">@T("Betting.Records")</h2>
            <div class="text-muted small">@Model.Records.Count @T("Common.Records")</div>
        </div>
        <a class="btn btn-sm btn-primary" asp-controller="Betting" asp-action="Create" asp-route-currencyCode="@Model.WorkingCurrencyCode">@T("Betting.Create")</a>
    </div>

    @if (Model.Records.Count == 0)
    {
        <div class="empty-state">
            <div class="fw-semibold">@T("Betting.NoRecords")</div>
            <div class="text-muted small">@T("Betting.NoRecordsHint")</div>
        </div>
    }
    else
    {
        <div class="table-responsive betting-table-wrap">
            <table class="table table-sm align-middle mb-0 table-sticky-head betting-records-table">
                <thead>
                    <tr>
                        <th>@T("Fields.Date")</th>
                        <th>@T("Fields.Match")</th>
                        <th>@T("Betting.Bet")</th>
                        <th>@T("Fields.Stake")</th>
                        <th>@T("Fields.Result")</th>
                        <th>@T("Fields.BankrollBefore") / @T("Fields.BankAfter")</th>
                        <th class="text-end">@T("Common.Actions")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in Model.Records)
                    {
                        <tr>
                            <td class="text-nowrap">
                                <div class="fw-semibold">@record.MatchDate.ToString("yyyy-MM-dd")</div>
                                <div class="small text-muted">@record.CurrencyCode</div>
                            </td>
                            <td>
                                <div class="fw-semibold">@record.HomeTeam vs @record.AwayTeam</div>
                                <div class="small text-muted">@record.League · @record.Season@(string.IsNullOrWhiteSpace(record.Bookmaker) ? "" : $" · {record.Bookmaker}")</div>
                            </td>
                            <td>
                                <div><span class="fw-semibold">@record.BetSelection</span> @record.Line.ToString("N2")</div>
                                <div class="small text-muted">@BettingOptions.MarketTypeLabel(record.MarketType) · @T("Fields.Odds") @record.Odds.ToString("N2")</div>
                                <div class="small text-muted">@record.PredictionModel</div>
                            </td>
                            <td class="text-nowrap">
                                <div class="fw-semibold">@Money(record.Stake, record.CurrencyCode)</div>
                                <div class="small text-muted">@T("Fields.Potential") @Money(record.PotentialReturn, record.CurrencyCode)</div>
                            </td>
                            <td>
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <span class="badge @StatusBadge(record.Status)">@record.Status</span>
                                    <span class="@MoneyClass(record.ProfitLoss) fw-semibold">@Money(record.ProfitLoss, record.CurrencyCode)</span>
                                </div>
                                <div class="small text-muted">
                                    ROI @record.RoiPercent.ToString("N2")% · @ActualMarketResult(record)
                                </div>
                            </td>
                            <td class="text-nowrap">
                                <div>@(record.BankrollBefore.HasValue ? Money(record.BankrollBefore.Value, record.CurrencyCode) : "-")</div>
                                <div class="small text-muted">→ @(record.BankrollAfter.HasValue ? Money(record.BankrollAfter.Value, record.CurrencyCode) : "-")</div>
                            </td>
                            <td>
                                <div class="betting-actions">
                                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Betting" asp-action="Details" asp-route-id="@record.Id">@T("Common.View")</a>
                                    <a class="btn btn-sm btn-outline-primary" asp-controller="Betting" asp-action="Edit" asp-route-id="@record.Id">@T("Common.Edit")</a>
                                    @foreach (var status in new[] { "Won", "Lost", "Void", "Cashout" })
                                    {
                                        <form method="post" asp-controller="Betting" asp-action="MarkStatus" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@record.Id" />
                                            <input type="hidden" name="status" value="@status" />
                                            <button type="submit" class="btn btn-sm @StatusButton(status)">@status</button>
                                        </form>
                                    }
                                    <form method="post" asp-controller="Betting" asp-action="Delete" class="d-inline" onsubmit="return confirm('@T("Common.DeleteBetConfirm")');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@record.Id" />
                                        <input type="hidden" name="currencyCode" value="@record.CurrencyCode" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">@T("Common.Delete")</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="surface-panel">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="h6 mb-1">@T("Betting.BankrollMovements")</h2>
            <div class="text-muted small">@Model.BankrollTransactions.Count @T("Common.Records")</div>
        </div>
    </div>

    @if (Model.BankrollTransactions.Count == 0)
    {
        <div class="empty-state">
            <div class="fw-semibold">@T("Betting.NoMovements")</div>
            <div class="text-muted small">@T("Betting.NoMovementsHint")</div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>@T("Fields.Date")</th>
                        <th>@T("Fields.Currency")</th>
                        <th>@T("Fields.Type")</th>
                        <th>@T("Fields.Amount")</th>
                        <th>@T("Fields.BalanceAfter")</th>
                        <th>@T("Fields.BetId")</th>
                        <th>@T("Fields.Notes")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var transaction in Model.BankrollTransactions.Take(10))
                    {
                        <tr>
                            <td class="text-nowrap">@transaction.TransactionDate.ToString("yyyy-MM-dd")</td>
                            <td>@transaction.CurrencyCode</td>
                            <td><span class="badge text-bg-light">@transaction.Type</span></td>
                            <td class="@MoneyClass(transaction.Amount) fw-semibold">@Money(transaction.Amount, transaction.CurrencyCode)</td>
                            <td>@Money(transaction.BalanceAfter, transaction.CurrencyCode)</td>
                            <td>@(transaction.BettingRecordId?.ToString() ?? "-")</td>
                            <td class="text-truncate" style="max-width: 420px;">@transaction.Notes</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
