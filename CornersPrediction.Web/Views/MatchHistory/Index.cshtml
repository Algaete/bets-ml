                        <div class="col-md-3">
                            <label class="form-label" for="Edit_AwayCorners">Away corners</label>
                            <input id="Edit_AwayCorners" class="form-control" type="number" min="0" max="50" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="Edit_HomeShots">Home shots</label>
                            <input id="Edit_HomeShots" class="form-control" type="number" min="0" max="80" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="Edit_AwayShots">Away shots</label>
                            <input id="Edit_AwayShots" class="form-control" type="number" min="0" max="80" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="Edit_HomeShotsOnGoal">Home shots on goal</label>
                            <input id="Edit_HomeShotsOnGoal" class="form-control" type="number" min="0" max="80" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="Edit_AwayShotsOnGoal">Away shots on goal</label>
                            <input id="Edit_AwayShotsOnGoal" class="form-control" type="number" min="0" max="80" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="Edit_HomePossession">Home possession</label>
                            <div class="input-group">
                                <input id="Edit_HomePossession" class="form-control" type="number" min="0" max="100" step="0.01" required />
                                <span class="input-group-text">%</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="Edit_AwayPossession">Away possession</label>
                            <div class="input-group">
                                <input id="Edit_AwayPossession" class="form-control" type="number" min="0" max="100" step="0.01" required />
                                <span class="input-group-text">%</span>
                            </div>
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check mb-2">
                                <input id="Edit_IsKnockout" class="form-check-input" type="checkbox" />
                                <label class="form-check-label" for="Edit_IsKnockout">Knockout match</label>
