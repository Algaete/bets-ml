@model CornersPrediction.Web.Models.MatchHistory.MatchHistoryIndexViewModel

@{
    ViewData["Title"] = UiText.T(Context, "MatchHistory.Title");
    var leagueOptions = Model.LeagueOptions
        .OrderBy(league => league)
        .ToArray();
    var teamOptions = Model.TeamOptions
        .OrderBy(team => team.League)
        .ThenBy(team => team.Team)
        .ToArray();
    var bulkTeamOptions = Model.BulkTeamOptions
        .OrderBy(team => team.League)
        .ThenBy(team => team.Team)
        .ToArray();
    var formationOptions = Model.FormationOptions
        .OrderBy(formation => formation)
        .ToArray();
    var records = Model.Records.ToArray();
    var filterTeamOptions = records
        .SelectMany(match => new[] { match.HomeTeam, match.AwayTeam })
        .Where(team => !string.IsNullOrWhiteSpace(team))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(team => team)
        .ToArray();
    var initialHistoryJson = System.Text.Json.JsonSerializer.Serialize(records);
    var hasSelectedLeague = !string.IsNullOrWhiteSpace(Model.Form.League);
    var hasSelectedBulkLeague = !string.IsNullOrWhiteSpace(Model.BulkForm.League);
    var language = UiText.GetLanguage(Context);
    var distinctLeaguesCount = records
        .Select(match => match.League)
        .Where(league => !string.IsNullOrWhiteSpace(league))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();
    var distinctTeamsCount = records
        .SelectMany(match => new[] { match.HomeTeam, match.AwayTeam })
        .Where(team => !string.IsNullOrWhiteSpace(team))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();
    var averageCorners = records.Length == 0
        ? 0
        : records.Average(match => match.TotalCorners);
    var latestRecordDate = records.Length == 0
        ? "-"
        : records.Max(match => match.MatchDate).ToString("yyyy-MM-dd");
    var cornersObserved = records.Count(match => match.HomeCorners + match.AwayCorners > 0);
    var shotsObserved = records.Count(match => match.HomeShots + match.AwayShots > 0);
    var sogObserved = records.Count(match => match.HomeShotsOnGoal + match.AwayShotsOnGoal > 0);
    decimal Coverage(int count) => records.Length == 0 ? 0 : Math.Round(count * 100m / records.Length, 1);
}

<div class="betting-hero match-history-hero mb-4">
    <div>
        <div class="text-muted small text-uppercase fw-semibold">Data operations</div>
        <h1 class="h3 mb-1">@UiText.T(language, "MatchHistory.Title")</h1>
        <p class="text-muted mb-0">@UiText.T(language, "MatchHistory.Description")</p>
    </div>
    <span id="recentMatchesCount" class="badge text-bg-primary match-history-count">@records.Length @UiText.T(language, "MatchHistory.RecordCount")</span>
</div>

<section class="metric-grid match-history-metrics mb-4" aria-label="Match history summary">
    <div class="metric-tile compact">
        <div class="metric-label">Registros visibles</div>
        <div class="metric-value">@records.Length</div>
    </div>
    <div class="metric-tile compact">
        <div class="metric-label">Ligas</div>
        <div class="metric-value">@distinctLeaguesCount</div>
    </div>
    <div class="metric-tile compact">
        <div class="metric-label">Equipos</div>
        <div class="metric-value">@distinctTeamsCount</div>
    </div>
    <div class="metric-tile compact">
        <div class="metric-label">Prom. córners · último partido</div>
        <div class="metric-value">@averageCorners.ToString("0.0") · @latestRecordDate</div>
    </div>
</section>

<section class="surface-panel match-history-quality mb-4" aria-labelledby="MatchHistoryQualityTitle">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div>
            <h2 id="MatchHistoryQualityTitle" class="h6 mb-1">Cobertura aparente de los registros visibles</h2>
            <div class="text-muted small">Mide filas con un total mayor que cero. Sirve como alerta rápida; un 0 legítimo debe verificarse con los flags de disponibilidad del backend.</div>
        </div>
        <span class="badge text-bg-light">@records.Length registros analizados</span>
    </div>
    <div class="match-history-quality-grid">
        <div><span>Córners</span><strong>@Coverage(cornersObserved)%</strong><div class="progress"><div class="progress-bar" style="width:@Coverage(cornersObserved).ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div></div><small>@cornersObserved de @records.Length con valor</small></div>
        <div><span>Tiros</span><strong>@Coverage(shotsObserved)%</strong><div class="progress"><div class="progress-bar" style="width:@Coverage(shotsObserved).ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div></div><small>@shotsObserved de @records.Length con valor</small></div>
        <div><span>Tiros al arco</span><strong>@Coverage(sogObserved)%</strong><div class="progress"><div class="progress-bar" style="width:@Coverage(sogObserved).ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div></div><small>@sogObserved de @records.Length con valor</small></div>
    </div>
</section>

<nav class="match-history-workspace-nav mb-4" aria-label="Herramientas de MatchHistory">
    <a href="#MatchHistoryRecords">Explorar registros</a>
    <a href="#MatchHistoryManual">Agregar manual</a>
    <a href="#MatchHistoryBulk">Importar JSON</a>
</nav>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <div class="col-12 col-xl-5">
        <details id="MatchHistoryManual" class="match-history-operation" open="@(!ViewData.ModelState.IsValid ? "open" : null)">
            <summary><span><strong>Agregar partido manualmente</strong><small>Úsalo cuando API-Football todavía no haya insertado el resultado.</small></span><span>Abrir formulario</span></summary>
        <div class="surface-panel match-history-panel">
            <div class="match-history-panel-header">
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Single entry</div>
                    <h2 class="h5 mb-0">@UiText.T(language, "MatchHistory.AddMatch")</h2>
                </div>
            </div>
            <div>
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    @if (leagueOptions.Length == 0)
                    {
                        <div class="alert alert-warning">
                            League dropdown data could not be loaded from the backend. Check that the API is running and that sp_GetMatchHistoryLeagues exists in SQL Server.
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Form.League" class="form-label"></label>
                            <select asp-for="Form.League" class="form-select">
                                <option value="">Select league</option>
                                @foreach (var league in leagueOptions)
                                {
                                    <option value="@league">@league</option>
                                }
                            </select>
                            <span asp-validation-for="Form.League" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Form.Season" class="form-label"></label>
                            <input asp-for="Form.Season" class="form-control" />
                            <span asp-validation-for="Form.Season" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Form.MatchDate" class="form-label"></label>
                            <input asp-for="Form.MatchDate" class="form-control" />
                            <span asp-validation-for="Form.MatchDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check mb-2">
                                <input asp-for="Form.IsKnockout" class="form-check-input" />
                                <label asp-for="Form.IsKnockout" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <h3 class="h6 mb-3">Teams</h3>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Form.HomeTeam" class="form-label"></label>
                                <select asp-for="Form.HomeTeam" class="form-select" disabled="@(!hasSelectedLeague)">
                                    <option value="">@(hasSelectedLeague ? "Select home team" : "Select league first")</option>
                                    @foreach (var team in teamOptions)
                                    {
                                        var teamContext = string.Join(" - ", new[] { team.League, team.Season }.Where(value => !string.IsNullOrWhiteSpace(value)));
                                        <option value="@team.Team">
                                            @team.Team@(string.IsNullOrWhiteSpace(teamContext) ? "" : $" ({teamContext})")@(team.IsBig3 ? " - Big3" : "")
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="Form.HomeTeam" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Form.AwayTeam" class="form-label"></label>
                                <select asp-for="Form.AwayTeam" class="form-select" disabled="@(!hasSelectedLeague)">
                                    <option value="">@(hasSelectedLeague ? "Select away team" : "Select league first")</option>
                                    @foreach (var team in teamOptions)
                                    {
                                        var teamContext = string.Join(" - ", new[] { team.League, team.Season }.Where(value => !string.IsNullOrWhiteSpace(value)));
                                        <option value="@team.Team">
                                            @team.Team@(string.IsNullOrWhiteSpace(teamContext) ? "" : $" ({teamContext})")@(team.IsBig3 ? " - Big3" : "")
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="Form.AwayTeam" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Form.HomeFormation" class="form-label"></label>
                                <input asp-for="Form.HomeFormation" class="form-control" list="FormationOptions" placeholder="4-3-3" autocomplete="off" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Form.AwayFormation" class="form-label"></label>
                                <input asp-for="Form.AwayFormation" class="form-control" list="FormationOptions" placeholder="4-2-3-1" autocomplete="off" />
                            </div>
                            <datalist id="FormationOptions">
                                @foreach (var formation in formationOptions)
                                {
                                    <option value="@formation"></option>
                                }
                            </datalist>
                        </div>
                    </div>

                    <div class="form-section">
                        <h3 class="h6 mb-3">Result and corners</h3>
                        <div class="row g-3">
                            <div class="col-6 col-md-3">
                                <label asp-for="Form.HomeGoals" class="form-label"></label>
                                <input asp-for="Form.HomeGoals" class="form-control" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label asp-for="Form.AwayGoals" class="form-label"></label>
                                <input asp-for="Form.AwayGoals" class="form-control" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label asp-for="Form.HomeCorners" class="form-label"></label>
                                <input asp-for="Form.HomeCorners" class="form-control" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label asp-for="Form.AwayCorners" class="form-label"></label>
                                <input asp-for="Form.AwayCorners" class="form-control" />
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <h3 class="h6 mb-3">Match stats</h3>
                        <div class="row g-3">
                            <div class="col-6 col-md-3">
                                <label asp-for="Form.HomeShots" class="form-label"></label>
                                <input asp-for="Form.HomeShots" class="form-control" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label asp-for="Form.AwayShots" class="form-label"></label>
                                <input asp-for="Form.AwayShots" class="form-control" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label asp-for="Form.HomeShotsOnGoal" class="form-label"></label>
                                <input asp-for="Form.HomeShotsOnGoal" class="form-control" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label asp-for="Form.AwayShotsOnGoal" class="form-label"></label>
                                <input asp-for="Form.AwayShotsOnGoal" class="form-control" />
                            </div>
                            <div class="col-6">
                                <label asp-for="Form.HomePossession" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="Form.HomePossession" class="form-control" type="number" min="0" max="100" step="0.01" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <label asp-for="Form.AwayPossession" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="Form.AwayPossession" class="form-control" type="number" min="0" max="100" step="0.01" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary">@UiText.T(language, "MatchHistory.SaveMatch")</button>
                    </div>
                </form>
            </div>
        </div>
        </details>

        <details id="MatchHistoryBulk" class="match-history-operation mt-3" open="@(Model.BulkResult is not null ? "open" : null)">
            <summary><span><strong>Importación masiva</strong><small>Construye y valida varios partidos antes de enviarlos.</small></span><span>Abrir importador</span></summary>
        <div class="surface-panel match-history-panel mt-4">
            <div class="match-history-panel-header">
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Bulk loader</div>
                    <h2 class="h5 mb-0">Bulk JSON import</h2>
                </div>
                <span class="badge text-bg-light">JSON</span>
            </div>
            <div>
                <form asp-action="BulkCreate" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="BulkForm.League" class="form-label"></label>
                            <select asp-for="BulkForm.League" class="form-select">
                                <option value="">Select league</option>
                                @foreach (var league in leagueOptions)
                                {
                                    <option value="@league">@league</option>
                                }
                            </select>
                            <span asp-validation-for="BulkForm.League" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BulkForm.Season" class="form-label"></label>
                            <input asp-for="BulkForm.Season" class="form-control" />
                            <span asp-validation-for="BulkForm.Season" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BulkForm.TeamGender" class="form-label"></label>
                            <select asp-for="BulkForm.TeamGender" class="form-select">
                                <option value="M">Masculino</option>
                                <option value="F">Femenino</option>
                                <option value="U">Unknown</option>
                            </select>
                            <span asp-validation-for="BulkForm.TeamGender" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BulkForm.FocusTeam" class="form-label"></label>
                            <select asp-for="BulkForm.FocusTeam" class="form-select" disabled="@(!hasSelectedBulkLeague)">
                                <option value="">@(hasSelectedBulkLeague ? "Select team" : "Select league first")</option>
                                @foreach (var team in bulkTeamOptions)
                                {
                                    var teamContext = string.Join(" - ", new[] { team.League, team.Season }.Where(value => !string.IsNullOrWhiteSpace(value)));
                                    <option value="@team.Team">
                                        @team.Team@(string.IsNullOrWhiteSpace(teamContext) ? "" : $" ({teamContext})")@(team.IsBig3 ? " - Big3" : "")
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="BulkForm.FocusTeam" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="BulkForm.IsKnockout" class="form-check-input" />
                                <label asp-for="BulkForm.IsKnockout" class="form-check-label"></label>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="bulk-json-builder mb-3">
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                                    <div>
                                        <div class="text-muted small text-uppercase fw-semibold">JSON builder</div>
                                        <h3 class="h6 mb-0">Armar partido sin escribir JSON</h3>
                                    </div>
                                    <span id="BulkJsonCount" class="badge text-bg-light">0 partidos</span>
                                </div>

                                <div class="row g-2 align-items-end">
                                    <div class="col-md-4">
                                        <label class="form-label" for="BulkBuilder_MatchDate">Fecha</label>
                                        <input id="BulkBuilder_MatchDate" class="form-control" type="date" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label" for="BulkBuilder_HomeTeam">Local</label>
                                        <input id="BulkBuilder_HomeTeam" class="form-control" list="BulkBuilderTeamOptions" autocomplete="off" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label" for="BulkBuilder_AwayTeam">Visita</label>
                                        <input id="BulkBuilder_AwayTeam" class="form-control" list="BulkBuilderTeamOptions" autocomplete="off" />
                                    </div>
                                    <div class="col-md-3 col-6">
                                        <label class="form-label" for="BulkBuilder_HomeGoals">Goles local</label>
                                        <input id="BulkBuilder_HomeGoals" class="form-control" type="number" min="0" max="30" value="0" />
                                    </div>
                                    <div class="col-md-3 col-6">
                                        <label class="form-label" for="BulkBuilder_AwayGoals">Goles visita</label>
                                        <input id="BulkBuilder_AwayGoals" class="form-control" type="number" min="0" max="30" value="0" />
                                    </div>
                                    <div class="col-md-3 col-6">
                                        <label class="form-label" for="BulkBuilder_HomeCorners">Corners local</label>
                                        <input id="BulkBuilder_HomeCorners" class="form-control" type="number" min="0" max="50" value="0" />
                                    </div>
                                    <div class="col-md-3 col-6">
                                        <label class="form-label" for="BulkBuilder_AwayCorners">Corners visita</label>
                                        <input id="BulkBuilder_AwayCorners" class="form-control" type="number" min="0" max="50" value="0" />
                                    </div>
                                    <div class="col-md-3 col-6">
                                        <label class="form-label" for="BulkBuilder_HomeShots">Tiros local</label>
                                        <input id="BulkBuilder_HomeShots" class="form-control" type="number" min="0" max="80" value="0" />
                                    </div>
                                    <div class="col-md-3 col-6">
                                        <label class="form-label" for="BulkBuilder_AwayShots">Tiros visita</label>
                                        <input id="BulkBuilder_AwayShots" class="form-control" type="number" min="0" max="80" value="0" />
                                    </div>
                                    <div class="col-md-3 col-6">
                                        <label class="form-label" for="BulkBuilder_HomeShotsOnGoal">SOG local</label>
                                        <input id="BulkBuilder_HomeShotsOnGoal" class="form-control" type="number" min="0" max="80" value="0" />
                                    </div>
                                    <div class="col-md-3 col-6">
                                        <label class="form-label" for="BulkBuilder_AwayShotsOnGoal">SOG visita</label>
                                        <input id="BulkBuilder_AwayShotsOnGoal" class="form-control" type="number" min="0" max="80" value="0" />
                                    </div>
                                    <div class="col-md-3 col-6">
                                        <label class="form-label" for="BulkBuilder_HomePossession">Pos. local</label>
                                        <div class="input-group">
                                            <input id="BulkBuilder_HomePossession" class="form-control" type="number" min="0" max="100" step="0.01" value="50" />
                                            <span class="input-group-text">%</span>
                                        </div>
                                    </div>
                                    <div class="col-md-3 col-6">
                                        <label class="form-label" for="BulkBuilder_AwayPossession">Pos. visita</label>
                                        <div class="input-group">
                                            <input id="BulkBuilder_AwayPossession" class="form-control" type="number" min="0" max="100" step="0.01" value="50" />
                                            <span class="input-group-text">%</span>
                                        </div>
                                    </div>
                                    <div class="col-md-3 col-6">
                                        <label class="form-label" for="BulkBuilder_HomeFormation">Form. local</label>
                                        <input id="BulkBuilder_HomeFormation" class="form-control" list="FormationOptions" placeholder="4-3-3" autocomplete="off" />
                                    </div>
                                    <div class="col-md-3 col-6">
                                        <label class="form-label" for="BulkBuilder_AwayFormation">Form. visita</label>
                                        <input id="BulkBuilder_AwayFormation" class="form-control" list="FormationOptions" placeholder="4-2-3-1" autocomplete="off" />
                                    </div>
                                </div>

                                <datalist id="BulkBuilderTeamOptions">
                                    @foreach (var team in bulkTeamOptions)
                                    {
                                        <option value="@team.Team"></option>
                                    }
                                </datalist>

                                <div class="d-flex flex-wrap gap-2 mt-3">
                                    <button id="BulkJsonAddMatch" type="button" class="btn btn-sm btn-primary">Agregar al JSON</button>
                                    <button id="BulkJsonUseSingle" type="button" class="btn btn-sm btn-outline-primary">Reemplazar JSON con este partido</button>
                                    <button id="BulkJsonFormat" type="button" class="btn btn-sm btn-outline-secondary">Formatear / validar</button>
                                    <button id="BulkJsonClear" type="button" class="btn btn-sm btn-outline-danger">Vaciar JSON</button>
                                </div>
                                <div id="BulkJsonBuilderStatus" class="small text-muted mt-2">Listo para armar el primer partido.</div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <label asp-for="BulkForm.MatchesJson" class="form-label mb-0"></label>
                                <span class="text-muted small">Puedes editarlo manualmente si necesitas.</span>
                            </div>
                            <textarea asp-for="BulkForm.MatchesJson"
                                      class="form-control font-monospace"
                                      rows="12"
                                      spellcheck="false"
                                      placeholder='[{"matchDate":"2026-06-07","homeTeam":"Colombia","awayTeam":"Jordan","homeCorners":3,"awayCorners":1}]'></textarea>
                            <span asp-validation-for="BulkForm.MatchesJson" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-outline-primary">Import matches JSON</button>
                    </div>
                </form>

                @if (Model.BulkResult is not null)
                {
                    <div class="border-top mt-4 pt-4">
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <span class="badge text-bg-primary">@Model.BulkResult.InsertedCount inserted</span>
                            <span class="badge text-bg-warning">@Model.BulkResult.DuplicateCount duplicates</span>
                            <span class="badge text-bg-danger">@Model.BulkResult.ErrorCount errors</span>
                        </div>
                        <div class="table-responsive" style="max-height: 320px;">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Date</th>
                                        <th>Match</th>
                                        <th>Status</th>
                                        <th>Message</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Model.BulkResult.Rows)
                                    {
                                        var badgeClass = row.Status.Equals("Inserted", StringComparison.OrdinalIgnoreCase)
                                            ? "text-bg-success"
                                            : row.Status.Equals("Duplicate", StringComparison.OrdinalIgnoreCase)
                                                ? "text-bg-warning"
                                                : "text-bg-danger";
                                        <tr>
                                            <td>@row.RowNumber</td>
                                            <td class="text-nowrap">@row.MatchDate?.ToString("yyyy-MM-dd")</td>
                                            <td>@row.HomeTeam vs @row.AwayTeam</td>
                                            <td><span class="badge @badgeClass">@row.Status</span></td>
                                            <td class="small">@row.Message</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>
        </details>
    </div>

    <div class="col-12 col-xl-7">
        <div id="MatchHistoryRecords" class="surface-panel match-history-panel match-history-records-panel">
            <div class="match-history-panel-header">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Explorador local</div>
                        <h2 class="h5 mb-1">@UiText.T(language, "MatchHistory.SavedRecords")</h2>
                        <div class="text-muted small">Últimos registros disponibles según los filtros. Un cero no se interpreta automáticamente como dato confirmado.</div>
                    </div>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Index">Limpiar</a>
                </div>
            </div>
            <div class="match-history-filter-bar">
                <form method="get" class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label" for="FilterLeague">Liga</label>
                        <input id="FilterLeague" name="League" class="form-control" list="LeagueOptions" value="@Model.Filters.League" placeholder="Todas las ligas" autocomplete="off" />
                        <datalist id="LeagueOptions">
                            @foreach (var league in leagueOptions)
                            {
                                <option value="@league"></option>
                            }
                        </datalist>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label" for="FilterTeam">Equipo</label>
                        <input id="FilterTeam" name="Team" class="form-control" list="FilterTeamOptions" value="@Model.Filters.Team" placeholder="Local o visitante" autocomplete="off" />
                        <datalist id="FilterTeamOptions">
                            @foreach (var team in filterTeamOptions)
                            {
                                <option value="@team"></option>
                            }
                        </datalist>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="FilterTake">Cantidad</label>
                        <input id="FilterTake" name="Take" class="form-control" type="number" min="1" max="100" value="@Model.Filters.Take" />
                    </div>
                    <div class="col-12 d-flex justify-content-end gap-2">
                        <a class="btn btn-outline-secondary" asp-action="Index">Restablecer</a>
                        <button class="btn btn-outline-primary" type="submit">Buscar</button>
                    </div>
                </form>
            </div>
            <div class="match-history-table-shell">
                <div id="recordsEmpty" class="empty-state @(records.Length == 0 ? "" : "d-none")">
                    <div class="fw-semibold">No se encontraron partidos</div>
                    <div class="text-muted small">Cambia los filtros o utiliza la importación JSON.</div>
                </div>
                <div id="recordsTableWrap" class="table-responsive @(records.Length == 0 ? "d-none" : "")">
                    <table class="table table-sm align-middle mb-0 table-sticky-head match-history-table">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Partido</th>
                                <th>Marcador</th>
                                <th>Córners</th>
                                <th>Tiros / al arco</th>
                                <th>Posesión</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="recordsBody">
                            @foreach (var match in records)
                            {
                                <tr>
                                    <td class="text-nowrap">@match.MatchDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <div class="fw-semibold">@match.HomeTeam vs @match.AwayTeam</div>
                                        <div class="text-muted small">
                                            @match.League · @match.Season@(match.IsKnockout ? " · Knockout" : "")
                                        </div>
                                    </td>
                                    <td><span class="badge text-bg-light stat-pill">@match.HomeGoals - @match.AwayGoals</span></td>
                                    <td>
                                        <span class="badge text-bg-primary stat-pill">@match.HomeCorners - @match.AwayCorners</span>
                                        <div class="small text-muted">Total @match.TotalCorners</div>
                                    </td>
                                    <td class="text-nowrap">
                                        <div>@match.HomeShots - @match.AwayShots</div>
                                        <div class="small text-muted">Al arco @match.HomeShotsOnGoal - @match.AwayShotsOnGoal</div>
                                    </td>
                                    <td class="text-nowrap">@match.HomePossession.ToString("0.#")% - @match.AwayPossession.ToString("0.#")%</td>
                                    <td class="text-end text-nowrap">
                                        <button type="button" class="btn btn-sm btn-outline-primary" data-action="edit" data-id="@match.Id">Editar</button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" data-action="delete" data-id="@match.Id">Eliminar</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editMatchModal" tabindex="-1" aria-labelledby="editMatchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <form id="editMatchForm">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="editMatchModalLabel">Edit match</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="Edit_Id" />

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label" for="Edit_League">League</label>
                            <input id="Edit_League" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="Edit_Season">Season</label>
                            <input id="Edit_Season" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="Edit_MatchDate">Match date</label>
                            <input id="Edit_MatchDate" class="form-control" type="date" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="Edit_HomeTeam">Home team</label>
                            <input id="Edit_HomeTeam" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="Edit_AwayTeam">Away team</label>
                            <input id="Edit_AwayTeam" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="Edit_HomeFormation">Home formation</label>
                            <input id="Edit_HomeFormation" class="form-control" list="FormationOptions" autocomplete="off" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="Edit_AwayFormation">Away formation</label>
                            <input id="Edit_AwayFormation" class="form-control" list="FormationOptions" autocomplete="off" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="Edit_HomeGoals">Home goals</label>
                            <input id="Edit_HomeGoals" class="form-control" type="number" min="0" max="30" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="Edit_AwayGoals">Away goals</label>
