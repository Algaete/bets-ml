            const addHomeWindowFeatures = (features, matches, count) => {
                const window = take(matches, count);
                features[`Home_AvgCornersForLast${count}`] = average(window.map(match => getValue(match, 'HomeCorners')));
                features[`Home_AvgCornersAgainstLast${count}`] = average(window.map(match => getValue(match, 'AwayCorners')));
                features[`Home_AvgCornersForLast${count}_HomeOnly`] = features[`Home_AvgCornersForLast${count}`];
                features[`Home_AvgCornersAgainstLast${count}_HomeOnly`] = features[`Home_AvgCornersAgainstLast${count}`];
                features[`Home_AvgGoalsForLast${count}`] = average(window.map(match => getHomeGoals(match)));
                features[`Home_AvgGoalsAgainstLast${count}`] = average(window.map(match => getAwayGoals(match)));
                features[`Home_AvgGoalsForLast${count}_HomeOnly`] = features[`Home_AvgGoalsForLast${count}`];
                features[`Home_AvgGoalsAgainstLast${count}_HomeOnly`] = features[`Home_AvgGoalsAgainstLast${count}`];
                features[`Home_AvgShotsLast${count}`] = average(window.map(match => getValue(match, 'HomeShots')));
                features[`Home_AvgShotsOnGoalLast${count}`] = average(window.map(match => getValue(match, 'HomeShotsOnGoal')));
                features[`Home_AvgPossessionLast${count}`] = average(window.map(match => getValue(match, 'HomePossession')));
            };

            const addAwayWindowFeatures = (features, matches, count) => {
                const window = take(matches, count);
                features[`Away_AvgCornersForLast${count}`] = average(window.map(match => getValue(match, 'AwayCorners')));
                features[`Away_AvgCornersAgainstLast${count}`] = average(window.map(match => getValue(match, 'HomeCorners')));
                features[`Away_AvgCornersForLast${count}_AwayOnly`] = features[`Away_AvgCornersForLast${count}`];
                features[`Away_AvgCornersAgainstLast${count}_AwayOnly`] = features[`Away_AvgCornersAgainstLast${count}`];
                features[`Away_AvgGoalsForLast${count}`] = average(window.map(match => getAwayGoals(match)));
                features[`Away_AvgGoalsAgainstLast${count}`] = average(window.map(match => getHomeGoals(match)));
                features[`Away_AvgGoalsForLast${count}_AwayOnly`] = features[`Away_AvgGoalsForLast${count}`];
                features[`Away_AvgGoalsAgainstLast${count}_AwayOnly`] = features[`Away_AvgGoalsAgainstLast${count}`];
                features[`Away_AvgShotsLast${count}`] = average(window.map(match => getValue(match, 'AwayShots')));
                features[`Away_AvgShotsOnGoalLast${count}`] = average(window.map(match => getValue(match, 'AwayShotsOnGoal')));
                features[`Away_AvgPossessionLast${count}`] = average(window.map(match => getValue(match, 'AwayPossession')));
            };

            const isTeamHomeInMatch = (match, teamName) =>
                normalizeText(getValue(match, 'HomeTeam')) === normalizeText(teamName);

            const isTeamAwayInMatch = (match, teamName) =>
                normalizeText(getValue(match, 'AwayTeam')) === normalizeText(teamName);

            const getTeamMetric = (match, teamName, metric) => {
                if (isTeamHomeInMatch(match, teamName)) {
                    return Number(getValue(match, `Home${metric}`) ?? 0);
                }

                if (isTeamAwayInMatch(match, teamName)) {
                    return Number(getValue(match, `Away${metric}`) ?? 0);
                }

                return Number(getValue(match, `Home${metric}`) ?? 0);
            };

            const getOpponentMetric = (match, teamName, metric) => {
                if (isTeamHomeInMatch(match, teamName)) {
                    return Number(getValue(match, `Away${metric}`) ?? 0);
                }

                if (isTeamAwayInMatch(match, teamName)) {
                    return Number(getValue(match, `Home${metric}`) ?? 0);
                }

                return Number(getValue(match, `Away${metric}`) ?? 0);
            };

            const getTeamGoals = (match, teamName) => {
                if (isTeamHomeInMatch(match, teamName)) {
                    return Number(getHomeGoals(match) ?? 0);
                }

                if (isTeamAwayInMatch(match, teamName)) {
                    return Number(getAwayGoals(match) ?? 0);
                }

                return Number(getHomeGoals(match) ?? 0);
            };

            const getOpponentGoals = (match, teamName) => {
                if (isTeamHomeInMatch(match, teamName)) {
                    return Number(getAwayGoals(match) ?? 0);
                }

                if (isTeamAwayInMatch(match, teamName)) {
                    return Number(getHomeGoals(match) ?? 0);
                }

                return Number(getAwayGoals(match) ?? 0);
            };

            const addShotsOnGoalWindowFeatures = (features, prefix, matches, teamName, count) => {
                const window = take(matches, count);
                const cornersFor = window.map(match => getTeamMetric(match, teamName, 'Corners'));
                const cornersAgainst = window.map(match => getOpponentMetric(match, teamName, 'Corners'));
                const shotsFor = window.map(match => getTeamMetric(match, teamName, 'Shots'));
                const shotsAgainst = window.map(match => getOpponentMetric(match, teamName, 'Shots'));
                const shotsOnGoalFor = window.map(match => getTeamMetric(match, teamName, 'ShotsOnGoal'));
                const shotsOnGoalAgainst = window.map(match => getOpponentMetric(match, teamName, 'ShotsOnGoal'));

                features[`${prefix}_AvgCornersForLast${count}`] = average(cornersFor);
                features[`${prefix}_AvgCornersAgainstLast${count}`] = average(cornersAgainst);
                features[`${prefix}_AvgTotalCornersLast${count}`] = round(features[`${prefix}_AvgCornersForLast${count}`] + features[`${prefix}_AvgCornersAgainstLast${count}`]);
                features[`${prefix}_AvgShotsForLast${count}`] = average(shotsFor);
                features[`${prefix}_AvgShotsAgainstLast${count}`] = average(shotsAgainst);
                features[`${prefix}_AvgTotalShotsLast${count}`] = round(features[`${prefix}_AvgShotsForLast${count}`] + features[`${prefix}_AvgShotsAgainstLast${count}`]);
                features[`${prefix}_AvgShotsOnGoalForLast${count}`] = average(shotsOnGoalFor);
                features[`${prefix}_AvgShotsOnGoalAgainstLast${count}`] = average(shotsOnGoalAgainst);
                features[`${prefix}_AvgTotalShotsOnGoalLast${count}`] = round(features[`${prefix}_AvgShotsOnGoalForLast${count}`] + features[`${prefix}_AvgShotsOnGoalAgainstLast${count}`]);
                features[`${prefix}_AvgPossessionLast${count}`] = average(window.map(match => getTeamMetric(match, teamName, 'Possession')));
                features[`${prefix}_AvgGoalsForLast${count}`] = average(window.map(match => getTeamGoals(match, teamName)));
                features[`${prefix}_AvgGoalsAgainstLast${count}`] = average(window.map(match => getOpponentGoals(match, teamName)));

                if (count === 5) {
                    features[`${prefix}_StdCornersForLast5`] = standardDeviation(cornersFor);
                    features[`${prefix}_RangeCornersForLast5`] = range(cornersFor);
                    features[`${prefix}_StdShotsForLast5`] = standardDeviation(shotsFor);
                    features[`${prefix}_RangeShotsForLast5`] = range(shotsFor);
                    features[`${prefix}_StdShotsOnGoalForLast5`] = standardDeviation(shotsOnGoalFor);
                    features[`${prefix}_RangeShotsOnGoalForLast5`] = range(shotsOnGoalFor);
                }
            };

            const addShotsOnGoalConditionFeatures = (features, prefix, contextName, matches, teamName) => {
                const window = take(matches, 10);
                features[`${prefix}_${contextName}AvgCornersForLast10`] = average(window.map(match => getTeamMetric(match, teamName, 'Corners')));
                features[`${prefix}_${contextName}AvgCornersAgainstLast10`] = average(window.map(match => getOpponentMetric(match, teamName, 'Corners')));
                features[`${prefix}_${contextName}AvgTotalCornersLast10`] = round(features[`${prefix}_${contextName}AvgCornersForLast10`] + features[`${prefix}_${contextName}AvgCornersAgainstLast10`]);
                features[`${prefix}_${contextName}AvgShotsForLast10`] = average(window.map(match => getTeamMetric(match, teamName, 'Shots')));
                features[`${prefix}_${contextName}AvgShotsAgainstLast10`] = average(window.map(match => getOpponentMetric(match, teamName, 'Shots')));
                features[`${prefix}_${contextName}AvgTotalShotsLast10`] = round(features[`${prefix}_${contextName}AvgShotsForLast10`] + features[`${prefix}_${contextName}AvgShotsAgainstLast10`]);
                features[`${prefix}_${contextName}AvgShotsOnGoalForLast10`] = average(window.map(match => getTeamMetric(match, teamName, 'ShotsOnGoal')));
                features[`${prefix}_${contextName}AvgShotsOnGoalAgainstLast10`] = average(window.map(match => getOpponentMetric(match, teamName, 'ShotsOnGoal')));
                features[`${prefix}_${contextName}AvgTotalShotsOnGoalLast10`] = round(features[`${prefix}_${contextName}AvgShotsOnGoalForLast10`] + features[`${prefix}_${contextName}AvgShotsOnGoalAgainstLast10`]);
                features[`${prefix}_${contextName}AvgPossessionLast10`] = average(window.map(match => getTeamMetric(match, teamName, 'Possession')));
            };

            const buildShotsOnGoalFeatures = () => {
                const homeTeam = homeTeamSelect.value.trim();
                const awayTeam = awayTeamSelect.value.trim();
                const homeBig3 = getBig3Flag(homeTeam);
                const awayBig3 = getBig3Flag(awayTeam);

                const features = {
                    league: leagueSelect.value.trim(),
                    season: seasonInput.value.trim(),
                    homeTeam,
                    awayTeam,
                    homeFormation: homeFormationInput.value.trim() || 'UNKNOWN',
                    awayFormation: awayFormationInput.value.trim() || 'UNKNOWN',
                    homeHasFormation: homeFormationInput.value.trim() ? 1 : 0,
                    awayHasFormation: awayFormationInput.value.trim() ? 1 : 0,
                    big3home: homeBig3,
                    big3away: awayBig3,
                    big3Diff: homeBig3 - awayBig3,
                    isKnockout: isKnockoutInput.checked ? 1 : 0,
                    shotsLine: Number(shotsLineInput.value || 0),
                    sogLine: Number(sogLineInput.value || 0),
                    goalsLine: Number(goalsLineInput.value || 0),
                    homeIsCountry: 0,
                    awayIsCountry: 0,
                    countryDiff: 0
                };

                features.home_MatchesLast3 = take(currentHomeGeneralMatches, 3).length;
                features.away_MatchesLast3 = take(currentAwayGeneralMatches, 3).length;
                features.home_MatchesLast5 = take(currentHomeGeneralMatches, 5).length;
                features.away_MatchesLast5 = take(currentAwayGeneralMatches, 5).length;
                features.home_HomeMatchesLast10 = take(currentHomeConditionMatches, 10).length;
                features.away_AwayMatchesLast10 = take(currentAwayConditionMatches, 10).length;

                addShotsOnGoalWindowFeatures(features, 'home', currentHomeGeneralMatches, homeTeam, 3);
                addShotsOnGoalWindowFeatures(features, 'away', currentAwayGeneralMatches, awayTeam, 3);
                addShotsOnGoalWindowFeatures(features, 'home', currentHomeGeneralMatches, homeTeam, 5);
                addShotsOnGoalWindowFeatures(features, 'away', currentAwayGeneralMatches, awayTeam, 5);
                addShotsOnGoalConditionFeatures(features, 'home', 'Home', currentHomeConditionMatches, homeTeam);
                addShotsOnGoalConditionFeatures(features, 'away', 'Away', currentAwayConditionMatches, awayTeam);

                features.homeCornersPowerLast5 = round((features.home_AvgCornersForLast5 + features.away_AvgCornersAgainstLast5) / 2);
                features.awayCornersPowerLast5 = round((features.away_AvgCornersForLast5 + features.home_AvgCornersAgainstLast5) / 2);
                features.expectedTotalCornersPowerLast5 = round(features.homeCornersPowerLast5 + features.awayCornersPowerLast5);
                features.cornersDiffLast5 = round(features.home_AvgCornersForLast5 - features.away_AvgCornersForLast5);
                features.totalStdCornersLast5 = round(features.home_StdCornersForLast5 + features.away_StdCornersForLast5);
                features.totalRangeCornersLast5 = round(features.home_RangeCornersForLast5 + features.away_RangeCornersForLast5);
                features.homeShotsPowerLast5 = round((features.home_AvgShotsForLast5 + features.away_AvgShotsAgainstLast5) / 2);
                features.awayShotsPowerLast5 = round((features.away_AvgShotsForLast5 + features.home_AvgShotsAgainstLast5) / 2);
                features.expectedTotalShotsPowerLast5 = round(features.homeShotsPowerLast5 + features.awayShotsPowerLast5);
                features.shotsDiffLast5 = round(features.home_AvgShotsForLast5 - features.away_AvgShotsForLast5);
                features.totalStdShotsLast5 = round(features.home_StdShotsForLast5 + features.away_StdShotsForLast5);
                features.totalRangeShotsLast5 = round(features.home_RangeShotsForLast5 + features.away_RangeShotsForLast5);
                features.homeShotsOnGoalPowerLast5 = round((features.home_AvgShotsOnGoalForLast5 + features.away_AvgShotsOnGoalAgainstLast5) / 2);
                features.awayShotsOnGoalPowerLast5 = round((features.away_AvgShotsOnGoalForLast5 + features.home_AvgShotsOnGoalAgainstLast5) / 2);
                features.expectedTotalShotsOnGoalPowerLast5 = round(features.homeShotsOnGoalPowerLast5 + features.awayShotsOnGoalPowerLast5);
                features.shotsOnGoalDiffLast5 = round(features.home_AvgShotsOnGoalForLast5 - features.away_AvgShotsOnGoalForLast5);
                features.totalStdShotsOnGoalLast5 = round(features.home_StdShotsOnGoalForLast5 + features.away_StdShotsOnGoalForLast5);
                features.totalRangeShotsOnGoalLast5 = round(features.home_RangeShotsOnGoalForLast5 + features.away_RangeShotsOnGoalForLast5);
                features.homeGoalsPowerLast5 = round((features.home_AvgGoalsForLast5 + features.away_AvgGoalsAgainstLast5) / 2);
                features.awayGoalsPowerLast5 = round((features.away_AvgGoalsForLast5 + features.home_AvgGoalsAgainstLast5) / 2);
                features.expectedTotalGoalsPowerLast5 = round(features.homeGoalsPowerLast5 + features.awayGoalsPowerLast5);
                features.possessionDiffLast5 = round(features.home_AvgPossessionLast5 - features.away_AvgPossessionLast5);
                features.goalsForDiffLast5 = round(features.home_AvgGoalsForLast5 - features.away_AvgGoalsForLast5);
                features.goalsAgainstDiffLast5 = round(features.home_AvgGoalsAgainstLast5 - features.away_AvgGoalsAgainstLast5);

                return features;
            };

            const buildFeatures = () => {
                const homeTeam = homeTeamSelect.value.trim();
                const awayTeam = awayTeamSelect.value.trim();
                const homeBig3 = getBig3Flag(homeTeam);
                const awayBig3 = getBig3Flag(awayTeam);
                const addOptionalInt = (target, key, input) => {
                    const value = input.value.trim();
                    if (value) {
                        target[key] = Number.parseInt(value, 10);
                    }
                };
                const addOptionalText = (target, key, input) => {
                    const value = input.value.trim();
                    if (value) {
                        target[key] = value;
                    }
                };
                const features = {
                    League: leagueSelect.value.trim(),
                    Season: seasonInput.value.trim(),
                    HomeTeam: homeTeam,
                    AwayTeam: awayTeam,
                    HomeFormation: homeFormationInput.value.trim() || 'Unknown',
                    AwayFormation: awayFormationInput.value.trim() || 'Unknown',
                    HomeHasFormation: homeFormationInput.value.trim() ? 1 : 0,
                    AwayHasFormation: awayFormationInput.value.trim() ? 1 : 0,
                    big3home: homeBig3,
                    big3away: awayBig3,
                    Big3Diff: homeBig3 - awayBig3,
                    IsKnockout: isKnockoutInput.checked ? 1 : 0,
                    BettingLine: Number(bettingLineInput.value || 0),
                    GoalsLine: Number(goalsLineInput.value || 0),
                    HomeIsCountry: 0,
                    AwayIsCountry: 0,
                    CountryDiff: 0
                };

                addOptionalInt(features, 'HomeRankingPosition', homeRankingPositionInput);
                addOptionalInt(features, 'AwayRankingPosition', awayRankingPositionInput);
                addOptionalInt(features, 'RankingTotalTeams', rankingTotalTeamsInput);
                addOptionalText(features, 'RankingSource', rankingSourceInput);
                addOptionalText(features, 'RankingSeason', rankingSeasonInput);

                features.Home_MatchesLast3 = take(currentHomeGeneralMatches, 3).length;
                features.Away_MatchesLast3 = take(currentAwayGeneralMatches, 3).length;
                features.Home_MatchesLast5 = take(currentHomeGeneralMatches, 5).length;
                features.Away_MatchesLast5 = take(currentAwayGeneralMatches, 5).length;
                features.Home_HomeMatchesLast10 = take(currentHomeConditionMatches, 10).length;
                features.Away_AwayMatchesLast10 = take(currentAwayConditionMatches, 10).length;

                addShotsOnGoalWindowFeatures(features, 'Home', currentHomeGeneralMatches, homeTeam, 3);
                addShotsOnGoalWindowFeatures(features, 'Away', currentAwayGeneralMatches, awayTeam, 3);
                addShotsOnGoalWindowFeatures(features, 'Home', currentHomeGeneralMatches, homeTeam, 5);
                addShotsOnGoalWindowFeatures(features, 'Away', currentAwayGeneralMatches, awayTeam, 5);
                addShotsOnGoalConditionFeatures(features, 'Home', 'Home', currentHomeConditionMatches, homeTeam);
                addShotsOnGoalConditionFeatures(features, 'Away', 'Away', currentAwayConditionMatches, awayTeam);

                features.HomeCornersPowerLast5 = round((features.Home_AvgCornersForLast5 + features.Away_AvgCornersAgainstLast5) / 2);
                features.AwayCornersPowerLast5 = round((features.Away_AvgCornersForLast5 + features.Home_AvgCornersAgainstLast5) / 2);
                features.ExpectedTotalCornersPowerLast5 = round(features.HomeCornersPowerLast5 + features.AwayCornersPowerLast5);
                features.CornersDiffLast5 = round(features.Home_AvgCornersForLast5 - features.Away_AvgCornersForLast5);
                features.TotalStdCornersLast5 = round(features.Home_StdCornersForLast5 + features.Away_StdCornersForLast5);
                features.TotalRangeCornersLast5 = round(features.Home_RangeCornersForLast5 + features.Away_RangeCornersForLast5);
                features.HomeShotsPowerLast5 = round((features.Home_AvgShotsForLast5 + features.Away_AvgShotsAgainstLast5) / 2);
                features.AwayShotsPowerLast5 = round((features.Away_AvgShotsForLast5 + features.Home_AvgShotsAgainstLast5) / 2);
                features.ExpectedTotalShotsPowerLast5 = round(features.HomeShotsPowerLast5 + features.AwayShotsPowerLast5);
                features.ShotsDiffLast5 = round(features.Home_AvgShotsForLast5 - features.Away_AvgShotsForLast5);
                features.TotalStdShotsLast5 = round(features.Home_StdShotsForLast5 + features.Away_StdShotsForLast5);
                features.TotalRangeShotsLast5 = round(features.Home_RangeShotsForLast5 + features.Away_RangeShotsForLast5);
                features.HomeShotsOnGoalPowerLast5 = round((features.Home_AvgShotsOnGoalForLast5 + features.Away_AvgShotsOnGoalAgainstLast5) / 2);
                features.AwayShotsOnGoalPowerLast5 = round((features.Away_AvgShotsOnGoalForLast5 + features.Home_AvgShotsOnGoalAgainstLast5) / 2);
                features.ExpectedTotalShotsOnGoalPowerLast5 = round(features.HomeShotsOnGoalPowerLast5 + features.AwayShotsOnGoalPowerLast5);
                features.ShotsOnGoalDiffLast5 = round(features.Home_AvgShotsOnGoalForLast5 - features.Away_AvgShotsOnGoalForLast5);
                features.TotalStdShotsOnGoalLast5 = round(features.Home_StdShotsOnGoalForLast5 + features.Away_StdShotsOnGoalForLast5);
                features.TotalRangeShotsOnGoalLast5 = round(features.Home_RangeShotsOnGoalForLast5 + features.Away_RangeShotsOnGoalForLast5);
                features.HomeGoalsPowerLast5 = round((features.Home_AvgGoalsForLast5 + features.Away_AvgGoalsAgainstLast5) / 2);
                features.AwayGoalsPowerLast5 = round((features.Away_AvgGoalsForLast5 + features.Home_AvgGoalsAgainstLast5) / 2);
                features.ExpectedTotalGoalsPowerLast5 = round(features.HomeGoalsPowerLast5 + features.AwayGoalsPowerLast5);
                features.PossessionDiffLast5 = round(features.Home_AvgPossessionLast5 - features.Away_AvgPossessionLast5);
                features.GoalsForDiffLast5 = round(features.Home_AvgGoalsForLast5 - features.Away_AvgGoalsForLast5);
                features.GoalsAgainstDiffLast5 = round(features.Home_AvgGoalsAgainstLast5 - features.Away_AvgGoalsAgainstLast5);

                return features;
            };

            const loadTeams = async () => {
                const league = leagueSelect.value.trim();
                const teamGender = teamGenderSelect.value || 'M';
                const teamRequestKey = `${league}|${teamGender}`;

                if (league && teamRequestKey === lastLoadedLeague && currentTeams.length > 0) {
                    return;
                }

                resetPrediction();
                predictButton.disabled = true;
                currentFeatures = null;
                currentHomeGeneralMatches = [];
                currentHomeConditionMatches = [];
                currentAwayGeneralMatches = [];
                currentAwayConditionMatches = [];
                currentPredictionContext = null;
                currentTeams = [];
                homeTeamSelect.value = '';
                awayTeamSelect.value = '';
                currentShotsOnGoalFeatures = null;
                clearAutofilledFormation(homeFormationInput);
                clearAutofilledFormation(awayFormationInput);
                resetHistoryDisplay();

                if (!league) {
                    setTeamOptions(homeTeamOptions, []);
                    setTeamOptions(awayTeamOptions, []);
                    homeTeamSelect.disabled = true;
                    awayTeamSelect.disabled = true;
                    homeTeamSelect.placeholder = 'Select league first';
                    awayTeamSelect.placeholder = 'Select league first';
                    historyStatusBadge.textContent = 'Waiting for teams';
                    lastLoadedLeague = '';
                    return;
                }

                teamRequestController?.abort();
                teamRequestController = new AbortController();
                setTeamOptions(homeTeamOptions, []);
                setTeamOptions(awayTeamOptions, []);
                homeTeamSelect.placeholder = 'Loading teams...';
                awayTeamSelect.placeholder = 'Loading teams...';
                homeTeamSelect.disabled = true;
                awayTeamSelect.disabled = true;

                try {
                    const response = await fetch(`/MatchHistory/TeamOptions?league=${encodeURIComponent(league)}&teamGender=${encodeURIComponent(teamGender)}`, {
                        signal: teamRequestController.signal
                    });

                    if (!response.ok) {
                        throw new Error(`Team options request failed with ${response.status}`);
                    }

                    const teams = await response.json();
                    currentTeams = teams;
                    setTeamOptions(homeTeamOptions, teams);
                    setTeamOptions(awayTeamOptions, teams);
                    homeTeamSelect.placeholder = 'Search or select home team';
                    awayTeamSelect.placeholder = 'Search or select away team';
                    homeTeamSelect.disabled = false;
                    awayTeamSelect.disabled = false;
                    lastLoadedLeague = teamRequestKey;
                } catch (error) {
                    if (error.name === 'AbortError') {
                        return;
                    }

                    setTeamOptions(homeTeamOptions, []);
                    setTeamOptions(awayTeamOptions, []);
                    homeTeamSelect.placeholder = 'Teams unavailable';
                    awayTeamSelect.placeholder = 'Teams unavailable';
                }
            };

            const loadHistory = async (force = false) => {
                resetPrediction();
                const homeTeam = homeTeamSelect.value.trim();
                const awayTeam = awayTeamSelect.value.trim();
                const league = leagueSelect.value.trim();
                const teamGender = teamGenderSelect.value || 'M';
                const requestKey = `${league}|${teamGender}|${homeTeam}|${awayTeam}`;

                if (!homeTeam || !awayTeam) {
                    setError('Select both teams before loading history.');
                    return;
                }

                if (homeTeam === awayTeam) {
                    setError('Home team and away team must be different.');
                    return;
                }

                if (!force && requestKey === activeHistoryRequestKey) {
                    historyStatusBadge.textContent = 'History already loading';
                    return;
                }

                if (!force && requestKey === loadedHistoryRequestKey && currentPredictionContext) {
                    return;
                }

                historyRequestController?.abort();
                historyRequestController = new AbortController();
                activeHistoryRequestKey = requestKey;
                historyStatusBadge.textContent = 'Loading history';
                predictButton.disabled = true;
                resetHistoryDisplay();

                try {
                    const response = await fetch(`/MatchHistory/PredictionContext?homeTeam=${encodeURIComponent(homeTeam)}&awayTeam=${encodeURIComponent(awayTeam)}&teamGender=${encodeURIComponent(teamGender)}`, {
                        signal: historyRequestController.signal
                    });

                    if (!response.ok) {
                        throw new Error(`History request failed with ${response.status}`);
                    }

                    currentPredictionContext = await response.json();
                    if (!currentPredictionContext) {
                        throw new Error('Prediction context response was empty.');
                    }

                    const summary = getContextValue(currentPredictionContext, 'Summary');
                    currentHomeGeneralMatches = getContextValue(currentPredictionContext, 'HomeGeneralMatches') ?? [];
                    currentHomeConditionMatches = getContextValue(currentPredictionContext, 'HomeAsHomeMatches') ?? [];
                    currentAwayGeneralMatches = getContextValue(currentPredictionContext, 'AwayGeneralMatches') ?? [];
                    currentAwayConditionMatches = getContextValue(currentPredictionContext, 'AwayAsAwayMatches') ?? [];

                    const latestHomeFormation = findLatestFormationFromMatches(currentHomeGeneralMatches, homeTeam);
                    const latestAwayFormation = findLatestFormationFromMatches(currentAwayGeneralMatches, awayTeam);
                    setAutofilledFormation(homeFormationInput, latestHomeFormation?.formation, latestHomeFormation);
                    setAutofilledFormation(awayFormationInput, latestAwayFormation?.formation, latestAwayFormation);

                    renderMatchRows(
                        currentHomeGeneralMatches,
                        historySections.homeGeneral,
                        'No general history found for the home team.',
                        getContextValue(summary, 'HomeGeneral'));
                    renderMatchRows(
                        currentHomeConditionMatches,
                        historySections.homeCondition,
                        'No home-only history found for the home team.',
                        getContextValue(summary, 'HomeAsHome'));
                    renderMatchRows(
                        currentAwayGeneralMatches,
                        historySections.awayGeneral,
                        'No general history found for the away team.',
                        getContextValue(summary, 'AwayGeneral'));
                    renderMatchRows(
                        currentAwayConditionMatches,
                        historySections.awayCondition,
                        'No away-only history found for the away team.',
                        getContextValue(summary, 'AwayAsAway'));

                    currentFeatures = buildFeatures();
                    renderFeatures(currentFeatures);
                    renderEnrichedPrediction();
                    predictButton.disabled = currentHomeConditionMatches.length === 0 || currentAwayConditionMatches.length === 0;
                    historyStatusBadge.textContent = `${currentHomeGeneralMatches.length + currentHomeConditionMatches.length + currentAwayGeneralMatches.length + currentAwayConditionMatches.length} records loaded`;
                    loadedHistoryRequestKey = requestKey;
                } catch (error) {
                    if (error.name === 'AbortError') {
                        return;
                    }

                    setError('Historical matches could not be loaded.');
                    historyStatusBadge.textContent = 'History unavailable';
                    currentPredictionContext = null;
                } finally {
                    if (activeHistoryRequestKey === requestKey) {
                        activeHistoryRequestKey = '';
                    }
                }
            };

            const predictShotsOnGoal = async () => {
                const features = buildShotsOnGoalFeatures();
                currentShotsOnGoalFeatures = features;
                renderShotsOnGoalFeatures(currentShotsOnGoalFeatures);

                try {
                    const response = await fetch('/Predictions/PredictShots', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(features)
                    });

                    if (!response.ok) {
                        throw new Error('Shots-on-goal model could not be executed.');
                    }

                    const result = await response.json();
                    setShotsOnGoalPrediction(result);
                } catch (error) {
                    console.warn('Shots-on-goal prediction failed:', error);
                    showShotsOnGoalWarning();
                }
            };

            const predict = async () => {
                if (!currentFeatures) {
                    setError('Load history before requesting a prediction.');
                    return;
                }

                currentFeatures = buildFeatures();
                renderFeatures(currentFeatures);
                resetPrediction();
                predictButton.disabled = true;
                predictButton.textContent = 'Predicting...';

                try {
                    const response = await fetch('/Predictions/Predict', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(currentFeatures)
                    });

                    if (!response.ok) {
                        const error = await response.json().catch(() => ({ error: 'Prediction failed.' }));
                        throw new Error(error.error ?? 'Prediction failed.');
                    }

                    const result = await response.json();
                    const totalPrediction = setPrediction(result);
                    await predictShotsOnGoal();
                } catch (error) {
                    setError(error.message);
                } finally {
                    predictButton.disabled = false;
                    predictButton.textContent = 'Predict match';
                }
            };

            const initializePreloadedMatch = async () => {
                const preloadedHomeTeam = homeTeamSelect.dataset.initialValue?.trim() ?? '';
                const preloadedAwayTeam = awayTeamSelect.dataset.initialValue?.trim() ?? '';

                if (!leagueSelect.value.trim()) {
                    return;
                }

                await loadTeams();

                if (preloadedHomeTeam) {
                    homeTeamSelect.value = preloadedHomeTeam;
                }

                if (preloadedAwayTeam) {
                    awayTeamSelect.value = preloadedAwayTeam;
                }

                if (preloadedHomeTeam) {
                    homeTeamSelect.dispatchEvent(new Event('change', { bubbles: true }));
                }

                if (preloadedAwayTeam) {
                    awayTeamSelect.dispatchEvent(new Event('change', { bubbles: true }));
                }

                if (preloadedHomeTeam || preloadedAwayTeam) {
                    historyStatusBadge.textContent = 'Ready to load history';
                    predictButton.disabled = true;
                }
            };

            leagueSelect.addEventListener('change', loadTeams);
            teamGenderSelect.addEventListener('change', () => {
                lastLoadedLeague = '';
                loadTeams();
            });
            homeTeamSelect.addEventListener('change', () => {
                loadLatestFormation(homeTeamSelect, homeFormationInput, 'home');
                loadHistory();
            });
            awayTeamSelect.addEventListener('change', () => {
                loadLatestFormation(awayTeamSelect, awayFormationInput, 'away');
                loadHistory();
            });
            wireRefreshableDatalist(leagueSelect);
            wireRefreshableDatalist(homeTeamSelect);
            wireRefreshableDatalist(awayTeamSelect);
            wireRefreshableDatalist(homeFormationInput);
            wireRefreshableDatalist(awayFormationInput);
            homeFormationInput.addEventListener('input', () => {
                if (homeFormationInput.value !== homeFormationInput.dataset.autofillValue) {
                    delete homeFormationInput.dataset.autofilled;
                    delete homeFormationInput.dataset.autofillValue;
                }

                refreshCurrentFeatures();
            });
            awayFormationInput.addEventListener('input', () => {
                if (awayFormationInput.value !== awayFormationInput.dataset.autofillValue) {
                    delete awayFormationInput.dataset.autofilled;
                    delete awayFormationInput.dataset.autofillValue;
                }

                refreshCurrentFeatures();
            });
            seasonInput.addEventListener('input', () => {
                refreshCurrentFeatures();
            });
            matchDateInput.addEventListener('change', () => {
                refreshCurrentFeatures();
            });
            isKnockoutInput.addEventListener('change', () => {
                refreshCurrentFeatures();
            });
            [
                homeRankingPositionInput,
                awayRankingPositionInput,
                rankingTotalTeamsInput,
                rankingSourceInput,
                rankingSeasonInput
            ].forEach(input => input.addEventListener('input', refreshCurrentFeatures));
            loadHistoryButton.addEventListener('click', () => loadHistory(true));
            predictButton.addEventListener('click', predict);
            initializePreloadedMatch();
        })();
    </script>
}
