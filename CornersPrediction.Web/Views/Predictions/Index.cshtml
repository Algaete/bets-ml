            };

            const getConsensusClass = consensus => {
                switch (String(consensus ?? '').toLowerCase()) {
                    case 'high':
                        return 'text-bg-success';
                    case 'medium':
                        return 'text-bg-warning';
                    case 'low':
                        return 'text-bg-danger';
                    default:
                        return 'text-bg-secondary';
                }
            };
            const getConfidenceClass = confidence => {
                switch (String(confidence ?? '').toLowerCase()) {
                    case 'no_bet':
                    case 'no bet':
                        return 'prediction-confidence-badge confidence-no-bet';
                    case 'very_high':
                    case 'very high':
                        return 'prediction-confidence-badge confidence-very-high';
                    case 'high':
                        return 'prediction-confidence-badge confidence-high';
                    case 'medium':
                        return 'prediction-confidence-badge confidence-medium';
                    case 'low':
                        return 'prediction-confidence-badge confidence-low';
                    default:
                        return 'prediction-confidence-badge confidence-empty';
                }
            };
            const formatSignedDecimal = value => {
                const number = Number(value || 0);
                return `${number >= 0 ? '+' : ''}${formatDecimal(number)}`;
            };
            const toBetSelection = prediction => {
                switch (String(prediction ?? '').toUpperCase()) {
                    case 'OVER':
                        return 'Over';
                    case 'UNDER':
                        return 'Under';
                    default:
                        return 'Over';
                }
            };
            const toConfidenceLevel = confidence => {
                switch (String(confidence ?? '').toUpperCase()) {
                    case 'VERY_HIGH':
                    case 'HIGH':
                        return 'High';
                    case 'MEDIUM':
                        return 'Medium';
                    case 'LOW':
                        return 'Low';
                    default:
                        return '';
                }
            };
            const getContextValue = (container, name) => container?.[name.charAt(0).toLowerCase() + name.slice(1)] ?? container?.[name];

            const getEnrichedComparisonDetails = basePrediction => {
                const comparison = getContextValue(currentPredictionContext, 'Comparison');
                if (!comparison) {
                    return null;
                }

                const enriched = Number(getContextValue(comparison, 'EnrichedPrediction') ?? 0);
                const hasBasePrediction = basePrediction !== null && basePrediction !== undefined;
                const difference = hasBasePrediction ? Math.abs(enriched - Number(basePrediction || 0)) : null;

                return {
                    enriched,
                    enrichedShots: Number(getContextValue(comparison, 'EnrichedShotsPrediction') ?? 0),
                    enrichedShotsOnGoal: Number(getContextValue(comparison, 'EnrichedShotsOnGoalPrediction') ?? 0),
                    enrichedGoals: Number(getContextValue(comparison, 'EnrichedGoalsPrediction') ?? 0),
                    homeExpectedCorners: Number(getContextValue(comparison, 'HomeExpectedCorners') ?? 0),
                    awayExpectedCorners: Number(getContextValue(comparison, 'AwayExpectedCorners') ?? 0),
                    homeExpectedShots: Number(getContextValue(comparison, 'HomeExpectedShots') ?? 0),
                    awayExpectedShots: Number(getContextValue(comparison, 'AwayExpectedShots') ?? 0),
                    homeExpectedShotsOnGoal: Number(getContextValue(comparison, 'HomeExpectedShotsOnGoal') ?? 0),
                    awayExpectedShotsOnGoal: Number(getContextValue(comparison, 'AwayExpectedShotsOnGoal') ?? 0),
                    homeExpectedGoals: Number(getContextValue(comparison, 'HomeExpectedGoals') ?? 0),
                    awayExpectedGoals: Number(getContextValue(comparison, 'AwayExpectedGoals') ?? 0),
                    difference,
                    recommendation: hasBasePrediction && difference <= 1.0
                        ? 'ML and context aligned'
                        : hasBasePrediction
                            ? 'Review manually: context differs'
                            : 'ML prediction pending'
                };
            };

            const renderEnrichedPrediction = (basePrediction = null) => {
                const details = getEnrichedComparisonDetails(basePrediction);
                if (!details) {
                    enrichedPredictionCard.classList.add('d-none');
                    configureContextShotsBetLink(null);
                    return;
                }

                const hasBasePrediction = basePrediction !== null && basePrediction !== undefined;
                const isConsistent = hasBasePrediction && details.difference <= 1.0;

                enrichedPredictionValue.textContent = formatDecimal(details.enriched);
                enrichedShotsValue.textContent = `${formatDecimal(details.enrichedShots)} shots`;
                enrichedShotsOnGoalValue.textContent = `${formatDecimal(details.enrichedShotsOnGoal)} SOG`;
                enrichedGoalsValue.textContent = `${formatDecimal(details.enrichedGoals)} goals`;
                basePredictionValue.textContent = hasBasePrediction ? `${formatDecimal(basePrediction)} corners` : 'Pending model result';
                predictionDifferenceValue.textContent = hasBasePrediction ? `${formatDecimal(details.difference)} corners` : 'Pending';
                homeContextBreakdownValue.textContent = `${formatDecimal(details.homeExpectedCorners)} C / ${formatDecimal(details.homeExpectedShots)} Sh / ${formatDecimal(details.homeExpectedShotsOnGoal)} SOG / ${formatDecimal(details.homeExpectedGoals)} G`;
                awayContextBreakdownValue.textContent = `${formatDecimal(details.awayExpectedCorners)} C / ${formatDecimal(details.awayExpectedShots)} Sh / ${formatDecimal(details.awayExpectedShotsOnGoal)} SOG / ${formatDecimal(details.awayExpectedGoals)} G`;
                predictionRecommendationBadge.textContent = details.recommendation;
                predictionRecommendationBadge.className = `prediction-status-chip ${hasBasePrediction ? (isConsistent ? 'status-success' : 'status-warning') : 'status-muted'}`;
                enrichedPredictionCard.classList.remove('d-none');
                configureContextShotsBetLink(details);
            };

            const buildBettingNotes = prediction => {
                const predictedTotalCorners = prediction.predictedTotalCorners;
                const enrichedDetails = getEnrichedComparisonDetails(predictedTotalCorners);
                const lines = [
                    'Datos generados desde Predictions',
                    `${leagueSelect.value.trim()} | ${seasonInput.value.trim()} | ${matchDateInput.value}`,
                    `${homeTeamSelect.value.trim()} vs ${awayTeamSelect.value.trim()}`,
                    `Corners ensemble final: ${formatDecimal(predictedTotalCorners)}`,
                    `Direct TotalCorners model: ${prediction.predTotalDirect === null || prediction.predTotalDirect === undefined ? '-' : formatDecimal(prediction.predTotalDirect)}`,
                    `HomeCorners model: ${prediction.predHomeCorners === null || prediction.predHomeCorners === undefined ? '-' : formatDecimal(prediction.predHomeCorners)}`,
                    `AwayCorners model: ${prediction.predAwayCorners === null || prediction.predAwayCorners === undefined ? '-' : formatDecimal(prediction.predAwayCorners)}`,
                    `Home + Away combined: ${prediction.predTotalCombined === null || prediction.predTotalCombined === undefined ? '-' : formatDecimal(prediction.predTotalCombined)}`,
                    `Probable range: ${formatRange(prediction.probableRangeLow, prediction.probableRangeHigh)}`,
                    `Historical average error: ±${formatDecimal(prediction.mae)}`,
                    `Betting line: ${prediction.bettingLine === null || prediction.bettingLine === undefined ? 'N/A' : formatDecimal(prediction.bettingLine, 1)}`,
                    `Recommendation: ${prediction.recommendedSide ?? 'N/A'}`,
                    `Confidence: ${prediction.confidence ?? 'N/A'}`,
                    `Distance to line: ${prediction.distanceToLine === null || prediction.distanceToLine === undefined ? 'N/A' : formatDecimal(prediction.distanceToLine)}`
                ];

                if (enrichedDetails) {
                    lines.push(`Predicción enriquecida: ${formatDecimal(enrichedDetails.enriched)}`);
                    lines.push(`Context shots: ${formatDecimal(enrichedDetails.enrichedShots)}`);
                    lines.push(`Context shots on goal: ${formatDecimal(enrichedDetails.enrichedShotsOnGoal)}`);
                    lines.push(`Context goals: ${formatDecimal(enrichedDetails.enrichedGoals)}`);
                    if (enrichedDetails.difference !== null) {
                        lines.push(`ML vs context difference: ${formatDecimal(enrichedDetails.difference)} corners`);
                    }
                    lines.push(`Context status: ${enrichedDetails.recommendation}`);
                }

                if (prediction.legacyTotalCorners !== null) {
                    lines.push(`Home + Away combined: ${formatDecimal(prediction.legacyTotalCorners)}`);
                    lines.push(`Model difference: ${formatDecimal(prediction.modelDifference)} corners`);
                    lines.push(`Model alignment: ${prediction.consensus}`);
                }

                return lines.join('\n');
            };

            const buildMarketBettingNotes = (market, label) => {
                const lines = [
                    'Datos generados desde Predictions',
                    `${leagueSelect.value.trim()} | ${seasonInput.value.trim()} | ${matchDateInput.value}`,
                    `${homeTeamSelect.value.trim()} vs ${awayTeamSelect.value.trim()}`,
                    `${label} prediction: ${formatDecimal(market.prediction)}`,
                    `${label} line: ${formatMarketLine(market.line)}`,
                    `${label} recommendation: ${market.recommendation ?? 'N/A'}`,
                    `${label} confidence: ${market.confidence ?? 'N/A'}`,
                    `${label} distance: ${formatMarketDistance(market.distance)}`,
                    `${label} historical accuracy: ${formatMarketAccuracy(market.historicalAccuracy)}`,
                    `${label} direct model: ${formatDecimal(market.totalDirectPrediction)}`,
                    `${label} Home + Away: ${formatDecimal(market.combinedHomeAwayPrediction)}`
                ];

                if (lastTotalPrediction) {
                    lines.push(`AutoML TotalCorners: ${formatDecimal(lastTotalPrediction.predictedTotalCorners)}`);
                }

                return lines.join('\n');
            };

            const buildSinglePredictionBettingNotes = (label, prediction) => {
                const lines = [
                    'Datos generados desde Predictions',
                    `${leagueSelect.value.trim()} | ${seasonInput.value.trim()} | ${matchDateInput.value}`,
                    `${homeTeamSelect.value.trim()} vs ${awayTeamSelect.value.trim()}`,
                    `${label} prediction: ${formatDecimal(prediction)}`,
                    `${label} suggested line: ${formatDecimal(getSuggestedHalfLineBelow(prediction), 1)}`,
                    'Selection preset: Over'
                ];

                if (lastTotalPrediction) {
                    lines.push(`Corners ML final: ${formatDecimal(lastTotalPrediction.predictedTotalCorners)}`);
                }

                return lines.join('\n');
            };

            const buildContextShotsBettingNotes = details => {
                const lines = [
                    'Datos generados desde Predictions',
                    `${leagueSelect.value.trim()} | ${seasonInput.value.trim()} | ${matchDateInput.value}`,
                    `${homeTeamSelect.value.trim()} vs ${awayTeamSelect.value.trim()}`,
                    `Context shots prediction: ${formatDecimal(details.enrichedShots)}`,
                    `Home expected shots: ${formatDecimal(details.homeExpectedShots)}`,
                    `Away expected shots: ${formatDecimal(details.awayExpectedShots)}`,
                    `Context SOG prediction: ${formatDecimal(details.enrichedShotsOnGoal)}`,
                    `Context goals prediction: ${formatDecimal(details.enrichedGoals)}`,
                    `Context corners prediction: ${formatDecimal(details.enriched)}`
                ];

                if (lastTotalPrediction) {
                    lines.push(`AutoML TotalCorners: ${formatDecimal(lastTotalPrediction.predictedTotalCorners)}`);
                }

                return lines.join('\n');
            };

            const getCurrentBettingLine = () => Number(bettingLineInput.value || 0);

            const getRecommendedTotalBetSelection = prediction => {
                if (prediction.recommendedSide) {
                    return toBetSelection(prediction.recommendedSide);
                }

                const line = getCurrentBettingLine();
                if (!line) {
                    return 'Over';
                }

                return Number(prediction.predictedTotalCorners) >= line ? 'Over' : 'Under';
            };

            const getSuggestedHalfLineBelow = value => {
                const number = Number(value || 0);
                return Math.max(0, Math.floor(number * 2) / 2);
            };

            const buildBettingQueryBase = (prediction, predictionModel, marketType = 'TotalCorners', notes = null) => new URLSearchParams({
                league: leagueSelect.value.trim(),
                season: seasonInput.value.trim(),
                matchDate: matchDateInput.value,
                homeTeam: homeTeamSelect.value.trim(),
                awayTeam: awayTeamSelect.value.trim(),
                marketType,
                predictionModel,
                notes: notes ?? buildBettingNotes(prediction)
            });

            const hideBetLink = link => {
                link.href = '/Betting/Create';
                link.classList.add('d-none');
            };

            const configureSinglePredictionBetLink = (link, prediction, marketType, predictionModel, label, confidence = null) => {
                const value = Number(prediction);
                if (!Number.isFinite(value) || value <= 0) {
                    hideBetLink(link);
                    return;
                }

                const parameters = new URLSearchParams({
                    league: leagueSelect.value.trim(),
                    season: seasonInput.value.trim(),
                    matchDate: matchDateInput.value,
                    homeTeam: homeTeamSelect.value.trim(),
                    awayTeam: awayTeamSelect.value.trim(),
                    marketType,
                    betSelection: 'Over',
                    line: formatDecimal(getSuggestedHalfLineBelow(value), 1),
                    predictionModel,
                    confidenceLevel: toConfidenceLevel(confidence),
                    notes: buildSinglePredictionBettingNotes(label, value)
                });

                link.href = `/Betting/Create?${parameters.toString()}`;
                link.classList.remove('d-none');
            };

            const configureTotalModelBetLink = prediction => {
                const parameters = buildBettingQueryBase(prediction, 'TotalCornersModel');
                parameters.set('betSelection', getRecommendedTotalBetSelection(prediction));
                parameters.set('line', formatDecimal(prediction.bettingLine ?? getCurrentBettingLine(), 1));
                parameters.set('confidenceLevel', toConfidenceLevel(prediction.confidence));

                createBetFromTotalModelLink.href = `/Betting/Create?${parameters.toString()}`;
                createBetFromTotalModelLink.classList.remove('d-none');
                configureSinglePredictionBetLink(
                    createBetFromHomeCornersLink,
                    prediction.predHomeCorners,
                    'HomeCorners',
                    'TotalCornersModel',
                    'Home corners',
                    prediction.confidence);
                configureSinglePredictionBetLink(
                    createBetFromAwayCornersLink,
                    prediction.predAwayCorners,
                    'AwayCorners',
                    'TotalCornersModel',
                    'Away corners',
                    prediction.confidence);
            };

            const configureContextShotsBetLink = details => {
                if (!details) {
                    createBetFromContextShotsLink.href = '/Betting/Create';
                    createBetFromContextShotsLink.classList.add('d-none');
                    return;
                }

                const parameters = new URLSearchParams({
                    league: leagueSelect.value.trim(),
                    season: seasonInput.value.trim(),
                    matchDate: matchDateInput.value,
                    homeTeam: homeTeamSelect.value.trim(),
                    awayTeam: awayTeamSelect.value.trim(),
                    marketType: 'TotalShots',
                    betSelection: 'Over',
                    line: formatDecimal(getSuggestedHalfLineBelow(details.enrichedShots), 1),
                    predictionModel: 'Manual',
                    notes: buildContextShotsBettingNotes(details)
                });

                createBetFromContextShotsLink.href = `/Betting/Create?${parameters.toString()}`;
                createBetFromContextShotsLink.classList.remove('d-none');
            };

            const configureMarketBetLink = (link, market, marketType, predictionModel, label) => {
                if (!market) {
                    hideBetLink(link);
                    return;
                }

                const parameters = new URLSearchParams({
                    league: leagueSelect.value.trim(),
                    season: seasonInput.value.trim(),
                    matchDate: matchDateInput.value,
                    homeTeam: homeTeamSelect.value.trim(),
                    awayTeam: awayTeamSelect.value.trim(),
                    marketType,
                    betSelection: toBetSelection(market.recommendation),
                    line: formatMarketLine(market.line ?? getSuggestedHalfLineBelow(market.prediction)),
                    predictionModel,
                    confidenceLevel: toConfidenceLevel(market.confidence),
                    notes: buildMarketBettingNotes(market, label)
                });

                link.href = `/Betting/Create?${parameters.toString()}`;
                link.classList.remove('d-none');
            };

            const configureShotsBetLink = market => {
                configureMarketBetLink(createBetFromShotsLink, market, 'TotalShots', 'ShotsOnGoalModel', 'Shots');
                configureSinglePredictionBetLink(createBetFromHomeShotsLink, market?.homePrediction, 'HomeShots', 'ShotsOnGoalModel', 'Home shots', market?.confidence);
                configureSinglePredictionBetLink(createBetFromAwayShotsLink, market?.awayPrediction, 'AwayShots', 'ShotsOnGoalModel', 'Away shots', market?.confidence);
            };

            const configureShotsOnGoalBetLink = market => {
                if (!market) {
                    hideBetLink(createBetFromShotsOnGoalLink);
                    hideBetLink(createBetFromHomeSogLink);
                    hideBetLink(createBetFromAwaySogLink);
                    return;
                }

                configureMarketBetLink(createBetFromShotsOnGoalLink, market, 'TotalShotsOnGoal', 'ShotsOnGoalModel', 'SOG');
                configureSinglePredictionBetLink(createBetFromHomeSogLink, market.homePrediction, 'HomeShotsOnGoal', 'ShotsOnGoalModel', 'Home SOG', market.confidence);
                configureSinglePredictionBetLink(createBetFromAwaySogLink, market.awayPrediction, 'AwayShotsOnGoal', 'ShotsOnGoalModel', 'Away SOG', market.confidence);
            };

            const configureGoalsBetLink = market => {
                configureMarketBetLink(createBetFromGoalsLink, market, 'TotalGoals', 'GoalsModel', 'Goals');
                configureSinglePredictionBetLink(createBetFromHomeGoalsLink, market?.homePrediction, 'HomeGoals', 'GoalsModel', 'Home goals', market?.confidence);
                configureSinglePredictionBetLink(createBetFromAwayGoalsLink, market?.awayPrediction, 'AwayGoals', 'GoalsModel', 'Away goals', market?.confidence);
            };

            const renderRankingAdjustment = result => {
                const adjustment = result.rankingAdjustment;
                if (!adjustment) {
                    rankingAdjustmentCard.classList.add('d-none');
                    return;
                }

                rankingAdjustmentCard.classList.remove('d-none');
                rankingAdjustmentBadge.textContent = adjustment.applied ? 'Aplicado' : 'Sin ajuste';
                rankingAdjustmentBadge.className = `badge ${adjustment.applied ? 'text-bg-success' : 'text-bg-secondary'}`;
                rankingAdjustmentStatus.textContent = adjustment.applied
                    ? `${adjustment.rankingSource ?? 'Ranking'} ${adjustment.rankingSeason ?? ''}`.trim()
                    : adjustment.reason ?? 'Ranking no aplicado';
                rankingBaseHomeValue.textContent = formatOptionalDecimal(result.baseHomeCorners);
                rankingBaseAwayValue.textContent = formatOptionalDecimal(result.baseAwayCorners);
                rankingBaseTotalValue.textContent = formatOptionalDecimal(result.baseTotalCorners);
                rankingHomePctValue.textContent = `Ranking Factor Home: ${formatPercent(adjustment.homeAdjustmentPct)}`;
                rankingHomePctValue.className = `small ${Number(adjustment.homeAdjustmentPct ?? 0) >= 0 ? 'text-success' : 'text-danger'}`;
                rankingAwayPctValue.textContent = `Ranking Factor Away: ${formatPercent(adjustment.awayAdjustmentPct)}`;
                rankingAwayPctValue.className = `small ${Number(adjustment.awayAdjustmentPct ?? 0) >= 0 ? 'text-success' : 'text-danger'}`;
                rankingFinalHomeValue.textContent = `Final HomeCorners: ${formatOptionalDecimal(result.finalHomeCorners)}`;
                rankingFinalAwayValue.textContent = `Final AwayCorners: ${formatOptionalDecimal(result.finalAwayCorners)}`;
                rankingFinalTotalValue.textContent = formatOptionalDecimal(result.finalTotalCorners);
            };

            const refreshCurrentFeatures = () => {
                if (!currentFeatures) {
                    return;
                }

                currentFeatures = buildFeatures();
                renderFeatures(currentFeatures);
            };

            const setPrediction = result => {
                const predictedTotalCorners = Number(result.finalTotalCorners ?? getPredictionNumber(result));
                const mae = getOptionalNumber(result, 'mae') ?? MAE_TOTAL;
                const rmse = getOptionalNumber(result, 'rmse') ?? RMSE_TOTAL;
                const probableRangeLow = getOptionalNumber(result, 'probableRangeLow') ?? getOptionalNumber(result, 'rangeLow') ?? Math.max(0, predictedTotalCorners - mae);
                const probableRangeHigh = getOptionalNumber(result, 'probableRangeHigh') ?? getOptionalNumber(result, 'rangeHigh') ?? predictedTotalCorners + mae;
                const wideRangeLow = getOptionalNumber(result, 'wideRangeLow') ?? probableRangeLow;
                const wideRangeHigh = getOptionalNumber(result, 'wideRangeHigh') ?? probableRangeHigh;
                const predTotalDirect = getOptionalNumber(result, 'predTotalDirect') ?? getOptionalNumber(result, 'rawTotalCornersPrediction');
                const predHomeCorners = getOptionalNumber(result, 'finalHomeCorners') ?? getOptionalNumber(result, 'predHomeCorners') ?? getOptionalNumber(result, 'homeCornersPrediction');
                const predAwayCorners = getOptionalNumber(result, 'finalAwayCorners') ?? getOptionalNumber(result, 'predAwayCorners') ?? getOptionalNumber(result, 'awayCornersPrediction');
                const predTotalCombined = getOptionalNumber(result, 'finalTotalCorners') ?? getOptionalNumber(result, 'predTotalCombined');
                const bettingLine = getOptionalNumber(result, 'bettingLine');
                const distanceToLine = getOptionalNumber(result, 'distanceToLine');
                const recommendedSide = result.recommendedSide ?? 'N/A';
                const confidence = result.confidence ?? 'N/A';
                const recommendationMessage = result.message ?? '';
                const legacyTotalCorners = getOptionalNumber(result, 'legacyTotalCorners');
                const modelDifference = legacyTotalCorners === null
                    ? null
                    : getOptionalNumber(result, 'modelDifference') ?? Math.abs(predictedTotalCorners - legacyTotalCorners);
                const consensus = legacyTotalCorners === null
                    ? null
                    : result.modelConsensus ?? (
                        modelDifference <= 1.0 ? 'High' :
                        modelDifference <= 2.0 ? 'Medium' : 'Low'
                    );

                predictionValue.textContent = formatDecimal(predictedTotalCorners);
                probableRangeValue.textContent = formatRange(probableRangeLow, probableRangeHigh);
                wideRangeValue.textContent = formatRange(wideRangeLow, wideRangeHigh);
                cornersBettingLineValue.textContent = bettingLine === null ? 'N/A' : formatDecimal(bettingLine, 1);
                cornersDirectValue.textContent = predTotalDirect === null ? 'N/A' : formatDecimal(predTotalDirect);
                cornersHomeValue.textContent = predHomeCorners === null ? 'N/A' : formatDecimal(predHomeCorners);
                cornersAwayValue.textContent = predAwayCorners === null ? 'N/A' : formatDecimal(predAwayCorners);
                cornersCombinedValue.textContent = predTotalCombined === null
                    ? predHomeCorners === null || predAwayCorners === null
                        ? 'N/A'
                        : formatDecimal(predHomeCorners + predAwayCorners)
                    : formatDecimal(predTotalCombined);
                cornersRecommendedSideValue.textContent = recommendedSide;
                cornersDistanceToLineValue.textContent = distanceToLine === null ? 'N/A' : formatDecimal(distanceToLine);
                cornersConfidenceBadge.textContent = confidence;
                cornersConfidenceBadge.className = `badge ${getConfidenceClass(confidence)}`;
                cornersRecommendationMessage.textContent = recommendationMessage;
                cornersRecommendationMessage.className = `alert mt-3 mb-0 ${confidence === 'LOW' ? 'alert-warning' : confidence === 'HIGH' || confidence === 'VERY_HIGH' ? 'alert-success' : 'alert-light border'}`;
                cornersRecommendationMessage.classList.toggle('d-none', !recommendationMessage);
                renderRankingAdjustment(result);
                predictionResult.classList.remove('d-none');
                renderEnrichedPrediction(predictedTotalCorners);
                lastTotalPrediction = {
                    predictedTotalCorners,
                    predTotalDirect,
                    predHomeCorners,
                    predAwayCorners,
                    predTotalCombined,
                    probableRangeLow,
                    probableRangeHigh,
                    wideRangeLow,
                    wideRangeHigh,
                    mae,
                    rmse,
                    bettingLine,
                    recommendedSide,
                    distanceToLine,
                    confidence,
                    message: recommendationMessage,
                    legacyTotalCorners,
                    modelDifference,
                    consensus
                };
                configureTotalModelBetLink(lastTotalPrediction);

                if (legacyTotalCorners === null) {
                    modelComparison.classList.add('d-none');
                    return lastTotalPrediction;
                }

                autoMlTotalValue.textContent = predTotalDirect === null ? formatDecimal(predictedTotalCorners) : formatDecimal(predTotalDirect);
                predHomeCornersValue.textContent = predHomeCorners === null ? '-' : formatDecimal(predHomeCorners);
                predAwayCornersValue.textContent = predAwayCorners === null ? '-' : formatDecimal(predAwayCorners);
                legacyTotalValue.textContent = predTotalCombined === null ? formatDecimal(legacyTotalCorners) : formatDecimal(predTotalCombined);
                modelDifferenceValue.textContent = `${formatDecimal(modelDifference)} corners`;
                consensusValue.textContent = consensus;
                consensusBadge.textContent = consensus;
                consensusBadge.className = `badge ${getConsensusClass(consensus)}`;
                modelComparison.classList.remove('d-none');
                return lastTotalPrediction;
            };

            const setMarketCard = (market, elements) => {
                if (!market) {
                    elements.adjustment?.classList.add('d-none');
                    elements.card.classList.add('d-none');
                    return;
                }

                elements.prediction.textContent = formatDecimal(market.prediction);
                elements.line.textContent = formatMarketLine(market.line);
                elements.recommendation.textContent = market.recommendation ?? 'N/A';
                elements.confidence.textContent = market.confidence ?? 'N/A';
                elements.confidence.className = `badge ${getConfidenceClass(market.confidence)}`;
                elements.accuracy.textContent = formatMarketAccuracy(market.historicalAccuracy);
                elements.distance.textContent = formatMarketDistance(market.distance);
                elements.combined.textContent = formatDecimal(market.combinedHomeAwayPrediction);
                elements.home.textContent = formatDecimal(market.homePrediction);
                elements.away.textContent = formatDecimal(market.awayPrediction);
                elements.direct.textContent = formatDecimal(market.totalDirectPrediction);
                if (elements.adjustment) {
                    if (market.sanityAdjusted) {
                        const directText = market.totalDirectPrediction === null || market.totalDirectPrediction === undefined
                            ? ''
                            : ` Direct total model: ${formatDecimal(market.totalDirectPrediction)}.`;
                        const combinedText = market.combinedHomeAwayPrediction === null || market.combinedHomeAwayPrediction === undefined
                            ? ''
                            : ` Home + Away: ${formatDecimal(market.combinedHomeAwayPrediction)}.`;
                        const priorText = market.featurePrior === null || market.featurePrior === undefined
                            ? ''
                            : ` Recent shots context: ${formatDecimal(market.featurePrior)}.`;
                        elements.adjustment.textContent = `Shots guardrail applied because the direct total model was inconsistent with context.${directText}${combinedText}${priorText}`;
                        elements.adjustment.classList.remove('d-none');
                    } else {
                        elements.adjustment.classList.add('d-none');
                        elements.adjustment.textContent = '';
                    }
                }
                elements.card.classList.remove('d-none');
            };

            const setShotsOnGoalPrediction = result => {
                lastShotsOnGoalPrediction = result;
                const shotsMarket = result.shots ?? result.markets?.shots ?? (
                    result.finalShotsPrediction === null || result.finalShotsPrediction === undefined
                        ? null
                        : {
                            prediction: result.finalShotsPrediction ?? result.predictedShots,
                            finalPrediction: result.finalShotsPrediction ?? result.predictedShots,
                            line: Number(shotsLineInput.value || 0),
                            recommendation: null,
                            confidence: null,
                            distance: null,
                            historicalAccuracy: null,
                            homePrediction: result.homeShotsPrediction ?? null,
                            awayPrediction: result.awayShotsPrediction ?? null,
                            totalDirectPrediction: result.rawTotalShotsPrediction ?? null,
                            combinedHomeAwayPrediction:
                                result.homeShotsPrediction === null || result.homeShotsPrediction === undefined ||
                                result.awayShotsPrediction === null || result.awayShotsPrediction === undefined
                                    ? null
                                    : result.homeShotsPrediction + result.awayShotsPrediction
