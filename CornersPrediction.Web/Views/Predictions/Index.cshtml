@model CornersPrediction.Web.Models.Predictions.PredictionIndexViewModel

@{
    ViewData["Title"] = UiText.T(Context, "Predictions.Title");
    var language = UiText.GetLanguage(Context);
    string T(string key) => UiText.T(language, key);
    var leagueOptions = Model.LeagueOptions.OrderBy(league => league).ToArray();
    var formationOptions = Model.FormationOptions.OrderBy(formation => formation).ToArray();
    var selectedLeague = Model.League ?? string.Empty;
    var selectedSeason = string.IsNullOrWhiteSpace(Model.Season) ? "2025-2026" : Model.Season;
    var selectedMatchDate = (Model.MatchDate ?? DateTime.Today).ToString("yyyy-MM-dd");
    var selectedTeamGender = Model.TeamGender.Equals("F", StringComparison.OrdinalIgnoreCase) ? "F" : "M";
}

<div class="prediction-hero mb-4">
    <div>
        <div class="text-muted small text-uppercase fw-semibold">@T("Predictions.Eyebrow")</div>
        <h1 class="h3 mb-1">@T("Predictions.Title")</h1>
        <p class="text-muted mb-0">@T("Predictions.Description")</p>
    </div>
    <div class="prediction-status-panel">
        <span class="badge text-bg-success">@T("Predictions.MainModelBadge")</span>
        <span id="historyStatusBadge" class="badge text-bg-secondary">@T("Predictions.WaitingForTeams")</span>
    </div>
</div>

<section class="prediction-dashboard mb-4">
    <div class="surface-panel prediction-setup-panel">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
            <div>
                <h2 class="h5 mb-1">@T("Predictions.MatchSetup")</h2>
                <div class="text-muted small">@T("Predictions.MatchSetupCopy")</div>
            </div>
        </div>

        @if (leagueOptions.Length == 0)
        {
            <div class="alert alert-warning">
                @T("Predictions.LeagueOptionsError")
            </div>
        }

        <div class="match-setup-grid">
            <div class="setup-field setup-league">
                <label class="form-label" for="League">@T("Fields.League")</label>
                <input id="League" class="form-control" list="LeagueOptions" placeholder="@T("Predictions.SearchLeague")" autocomplete="off" value="@selectedLeague" />
                <datalist id="LeagueOptions">
                    @foreach (var league in leagueOptions)
                    {
                        <option value="@league"></option>
                    }
                </datalist>
            </div>
            <div class="setup-field setup-season">
                <label class="form-label" for="Season">@T("Fields.Season")</label>
                <input id="Season" class="form-control" value="@selectedSeason" />
            </div>
            <div class="setup-field setup-gender">
                <label class="form-label" for="TeamGender">@T("Predictions.TeamGender")</label>
                <select id="TeamGender" class="form-select">
                    <option value="M" selected="@(selectedTeamGender == "M")">@T("UpcomingMatches.Male")</option>
                    <option value="F" selected="@(selectedTeamGender == "F")">@T("UpcomingMatches.Female")</option>
                </select>
            </div>
            <div class="setup-field setup-date">
                <label class="form-label" for="MatchDate">@T("Fields.MatchDate")</label>
                <input id="MatchDate" class="form-control" type="date" value="@selectedMatchDate" />
            </div>
            <div class="setup-field setup-team">
                <label class="form-label" for="HomeTeam">@T("Fields.HomeTeam")</label>
                <input id="HomeTeam" class="form-control" list="HomeTeamOptions" placeholder="@T("Predictions.SelectLeagueFirst")" autocomplete="off" value="@Model.HomeTeam" data-initial-value="@Model.HomeTeam" disabled="@string.IsNullOrWhiteSpace(selectedLeague)" />
                <datalist id="HomeTeamOptions"></datalist>
            </div>
            <div class="setup-field setup-team">
                <label class="form-label" for="AwayTeam">@T("Fields.AwayTeam")</label>
                <input id="AwayTeam" class="form-control" list="AwayTeamOptions" placeholder="@T("Predictions.SelectLeagueFirst")" autocomplete="off" value="@Model.AwayTeam" data-initial-value="@Model.AwayTeam" disabled="@string.IsNullOrWhiteSpace(selectedLeague)" />
                <datalist id="AwayTeamOptions"></datalist>
            </div>
            <div class="setup-field setup-formation">
                <label class="form-label" for="HomeFormation">@T("Predictions.HomeFormation")</label>
                <input id="HomeFormation" class="form-control" list="FormationOptions" placeholder="4-3-3" autocomplete="off" />
            </div>
            <div class="setup-field setup-formation">
                <label class="form-label" for="AwayFormation">@T("Predictions.AwayFormation")</label>
                <input id="AwayFormation" class="form-control" list="FormationOptions" placeholder="4-2-3-1" autocomplete="off" />
            </div>
            <div class="setup-field setup-line">
                <label class="form-label" for="BettingLine">@T("Predictions.CornersLine")</label>
                <input id="BettingLine" class="form-control" type="number" min="0" step="0.5" value="9.5" />
            </div>
            <div class="setup-field setup-line">
                <label class="form-label" for="ShotsLine">@T("Predictions.ShotsLine")</label>
                <input id="ShotsLine" class="form-control" type="number" min="0" step="0.5" value="24.5" />
            </div>
            <div class="setup-field setup-line">
                <label class="form-label" for="SogLine">@T("Predictions.SogLine")</label>
                <input id="SogLine" class="form-control" type="number" min="0" step="0.5" value="8.5" />
            </div>
            <div class="setup-field setup-line">
                <label class="form-label" for="GoalsLine">Goals line</label>
                <input id="GoalsLine" class="form-control" type="number" min="0" step="0.5" value="2.5" />
            </div>
            <div class="setup-field setup-knockout">
                <label class="form-label" for="IsKnockout">@T("Predictions.Knockout")</label>
                <div class="form-check form-switch pt-2">
                    <input id="IsKnockout" class="form-check-input" type="checkbox" checked="@Model.IsKnockout" />
                    <label class="form-check-label small text-muted" for="IsKnockout">@T("Predictions.SingleElimination")</label>
                </div>
            </div>
            <div class="setup-field setup-ranking">
                <label class="form-label" for="HomeRankingPosition">Posicion ranking local</label>
                <input id="HomeRankingPosition" class="form-control" type="number" min="1" step="1" placeholder="1" />
            </div>
            <div class="setup-field setup-ranking">
                <label class="form-label" for="AwayRankingPosition">Posicion ranking visita</label>
                <input id="AwayRankingPosition" class="form-control" type="number" min="1" step="1" placeholder="12" />
            </div>
            <div class="setup-field setup-ranking">
                <label class="form-label" for="RankingTotalTeams">Total equipos ranking</label>
                <input id="RankingTotalTeams" class="form-control" type="number" min="2" step="1" placeholder="19" />
            </div>
            <div class="setup-field setup-ranking-source">
                <label class="form-label" for="RankingSource">Fuente ranking</label>
                <input id="RankingSource" class="form-control" placeholder="FIFA, Liga Chilena 2026" autocomplete="off" />
            </div>
            <div class="setup-field setup-ranking">
                <label class="form-label" for="RankingSeason">Temporada ranking</label>
                <input id="RankingSeason" class="form-control" placeholder="2026" autocomplete="off" />
            </div>
            <datalist id="FormationOptions">
                @foreach (var formation in formationOptions)
                {
                    <option value="@formation"></option>
                }
            </datalist>
        </div>

        <div class="prediction-actions mt-4">
            <button id="LoadHistoryButton" type="button" class="btn btn-outline-primary">@T("Predictions.LoadHistory")</button>
            <button id="PredictButton" type="button" class="btn btn-primary" disabled>@T("Predictions.PredictMatch")</button>
        </div>

        <div id="PredictionError" class="alert alert-danger mt-4 d-none"></div>
    </div>

    <div class="surface-panel prediction-model-guide">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
            <div>
                <h2 class="h5 mb-1">@T("Predictions.ModelGuide")</h2>
                <div class="text-muted small">@T("Predictions.ModelGuideCopy")</div>
            </div>
            <span class="badge text-bg-primary">@T("Predictions.OldModelInactive")</span>
        </div>
        <div class="row g-3">
            <div class="col-md-6 col-xl-4">
                <div class="border rounded p-3 h-100">
                    <div class="fw-semibold">@T("Predictions.CornersEnsemble")</div>
                    <div class="small text-muted mt-1">@T("Predictions.CornersGuideCopy")</div>
                </div>
            </div>
            <div class="col-md-6 col-xl-4">
                <div class="border rounded p-3 h-100">
                    <div class="fw-semibold">@T("Predictions.ShotsGuideTitle")</div>
                    <div class="small text-muted mt-1">@T("Predictions.ShotsGuideCopy")</div>
                </div>
            </div>
            <div class="col-md-6 col-xl-4">
                <div class="border rounded p-3 h-100">
                    <div class="fw-semibold">@T("Predictions.ContextGuideTitle")</div>
                    <div class="small text-muted mt-1">@T("Predictions.ContextGuideCopy")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="prediction-output-grid">
        <div id="PredictionResult" class="prediction-result-card d-none">
            <div class="prediction-card-label">@T("Predictions.CornersEnsemble")</div>
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                    <div class="text-muted small">@T("Predictions.FinalCorners")</div>
                    <div id="PredictionValue" class="prediction-main-value"></div>
                </div>
                <span class="badge text-bg-success">@T("Predictions.FilteredEnsemble")</span>
            </div>
            <p class="text-muted small mt-2 mb-0">@T("Predictions.CornersFormula")</p>
            <div class="prediction-metric-grid mt-3">
                <div>
                    <div class="small text-muted">@T("Predictions.ProbableRange")</div>
                    <div id="ProbableRangeValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">@T("Predictions.WideRange")</div>
                    <div id="WideRangeValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">@T("Predictions.BettingLine")</div>
                    <div id="CornersBettingLineValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Direct total ML</div>
                    <div id="CornersDirectValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Home corners final</div>
                    <div id="CornersHomeValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Away corners final</div>
                    <div id="CornersAwayValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Home + Away</div>
                    <div id="CornersCombinedValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">@T("Predictions.Recommendation")</div>
                    <div id="CornersRecommendedSideValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">@T("Predictions.DistanceToLine")</div>
                    <div id="CornersDistanceToLineValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">@T("Fields.Confidence")</div>
                    <span id="CornersConfidenceBadge" class="badge"></span>
                </div>
            </div>
            <div id="RankingAdjustmentCard" class="ranking-adjustment-card mt-3 d-none">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                    <div>
                        <div class="fw-semibold">Ajuste manual por ranking</div>
                        <div id="RankingAdjustmentStatus" class="small text-muted"></div>
                    </div>
                    <span id="RankingAdjustmentBadge" class="badge text-bg-secondary">Sin ajuste</span>
                </div>
                <div class="ranking-adjustment-grid">
                    <div>
                        <div class="small text-muted">ML HomeCorners base</div>
                        <div id="RankingBaseHomeValue" class="fw-semibold"></div>
                        <div id="RankingHomePctValue" class="small"></div>
                        <div id="RankingFinalHomeValue" class="fw-semibold"></div>
                    </div>
                    <div>
                        <div class="small text-muted">ML AwayCorners base</div>
                        <div id="RankingBaseAwayValue" class="fw-semibold"></div>
                        <div id="RankingAwayPctValue" class="small"></div>
                        <div id="RankingFinalAwayValue" class="fw-semibold"></div>
                    </div>
                    <div>
                        <div class="small text-muted">ML TotalCorners base</div>
                        <div id="RankingBaseTotalValue" class="fw-semibold"></div>
                        <div class="small text-muted">Final TotalCorners</div>
                        <div id="RankingFinalTotalValue" class="fw-semibold"></div>
                    </div>
                </div>
            </div>
            <div id="CornersRecommendationMessage" class="alert alert-light border mt-3 mb-0 d-none"></div>
            <div class="mt-3 d-flex flex-wrap gap-2">
                <a id="CreateBetFromTotalModelLink" class="btn btn-sm btn-outline-success d-none" href="/Betting/Create">
                    @T("Predictions.CreateCornersBet")
                </a>
                <a id="CreateBetFromHomeCornersLink" class="btn btn-sm btn-outline-success d-none" href="/Betting/Create">
                    Home corners
                </a>
                <a id="CreateBetFromAwayCornersLink" class="btn btn-sm btn-outline-success d-none" href="/Betting/Create">
                    Away corners
                </a>
            </div>
        </div>

        <div id="EnrichedPredictionCard" class="prediction-result-card accent d-none">
            <div class="prediction-card-label">Context calculation · reference only</div>
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                    <div class="text-muted small">Context corners estimate</div>
                    <div id="EnrichedPredictionValue" class="prediction-main-value"></div>
                </div>
                <span id="PredictionRecommendationBadge" class="prediction-status-chip"></span>
            </div>
            <p class="text-muted small mt-2 mb-0">Not a trained model. It uses recent general and home/away condition stats as a sanity check against the ML result.</p>
            <div class="prediction-metric-grid mt-3">
                <div>
                    <div class="small text-muted">Context shots</div>
                    <div id="EnrichedShotsValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Context SOG</div>
                    <div id="EnrichedShotsOnGoalValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Context goals</div>
                    <div id="EnrichedGoalsValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Corners ML final</div>
                    <div id="BasePredictionValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Difference vs ML</div>
                    <div id="PredictionDifferenceValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Home ctx</div>
                    <div id="HomeContextBreakdownValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Away ctx</div>
                    <div id="AwayContextBreakdownValue" class="fw-semibold"></div>
                </div>
            </div>
            <div class="mt-3 d-flex flex-wrap gap-2">
                <a id="CreateBetFromContextShotsLink" class="btn btn-sm btn-outline-primary d-none" href="/Betting/Create">
                    Create shots bet
                </a>
            </div>
        </div>

        <div id="ShotsResult" class="prediction-result-card d-none">
            <div class="prediction-card-label">Shots model · separate market</div>
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                    <div class="text-muted small">Predicted total shots</div>
                    <div id="ShotsPredictionValue" class="prediction-main-value"></div>
                </div>
                <span class="badge text-bg-light border">Shots-only v3</span>
            </div>
            <p class="text-muted small mt-2 mb-0">Separate shots-only v3 CatBoost model. The final value uses the direct TotalShots model; HomeShots/AwayShots stay visible as diagnostics.</p>
            <div id="ShotsAdjustmentMessage" class="alert alert-warning mt-3 mb-0 d-none"></div>
            <div class="prediction-metric-grid mt-3">
                <div>
                    <div class="small text-muted">Line</div>
                    <div id="ShotsLineValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Recommendation</div>
                    <div id="ShotsRecommendationValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Confidence</div>
                    <span id="ShotsConfidenceBadge" class="badge"></span>
                </div>
                <div>
                    <div class="small text-muted">Historical accuracy</div>
                    <div id="ShotsAccuracyValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Distance</div>
                    <div id="ShotsDistanceValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Home + Away</div>
                    <div id="ShotsCombinedValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Home shots</div>
                    <div id="ShotsHomeValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Away shots</div>
                    <div id="ShotsAwayValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Direct total</div>
                    <div id="ShotsDirectValue" class="fw-semibold"></div>
                </div>
            </div>
            <div class="mt-3 d-flex flex-wrap gap-2">
                <a id="CreateBetFromShotsLink" class="btn btn-sm btn-outline-info d-none" href="/Betting/Create">
                    Create shots bet
                </a>
                <a id="CreateBetFromHomeShotsLink" class="btn btn-sm btn-outline-info d-none" href="/Betting/Create">
                    Home shots
                </a>
                <a id="CreateBetFromAwayShotsLink" class="btn btn-sm btn-outline-info d-none" href="/Betting/Create">
                    Away shots
                </a>
            </div>
        </div>

        <div id="ShotsOnGoalResult" class="prediction-result-card d-none">
            <div class="prediction-card-label">Shots-on-goal model · separate market</div>
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                    <div class="text-muted small">Predicted total shots on goal</div>
                    <div id="ShotsOnGoalPredictionValue" class="prediction-main-value"></div>
                </div>
                <span class="badge text-bg-info">Filtered SOG v1</span>
            </div>
            <p class="text-muted small mt-2 mb-0">Separate ensemble for total shots on goal. Final = 80% direct SOG + 20% HomeSOG/AwaySOG combined.</p>
            <div class="prediction-metric-grid mt-3">
                <div>
                    <div class="small text-muted">Line</div>
                    <div id="SogLineValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Recommendation</div>
                    <div id="SogRecommendationValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Confidence</div>
                    <span id="SogConfidenceBadge" class="badge"></span>
                </div>
                <div>
                    <div class="small text-muted">Historical accuracy</div>
                    <div id="SogAccuracyValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Distance</div>
                    <div id="SogDistanceValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Home + Away</div>
                    <div id="SogCombinedValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Home SOG</div>
                    <div id="SogHomeValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Away SOG</div>
                    <div id="SogAwayValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Direct total</div>
                    <div id="SogDirectValue" class="fw-semibold"></div>
                </div>
            </div>
            <div class="mt-3 d-flex flex-wrap gap-2">
                <a id="CreateBetFromShotsOnGoalLink" class="btn btn-sm btn-outline-info d-none" href="/Betting/Create">
                    Create SOG bet
                </a>
                <a id="CreateBetFromHomeSogLink" class="btn btn-sm btn-outline-info d-none" href="/Betting/Create">
                    Home SOG
                </a>
                <a id="CreateBetFromAwaySogLink" class="btn btn-sm btn-outline-info d-none" href="/Betting/Create">
                    Away SOG
                </a>
            </div>
        </div>

        <div id="GoalsResult" class="prediction-result-card d-none">
            <div class="prediction-card-label">Goals model · separate market</div>
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                    <div class="text-muted small">Predicted total goals</div>
                    <div id="GoalsPredictionValue" class="prediction-main-value"></div>
                </div>
                <span class="badge text-bg-warning">Goals v1</span>
            </div>
            <p class="text-muted small mt-2 mb-0">Separate goals model. Final = direct TotalGoals model because this version uses directWeight 1.0.</p>
            <div class="prediction-metric-grid mt-3">
                <div>
                    <div class="small text-muted">Line</div>
                    <div id="GoalsLineValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Recommendation</div>
                    <div id="GoalsRecommendationValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Confidence</div>
                    <span id="GoalsConfidenceBadge" class="badge"></span>
                </div>
                <div>
                    <div class="small text-muted">Historical accuracy</div>
                    <div id="GoalsAccuracyValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Distance</div>
                    <div id="GoalsDistanceValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Home + Away</div>
                    <div id="GoalsCombinedValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Home goals</div>
                    <div id="GoalsHomeValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Away goals</div>
                    <div id="GoalsAwayValue" class="fw-semibold"></div>
                </div>
                <div>
                    <div class="small text-muted">Direct total</div>
                    <div id="GoalsDirectValue" class="fw-semibold"></div>
                </div>
            </div>
            <div class="mt-3 d-flex flex-wrap gap-2">
                <a id="CreateBetFromGoalsLink" class="btn btn-sm btn-outline-warning d-none" href="/Betting/Create">
                    Create goals bet
                </a>
                <a id="CreateBetFromHomeGoalsLink" class="btn btn-sm btn-outline-warning d-none" href="/Betting/Create">
                    Home goals
                </a>
                <a id="CreateBetFromAwayGoalsLink" class="btn btn-sm btn-outline-warning d-none" href="/Betting/Create">
                    Away goals
                </a>
            </div>
        </div>

        <div id="ShotsOnGoalWarning" class="alert alert-warning d-none">
            Corners predicted, but shots/SOG/goals models could not be executed.
        </div>

        <div id="ModelComparison" class="surface-panel d-none">
            <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                <div>
                    <h2 class="h6 mb-1">Corners ensemble breakdown</h2>
                    <div class="text-muted small">New filtered models: direct total plus Home + Away combined</div>
                </div>
                <span id="ConsensusBadge" class="badge"></span>
            </div>
            <div class="prediction-metric-grid">
                <div>
