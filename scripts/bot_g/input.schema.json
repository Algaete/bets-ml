{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.corners/bot-g/candidate-universe-1.1.0.schema.json",
  "title": "Bot G2026 immutable candidate universe row",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "CandidateId", "QuoteId", "FixtureId", "FixtureDateUtc", "PredictionTimestampUtc",
    "FeatureAsOfUtc", "OddsTimestampUtc", "OutcomeAvailableUtc", "League", "HomeTeam",
    "AwayTeam", "Bookmaker", "MarketType", "Selection", "Line", "OverOdds", "UnderOdds",
    "SelectedOdds", "LegacyPrediction", "LegacyModelVersion", "LegacyModelTrainedThroughUtc",
    "Prediction2026", "Model2026Version", "Model2026TrainedThroughUtc", "ContextPrediction",
    "HistoricalMean", "HistoricalStd", "HistoryCount", "DataQualityScore", "ActualValue",
    "ConfigurationVersion", "FeatureSchemaVersion", "TrainingContractVersion",
    "FootballIntelligenceEnabled", "FootballIntelligenceVersion",
    "FootballIntelligenceProbabilityAdjustment",
    "FootballIntelligenceHomeEvidenceStatus", "FootballIntelligenceAwayEvidenceStatus"
  ],
  "properties": {
    "CandidateId": {"type": ["string", "integer"]},
    "QuoteId": {"type": ["string", "integer"]},
    "FixtureId": {"type": ["string", "integer"]},
    "FixtureDateUtc": {"type": "string", "format": "date-time"},
    "PredictionTimestampUtc": {"type": "string", "format": "date-time"},
    "FeatureAsOfUtc": {"type": "string", "format": "date-time"},
    "OddsTimestampUtc": {"type": "string", "format": "date-time"},
    "OutcomeAvailableUtc": {"type": "string", "format": "date-time"},
    "League": {"type": "string", "minLength": 1},
    "HomeTeam": {"type": "string", "minLength": 1},
    "AwayTeam": {"type": "string", "minLength": 1},
    "Bookmaker": {"type": "string", "minLength": 1},
    "MarketType": {"enum": ["TotalGoals", "HomeTeamGoals", "AwayTeamGoals"]},
    "Selection": {"enum": ["Over", "Under"]},
    "Line": {"type": "number", "minimum": 0, "multipleOf": 0.25},
    "OverOdds": {"type": "number", "exclusiveMinimum": 1},
    "UnderOdds": {"type": "number", "exclusiveMinimum": 1},
    "SelectedOdds": {"type": "number", "exclusiveMinimum": 1},
    "LegacyPrediction": {"type": "number", "minimum": 0},
    "LegacyModelVersion": {"type": "string", "minLength": 1},
    "LegacyModelTrainedThroughUtc": {"type": "string", "format": "date-time"},
    "Prediction2026": {"type": "number", "minimum": 0},
    "Model2026Version": {"type": "string", "minLength": 1},
    "Model2026TrainedThroughUtc": {"type": "string", "format": "date-time"},
    "ContextPrediction": {"type": "number", "minimum": 0},
    "HistoricalMean": {"type": "number", "minimum": 0},
    "HistoricalStd": {"type": "number", "minimum": 0},
    "HistoryCount": {"type": "integer", "minimum": 0},
    "DataQualityScore": {"type": "number", "minimum": 0, "maximum": 1},
    "ActualValue": {"type": "number", "minimum": 0},
    "ConfigurationVersion": {"const": "bot-g-goals-market-intelligence-1.1.0"},
    "FeatureSchemaVersion": {"const": "bot-g-goals-features-1.0.0"},
    "TrainingContractVersion": {"const": "bot-g-training-export-1.1.0"},
    "FootballIntelligenceEnabled": {"const": true},
    "FootballIntelligenceVersion": {"const": "football-intelligence-adjustment-1.0.0"},
    "FootballIntelligenceProbabilityAdjustment": {
      "type": "number", "minimum": -0.04, "maximum": 0.04
    },
    "FootballIntelligenceHomeEvidenceStatus": {
      "enum": ["Missing", "NoActionableFacts", "LowConfidence", "Stale", "FutureCutoff", "Available"]
    },
    "FootballIntelligenceAwayEvidenceStatus": {
      "enum": ["Missing", "NoActionableFacts", "LowConfidence", "Stale", "FutureCutoff", "Available"]
    },
    "FootballIntelligenceHomeCutoffUtc": {"type": ["string", "null"], "format": "date-time"},
    "FootballIntelligenceAwayCutoffUtc": {"type": ["string", "null"], "format": "date-time"},
    "FPublished": {"type": "boolean"},
    "FProbability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "FEdge": {"type": ["number", "null"]},
    "FExpectedValue": {"type": ["number", "null"]},
    "IsSynthetic": {"type": "boolean"}
  }
}
