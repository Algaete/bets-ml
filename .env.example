# Microsoft Entra ID / Azure AD
AZURE_AD_INSTANCE=https://login.microsoftonline.com/
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_CALLBACK_PATH=/signin-oidc

# Web -> API server-side calls
BACKEND_API_BASE_URL=http://localhost:5070

# Shared secret between Web and API. Store as an Azure Container Apps secret in production.
INTERNAL_API_KEY=
BACKEND_API_INTERNAL_KEY=

# SQL Server / Azure SQL. Prefer a Container Apps secret named AZURE_SQL_CONNECTION_STRING.
# Example managed identity style:
# Server=tcp:<server>.database.windows.net,1433;Initial Catalog=<db>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;Authentication=Active Directory Managed Identity;
AZURE_SQL_CONNECTION_STRING=

# Football providers
API_FOOTBALL_KEY=

# Optional pre-match intelligence experiment for Bot E/F.
# With Enabled=false or without usable evidence, its probability adjustment is exactly zero.
FOOTBALL_INTELLIGENCE_ENABLED=false
FOOTBALL_INTELLIGENCE_WORKER_ENABLED=false
FOOTBALL_INTELLIGENCE_WORKER_POLL_MINUTES=5
FOOTBALL_NEWS_SEARCH_PROVIDER=None
BRAVE_SEARCH_API_KEY=

# Optional structured semantic extractor. When disabled, the deterministic no-key
# extractor is used. When enabled, all three values below are required.
FOOTBALL_NEWS_OPENAI_ENABLED=false
OPENAI_API_KEY=
FOOTBALL_NEWS_OPENAI_MODEL=

# API runtime
SWAGGER_ENABLED=false
PYTHON_EXECUTABLE=python3
PYTHON_PREDICT_SCRIPT_PATH=../predict.py
PYTHON_SHOTS_SOG_SCRIPT_PATH=../predict_shots_on_goal.py
PYTHON_SHOTS_SOG_MODEL_PATH=../newModelsML
PYTHON_MODEL_DEBUG_SCRIPT_PATH=../predict_single_model.py
PYTHON_MODEL_DEBUG_MODEL_PATH=../newModelsML

# Bot G2026 starts in shadow through its SQL definition. Installing an artifact does not
# enable publication; PublishEnabled must still be changed explicitly in the bot definition.
BOT_G_ENABLED=true
BOT_G_ARTIFACT_PATH=../models/bot-g/active.json

# Robust Pick Evaluation is audit-only by default. Do not use Enforce until the
# walk-forward acceptance gates and minimum per-market samples have passed.
ROBUST_PICK_EVALUATION_ENABLED=true
ROBUST_PICK_EVALUATION_MODE=Shadow
ROBUST_PICK_EVALUATION_VERSION=robust-pick-evaluation-1.0.0
ROBUST_PICK_OUTCOME_AVAILABILITY_LAG_HOURS=8
ROBUST_PICK_DEFAULT_MAX_ODDS_AGE_SECONDS=1800

# Pinnacle guest API. The key is optional while the guest endpoint accepts anonymous reads.
PINNACLE_GUEST_API_BASE_URL=https://guest.api.arcadia.pinnacle.com/
PINNACLE_GUEST_API_KEY=
